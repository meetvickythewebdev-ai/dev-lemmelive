{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lemme-home.js' | asset_url }}" defer></script>

<section class="lm-section lm-banner" aria-labelledby="LmBannerHeading-{{ section.id }}">
  <div class="lm-container">
    <div class="lm-banner__card">
      <div class="lm-banner__bg lm-banner__bg--desktop">
        {%- render 'lemme-image', image: section.settings.image_desktop, fallback: 'lemme-real-science-desktop.webp', alt: '', fw: 2640, fh: 877 -%}
      </div>
      <div class="lm-banner__bg lm-banner__bg--mobile">
        {%- render 'lemme-image', image: section.settings.image_mobile, fallback: 'lemme-real-science-mobile.webp', alt: '', fw: 1097, fh: 1888 -%}
      </div>
      <div class="lm-banner__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="lm-banner__heading" id="LmBannerHeading-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="lm-banner__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          {%- render 'lemme-button', label: section.settings.button_label, url: section.settings.button_url, style: 'light', magnetic: true -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lemme image banner",
  "class": "lm-banner-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real science, real results" },
    { "type": "text", "id": "text", "label": "Text", "default": "Lemme introduce you to the upgrade you can feel." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all" },
    { "type": "url", "id": "button_url", "label": "Button link", "default": "/collections/all" },
    { "type": "header", "content": "Images", "info": "Leave empty to use the built-in Lemme images." },
    { "type": "image_picker", "id": "image_desktop", "label": "Image (desktop)", "info": "2640 × 880 px recommended" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)", "info": "1100 × 1890 px recommended" }
  ],
  "presets": [ { "name": "Lemme image banner" } ]
}
{% endschema %}
