{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-byob.css' | asset_url | stylesheet_tag }}

{%- comment -%} "build your custom bundle" banner at the top of the Build your bundle page. {%- endcomment -%}
{%- assign st = section.settings -%}
<section class="lm-section lbh" aria-labelledby="LbhTitle-{{ section.id }}">
  <div class="lm-container">
    <p class="lbh__title lbh__title--mobile" aria-hidden="true">{{ st.heading }}</p>
    <div class="lbh__card">
      <div class="lbh__media">
        {%- if st.image != blank -%}
          {%- if st.image_mobile != blank -%}
            <picture>
              <source media="(max-width: 749px)" srcset="{{ st.image_mobile | image_url: width: 900 }}">
              {{ st.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '', fetchpriority: 'high' }}
            </picture>
          {%- else -%}
            {{ st.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '', fetchpriority: 'high' }}
          {%- endif -%}
        {%- endif -%}
      </div>
      <div class="lbh__content">
        <h1 class="lbh__title" id="LbhTitle-{{ section.id }}">{{ st.heading }}</h1>
        {%- if section.blocks.size > 0 -%}
          <ul class="lbh__list" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}{{ block.settings.icon | image_url: width: 80 | image_tag: alt: '', loading: 'lazy', width: 35, height: 35 }}{%- endif -%}
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lemme bundle banner",
  "class": "lbh-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "build your custom bundle" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Background image (mobile)" }
  ],
  "blocks": [
    { "type": "point", "name": "Point", "settings": [
      { "type": "image_picker", "id": "icon", "label": "Icon" },
      { "type": "text", "id": "text", "label": "Text", "default": "Custom Bundles Ship Free" }
    ] }
  ],
  "presets": [ { "name": "Lemme bundle banner" } ]
}
{% endschema %}
