{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lemme-pdp.js' | asset_url }}" defer></script>

{%- liquid
  assign shown = 0
  assign source = section.settings.collection.products
  if source == blank and recommendations.performed? and recommendations.products_count > 0
    assign source = recommendations.products
  endif
-%}

<section class="lm-section lp-cards" id="featured-products-{{ section.id }}"{% if product %} data-lp-nav="{{ section.settings.nav_label | escape }}"{% endif %} aria-labelledby="LpCards-{{ section.id }}" data-lp-cards
  {% if section.settings.collection == blank and product %}data-lp-recs-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"{% endif %}>
  {%- if source != blank -%}
    <div class="lp-cards__inner">
      <div class="lp-cards__header">
        <h2 class="lp-h2" id="LpCards-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.shop_all_label != blank -%}<a class="lp-cards__shop-all" href="{{ section.settings.shop_all_url | default: routes.all_products_collection_url }}">{{ section.settings.shop_all_label }}</a>{%- endif -%}
      </div>
      <div class="lp-cards__carousel">
        <ul class="lp-cards__track" data-lp-cards-track>
          {%- for card_product in source -%}
            {%- if card_product.id != product.id and shown < section.settings.limit -%}
              {%- assign shown = shown | plus: 1 -%}
              <li class="lp-cards__slide">{%- render 'lemme-pdp-card', product: card_product, add_label: section.settings.add_label, sold_out_label: section.settings.sold_out_label -%}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <div class="lp-cards__nav lp-cards__nav--prev"><button class="lp-cards__arrow lp-cards__arrow--prev" type="button" aria-label="Previous products" data-lp-cards-prev hidden>{% render 'lemme-pdp-icon', icon: 'arrow-left-small' %}</button></div>
        <div class="lp-cards__nav lp-cards__nav--next"><button class="lp-cards__arrow lp-cards__arrow--next" type="button" aria-label="Next products" data-lp-cards-next>{% render 'lemme-pdp-icon', icon: 'arrow-right-small' %}</button></div>
        <div class="lp-dots" data-lp-dots aria-hidden="true"></div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Lemme product cards",
  "class": "lp-cards-section",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Link label", "default": "Products" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "most-loved formulas" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "On product pages, leave empty to use Shopify's related product recommendations." },
    { "type": "text", "id": "shop_all_label", "label": "Shop all link" },
    { "type": "url", "id": "shop_all_url", "label": "Shop all link URL" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "add_label", "label": "Add button", "default": "Add +" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" }
  ],
  "presets": [ { "name": "Lemme product cards" } ]
}
{% endschema %}
