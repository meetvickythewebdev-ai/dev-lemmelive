{{ 'lemme-swiper.min.css' | asset_url | stylesheet_tag }}
{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lemme-home.js' | asset_url }}" defer></script>
<script src="{{ 'lemme-pdp.js' | asset_url }}" defer></script>

{%- liquid
  assign source = 'none'
  if recommendations.performed? and recommendations.products_count > 0
    assign source = 'recs'
  elsif section.settings.collection != blank
    assign source = 'collection'
  endif
  assign shown = 0
-%}

<section class="lm-section lm-products lm-related" aria-labelledby="LmRelatedHeading-{{ section.id }}"
  data-lm-related
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
  {% if recommendations.performed? %}data-loaded{% endif %}>
  {%- if source != 'none' -%}
    <div class="lm-container">
      <h2 class="lm-products__heading" id="LmRelatedHeading-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>
    <div class="lm-products__viewport" data-lm-products data-swiper-src="{{ 'lemme-swiper.min.js' | asset_url }}">
      <div class="swiper">
        <div class="swiper-wrapper">
          {%- if source == 'recs' -%}
            {%- for rec in recommendations.products -%}
              <div class="swiper-slide">{%- render 'lemme-product-card', product: rec, button_label: section.settings.button_label -%}</div>
            {%- endfor -%}
          {%- else -%}
            {%- for rec in section.settings.collection.products -%}
              {%- if rec.id != product.id and shown < section.settings.limit -%}
                {%- assign shown = shown | plus: 1 -%}
                <div class="swiper-slide">{%- render 'lemme-product-card', product: rec, button_label: section.settings.button_label -%}</div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      <button class="lm-products__nav lm-products__nav--prev" type="button" aria-label="Previous product">{% render 'lemme-icon', icon: 'chevron-left' %}</button>
      <button class="lm-products__nav lm-products__nav--next" type="button" aria-label="Next product">{% render 'lemme-icon', icon: 'chevron-right' %}</button>
      <div class="lm-products__pagination"></div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Lemme related products",
  "class": "lm-related-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "you're gonna love these" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "collection", "id": "collection", "label": "Fallback collection", "info": "Used until Shopify has enough sales data to recommend related products." }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
