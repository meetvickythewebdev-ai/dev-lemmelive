{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lemme-pdp.js' | asset_url }}" defer></script>

{%- liquid
  assign m = product.metafields.lemme
  assign st = section.settings
  assign display_title = st.title | default: m.display_title.value | default: product.title
  assign subtitle = st.subtitle | default: m.subtitle.value
  assign description = st.description
  if description == blank and m.intro != blank
    assign description = m.intro.value | newline_to_br
  endif
  assign badge = st.badge | default: m.badge.value
  assign frontrow_id = st.frontrow_id | default: m.frontrow_id.value
  assign gallery_badge = st.gallery_badge | default: m.card_badge.value
  assign formats = st.format_products | default: m.format_products.value
  assign format_name = st.format_name | default: m.format_name.value | default: display_title
  assign flavor = st.flavor | default: m.flavor.value
  assign icon_items = st.icon_items | default: m.benefit_icon_items.value
  assign routine = st.routine_products | default: m.routine_products.value
  assign sticky_image = st.sticky_image | default: m.sticky_image.value | default: product.featured_media.preview_image

  if st.option_labels != blank
    assign option_labels = st.option_labels | newline_to_br | replace: '</li>', '%%' | replace: '</p>', '%%' | replace: '<br />', '%%' | replace: '<br>', '%%' | replace: '<br/>', '%%' | strip_html | split: '%%'
  else
    assign option_labels = m.option_labels.value
    if option_labels == blank and m.option_names != blank
      assign option_labels = m.option_names.value | newline_to_br | split: '<br />'
    endif
  endif
  if st.option_descriptions != blank
    assign option_copy = st.option_descriptions | newline_to_br | replace: '</li>', '%%' | replace: '</p>', '%%' | replace: '<br />', '%%' | replace: '<br>', '%%' | replace: '<br/>', '%%' | strip_html | split: '%%'
  else
    assign option_copy = m.option_descriptions.value
    if option_copy == blank and m.option_details != blank
      assign option_copy = m.option_details.value | newline_to_br | split: '<br />'
    endif
  endif

  assign selected_variant = product.selected_or_first_available_variant
  comment
    Plans in the "Build your bundle" group (Theme settings > Build your bundle) are only for bundles, so they are ignored here.
  endcomment
  assign byob_group = settings.lemme_byob_group_name | default: 'Subscribe & Save Bundle'
  assign has_plans = false
  for group in product.selling_plan_groups
    if group.name != byob_group
      assign has_plans = true
    endif
  endfor
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign form_id = 'LpForm-' | append: section.id
  assign drawer_id = 'LpDrawer-' | append: section.id
  assign highlights = st.highlights | newline_to_br | split: '<br />'
  assign awards_block = section.blocks | where: 'type', 'tab_awards' | first
-%}

<section class="lm-section lp-main" data-lp-main data-section-id="{{ section.id }}">
  <div class="lp-main__layout">

    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="lp-gallery" data-lp-gallery>
      <div class="lp-gallery__stage">
        <div class="lp-gallery__track" data-lp-track tabindex="0" aria-label="{{ 'Product images, use arrow keys to browse' | escape }}">
          {%- for media in product.media -%}
            {%- liquid
              if forloop.first
                assign img_loading = 'eager'
                assign img_priority = 'high'
              else
                assign img_loading = 'lazy'
                assign img_priority = 'auto'
              endif
              assign img_alt = media.alt | default: product.title
            -%}
            <div class="lp-gallery__slide" data-lp-slide>
              <div class="lp-gallery__zoom-wrap" data-lp-zoom-wrap>
                {{ media.preview_image | image_url: width: 2000 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600, 2000', sizes: '(min-width: 1024px) 50vw, 100vw', loading: img_loading, fetchpriority: img_priority, alt: img_alt, class: 'lp-gallery__img', draggable: 'false' }}
              </div>
            </div>
          {%- else -%}
            <div class="lp-gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'lp-gallery__img' }}</div>
          {%- endfor -%}
        </div>

        {%- if product.media.size > 1 -%}
          <button class="lp-gallery__arrow lp-gallery__arrow--prev" type="button" aria-label="Previous image" data-lp-prev disabled>{% render 'lemme-pdp-icon', icon: 'arrow-left' %}</button>
          <button class="lp-gallery__arrow lp-gallery__arrow--next" type="button" aria-label="Next image" data-lp-next>{% render 'lemme-pdp-icon', icon: 'arrow-right' %}</button>
        {%- endif -%}

        {%- if frontrow_id != blank -%}
          <div class="lp-gallery__frontrow">
            <script async src="https://app.thefrontrowhealth.com/api/widgets/script?presentation_type=sticker&amp;product_id={{ frontrow_id | url_encode }}"></script>
            <iframe data-state="max" class="iframe-frontrow-sticker lp-gallery__frontrow-frame" id="frontrow-sticker" title="FrontrowMD Clinicians' Choice Banner" frameborder="0" src="https://app.thefrontrowhealth.com/api/widgets?presentation_type=sticker&amp;product_id={{ frontrow_id | url_encode }}" width="92" height="153"></iframe>
          </div>
        {%- endif -%}

        {%- if gallery_badge != blank -%}
          <span class="lp-gallery__badge lp-text-badge">{% render 'lemme-pdp-icon', icon: 'badge-shape' %}<span>{{ gallery_badge }}</span></span>
        {%- endif -%}

        {%- if product.media.size > 0 -%}
          <button class="lp-gallery__zoom" type="button" aria-label="Zoom image" aria-pressed="false" data-lp-zoom>{% render 'lemme-pdp-icon', icon: 'zoom' %}</button>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="lp-gallery__thumbs" data-lp-thumbs>
          <div class="lp-gallery__thumbs-list" role="tablist" aria-label="Product images">
            {%- for media in product.media -%}
              <button class="lp-gallery__thumb{% if forloop.first %} is-active{% endif %}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}" data-lp-thumb="{{ forloop.index0 }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 64, height: 64 }}
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
    <div class="lp-buybox">
      <div class="lp-buybox__inner">
        <header class="lp-head">
          <div class="lp-head__title-row">
            <h1 class="lp-head__title">{{ display_title }}</h1>
            {%- if badge != blank -%}
              {%- if awards_block != blank -%}
                <button class="lp-head__badge lp-head__badge--button" type="button" aria-label="View awards" aria-controls="{{ drawer_id }}" data-lp-open="{{ awards_block.id }}" data-lp-title="{{ awards_block.settings.title | escape }}">
                  {{ badge | image_url: width: 240 | image_tag: alt: '', width: 96, height: 96, loading: 'eager' }}
                </button>
              {%- else -%}
                <span class="lp-head__badge">{{ badge | image_url: width: 240 | image_tag: alt: badge.alt, width: 96, height: 96, loading: 'eager' }}</span>
              {%- endif -%}
            {%- endif -%}
          </div>
          {%- if subtitle != blank -%}<p class="lp-head__subtitle">{{ subtitle }}</p>{%- endif -%}
          {%- if rating != blank -%}
            {%- assign rating_pct = rating.rating | times: 100.0 | divided_by: rating.scale_max -%}
            <a class="lp-rating" href="#reviews" aria-label="Rated {{ rating.rating | round: 1 }} out of {{ rating.scale_max | round }} stars{% if rating_count != blank %}, {{ rating_count }} reviews{% endif %}. Go to reviews">
              <span class="lp-rating__stars" style="--lp-rating: {{ rating_pct }}%;" aria-hidden="true"></span>
              {%- if rating_count != blank -%}
                {%- liquid
                  assign rc = rating_count | times: 1
                  if rc >= 1000
                    assign rc_k = rc | divided_by: 1000
                    assign rc_r = rc | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
                    assign rc_text = rc_k | append: ',' | append: rc_r
                  else
                    assign rc_text = rc
                  endif
                -%}
                <span class="lp-rating__count" aria-hidden="true">({{ rc_text }} {{ section.settings.reviews_label }})</span>
              {%- endif -%}
            </a>
          {%- endif -%}
          {%- if description != blank -%}
            <div class="lp-head__description">{{ description | newline_to_br }}</div>
          {%- elsif product.description != blank -%}
            <div class="lp-head__description">{{ product.description }}</div>
          {%- endif -%}
        </header>

        {%- comment -%} Tabs that open the details drawer {%- endcomment -%}
        {%- capture tab_buttons -%}
          {%- for block in section.blocks -%}
            {%- if block.type contains 'tab_' -%}
              {%- capture panel -%}{%- render 'lemme-pdp-panel', block: block, product: product, display_title: display_title -%}{%- endcapture -%}
              {%- if panel != blank -%}
                <button class="lp-tab" type="button" aria-expanded="false" aria-controls="{{ drawer_id }}" data-lp-open="{{ block.id }}" data-lp-title="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
                  <span>{{ block.settings.title }}</span>
                  <span class="lp-tab__icon">{% render 'lemme-pdp-icon', icon: 'plus', class: 'lp-tab__plus' %}{% render 'lemme-pdp-icon', icon: 'minus', class: 'lp-tab__minus' %}</span>
                </button>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if tab_buttons != blank -%}
          <div class="lp-tabs" data-lp-tabs>
            <button class="lp-tabs__arrow lp-tabs__arrow--prev" type="button" aria-label="Scroll tabs left" tabindex="-1" hidden data-lp-tabs-prev>{% render 'lemme-pdp-icon', icon: 'arrow-left-small' %}</button>
            <div class="lp-tabs__scroller" data-lp-tabs-scroller>
              <div class="lp-tabs__list">{{ tab_buttons }}</div>
            </div>
            <button class="lp-tabs__arrow lp-tabs__arrow--next" type="button" aria-label="Scroll tabs right" tabindex="-1" hidden data-lp-tabs-next>{% render 'lemme-pdp-icon', icon: 'arrow-right-small' %}</button>
          </div>
        {%- endif -%}

        {%- comment -%} Format (sibling products, e.g. gummies / capsules) {%- endcomment -%}
        {%- if formats.size > 0 -%}
          <fieldset class="lp-format">
            <legend class="lm-visually-hidden">{{ section.settings.format_label | remove: ':' }}</legend>
            <p class="lp-label-row"><span class="lp-label-row__label">{{ section.settings.format_label }}</span><span>{{ format_name }}</span></p>
            <div class="lp-format__list">
              {%- for fp in formats -%}
                {%- liquid
                  assign fp_name = fp.metafields.lemme.format_name.value | default: fp.metafields.lemme.display_title.value | default: fp.title
                  assign fp_swatch = fp.metafields.lemme.format_swatch.value | default: fp.featured_media.preview_image
                  assign is_current = false
                  if fp.id == product.id
                    assign is_current = true
                  endif
                -%}
                <a class="lp-format__item{% if is_current %} is-active{% endif %}{% unless fp.available %} is-unavailable{% endunless %}" href="{{ fp.url }}"{% if is_current %} aria-current="page"{% endif %}>
                  {%- if fp_swatch != blank -%}<span class="lp-format__swatch">{{ fp_swatch | image_url: width: 96 | image_tag: alt: '', loading: 'lazy', width: 32, height: 32 }}</span>{%- endif -%}
                  <span class="lp-format__name">{{ fp_name }}</span>
                </a>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}

        {%- if flavor != blank -%}
          <p class="lp-label-row"><span class="lp-label-row__label">{{ section.settings.flavor_label }}</span><span>{{ flavor }}</span></p>
        {%- endif -%}

        {%- comment -%} Purchase options {%- endcomment -%}
        <div class="lp-buy" data-lp-buy{% if section.settings.round_prices %} data-lp-round{% endif %}>
          <p class="lp-label-row"><span class="lp-label-row__label">{{ section.settings.options_label }}</span><span data-lp-option-name></span></p>
          <fieldset class="lp-options">
            <legend class="lm-visually-hidden">{{ section.settings.options_legend }}</legend>
            {%- for variant in product.variants -%}
              {%- liquid
                assign idx = forloop.index0
                assign plan_id = ''
                assign opt_price = variant.price
                assign opt_compare = variant.compare_at_price
                assign allocation = nil
                for alloc in variant.selling_plan_allocations
                  assign alloc_group = product.selling_plan_groups | where: 'id', alloc.selling_plan_group_id | first
                  if alloc_group.name != byob_group
                    assign allocation = alloc
                    break
                  endif
                endfor
                if has_plans and allocation
                  assign plan_id = allocation.selling_plan.id
                  assign opt_price = allocation.price
                  assign opt_compare = variant.price
                  if allocation.compare_at_price > opt_compare
                    assign opt_compare = allocation.compare_at_price
                  endif
                endif
                assign opt_label = option_labels[idx] | strip
                if opt_label == blank
                  if variant.title == 'Default Title'
                    assign opt_label = section.settings.single_label
                  else
                    assign opt_label = variant.title
                  endif
                endif
                assign opt_text = option_copy[idx] | strip
                assign saving = 0
                if opt_compare > opt_price
                  assign saving = opt_compare | minus: opt_price | times: 100.0 | divided_by: opt_compare | floor
                endif
                assign show_price = opt_price
                assign show_compare = opt_compare
                assign show_once = variant.price
                if section.settings.round_prices
                  assign show_price = opt_price | divided_by: 100.0 | round | times: 100
                  assign show_compare = opt_compare | divided_by: 100.0 | round | times: 100
                  assign show_once = variant.price | divided_by: 100.0 | round | times: 100
                endif
              -%}
              <div class="lp-option">
                <input class="lp-option__radio lm-visually-hidden" type="radio" name="lp-option-{{ section.id }}" id="LpOption-{{ section.id }}-{{ variant.id }}" value="{{ variant.id }}" data-name="{{ opt_label | escape }}" data-selling-plan="{{ plan_id }}" data-price="{{ show_price | money_without_trailing_zeros }}" data-price-cents="{{ opt_price }}" data-compare-cents="{{ opt_compare | default: opt_price }}" data-once-price="{{ show_once | money_without_trailing_zeros }}" data-once-cents="{{ variant.price }}" data-available="{{ variant.available }}"{% if variant.id == selected_variant.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                <label class="lp-option__label" for="LpOption-{{ section.id }}-{{ variant.id }}">
                  <span class="lp-option__main">
                    <span class="lp-option__mark" aria-hidden="true"></span>
                    <span class="lp-option__text">
                      <span class="lp-option__title">{{ opt_label }}</span>
                      {%- if opt_text != blank or variant.available == false -%}
                        <span class="lp-option__copy">{% if variant.available %}{{ opt_text }}{% else %}{{ section.settings.sold_out }}{% endif %}</span>
                      {%- endif -%}
                    </span>
                    <span class="lp-option__pricing">
                      <span class="lp-option__price">
                        {%- if opt_compare > opt_price -%}
                          <span class="lm-visually-hidden">Sale price</span><span>{{ show_price | money_without_trailing_zeros }}</span><span class="lm-visually-hidden">Regular price</span><s>{{ show_compare | money_without_trailing_zeros }}</s>
                        {%- else -%}
                          <span>{{ show_price | money_without_trailing_zeros }}</span>
                        {%- endif -%}
                      </span>
                      {%- if saving > 0 -%}<span class="lp-option__savings">{{ saving }}% off</span>{%- endif -%}
                    </span>
                  </span>
                  {%- if section.settings.highlights != blank -%}
                    <ul class="lp-option__highlights">
                      {%- for line in highlights -%}
                        {%- assign line = line | strip -%}
                        {%- if line != blank -%}<li>{% render 'lemme-pdp-icon', icon: 'sparkle' %}<span>{{ line }}</span></li>{%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </label>
              </div>
            {%- endfor -%}
          </fieldset>

          {%- form 'product', product, id: form_id, class: 'lp-form', novalidate: 'novalidate', data-lp-form: '' -%}
            <input type="hidden" name="id" value="{{ selected_variant.id }}" data-lp-variant>
            <input type="hidden" name="selling_plan" value="" data-lp-plan{% unless has_plans %} disabled{% endunless %}>
            <button class="lp-btn lp-btn--dark lp-form__submit" type="submit" name="add" data-lp-submit data-add="{{ section.settings.add_label | escape }}" data-sold-out="{{ section.settings.sold_out | escape }}" data-added="{{ section.settings.added_label | escape }}"{% unless selected_variant.available %} disabled{% endunless %}>
              <span data-lp-submit-label>{%- if selected_variant.available -%}{{ selected_variant.price | money_without_trailing_zeros }} — {{ section.settings.add_label }}{%- else -%}{{ section.settings.sold_out }}{%- endif -%}</span>
            </button>
            {%- if has_plans -%}
              <p class="lp-form__once"><button class="lp-form__once-btn" type="submit" name="add" data-lp-once>{{ section.settings.buy_once_label }} <span data-lp-once-price>{{ selected_variant.price | money_without_trailing_zeros }}</span></button></p>
            {%- endif -%}
            <p class="lp-form__status" role="status" aria-live="polite" data-lp-status></p>
          {%- endform -%}
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'gift' -%}
            <div class="lp-gift" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}<span class="lp-gift__label">{{ block.settings.label }}</span>{%- endif -%}
              <div class="lp-gift__body">
                {%- render 'lemme-image', image: block.settings.image, fallback: 'lemme-gift-maelys.webp', alt: block.settings.title, class: 'lp-gift__img', sizes: '84px', fw: 240, fh: 222 -%}
                <div class="lp-gift__text">
                  <p class="lp-gift__name">{{ block.settings.title }}</p>
                  {%- if block.settings.tag != blank -%}<span class="lp-gift__tag">{{ block.settings.tag }}</span>{%- endif -%}
                </div>
              </div>
              {%- if block.settings.note != blank -%}<p class="lp-gift__note">{{ block.settings.note }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if icon_items.size > 0 or m.benefit_icons != blank -%}
          <div class="lp-icons">
            <ul class="lp-icons__grid">
              {%- if icon_items.size > 0 -%}
                {%- for item in icon_items -%}
                  <li class="lp-icons__item">
                    {%- if item.icon.value != blank -%}{{ item.icon.value | image_url: width: 180 | image_tag: alt: '', loading: 'lazy', width: 60, height: 60 }}{%- endif -%}
                    <p class="lp-icons__label">{{ item.label.value }}</p>
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- assign icon_labels = m.benefit_icon_labels.value -%}
                {%- for icon in m.benefit_icons.value -%}
                  <li class="lp-icons__item">
                    {{ icon | image_url: width: 180 | image_tag: alt: '', loading: 'lazy', width: 60, height: 60 }}
                    <p class="lp-icons__label">{{ icon_labels[forloop.index0] | default: icon.alt }}</p>
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}

        {%- comment -%} "Lemme get the full routine" bundle {%- endcomment -%}
        {%- if routine.size > 0 -%}
          <section class="lp-upsell" aria-labelledby="LpUpsell-{{ section.id }}" data-lp-upsell>
            <h2 class="lp-upsell__heading" id="LpUpsell-{{ section.id }}">{{ section.settings.routine_heading }}</h2>
            <ul class="lp-upsell__images">
              <li class="lp-upsell__image-item"><a class="lp-upsell__image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{%- if product.featured_media -%}{{ product.featured_media.preview_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '', width: 140, height: 140 }}{%- endif -%}</a></li>
              {%- for rp in routine -%}
                <li class="lp-upsell__image-item"><a class="lp-upsell__image" href="{{ rp.url }}" aria-label="{{ rp.title | escape }}">{%- if rp.featured_media -%}{{ rp.featured_media.preview_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '', width: 140, height: 140 }}{%- endif -%}</a></li>
              {%- endfor -%}
            </ul>
            <div class="lp-upsell__pricing">
              <p class="lp-upsell__total">
                <strong class="lp-upsell__total-label">{{ section.settings.routine_total_label }}</strong>
                <span class="lp-upsell__total-prices"><span class="lp-upsell__total-now" data-lp-upsell-total></span><s class="lp-upsell__total-was" data-lp-upsell-was hidden></s></span>
              </p>
              <button class="lp-btn lp-btn--light lp-upsell__btn" type="button" data-lp-upsell-add>{{ section.settings.routine_button }}</button>
              <p class="lp-upsell__status" role="status" aria-live="polite" data-lp-upsell-status></p>
            </div>
            <div class="lp-upsell__current">
              <div class="lp-upsell__current-info">
                <span class="lp-upsell__current-title">{{ product.title }}</span>
                <span class="lp-upsell__current-option" data-lp-upsell-option></span>
              </div>
              <span class="lp-upsell__current-prices"><span class="lp-upsell__current-price" data-lp-upsell-price></span><s class="lp-upsell__current-was" data-lp-upsell-price-was hidden></s></span>
            </div>
            <fieldset class="lp-upsell__addons">
              <legend class="lp-upsell__addons-legend">{{ section.settings.routine_addons_label }}</legend>
              {%- for rp in routine -%}
                {%- assign rv = rp.selected_or_first_available_variant -%}
                <div class="lp-upsell__addon">
                  <input class="lp-upsell__checkbox" type="checkbox" id="LpAddon-{{ section.id }}-{{ rv.id }}" value="{{ rv.id }}" data-price="{{ rv.price }}" data-compare="{{ rv.compare_at_price | default: rv.price }}"{% if rv.available %} checked{% else %} disabled{% endif %}>
                  <label class="lp-upsell__addon-label" for="LpAddon-{{ section.id }}-{{ rv.id }}">
                    <span class="lp-upsell__box" aria-hidden="true">{% render 'lemme-pdp-icon', icon: 'tick' %}</span>
                    <span class="lp-upsell__addon-title">{{ rp.title }}</span>
                    <span class="lp-upsell__addon-price">{{ rv.price | money_without_trailing_zeros }}</span>
                  </label>
                </div>
              {%- endfor -%}
            </fieldset>
          </section>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ---------- Details drawer (one panel per tab) ---------- {%- endcomment -%}
  <div class="lp-drawer-overlay" data-lp-overlay data-lp-portal="overlay-{{ section.id }}" hidden></div>
  <aside class="lm-section lp-drawer" id="{{ drawer_id }}" role="dialog" aria-modal="true" aria-labelledby="{{ drawer_id }}-title" data-lp-drawer hidden>
    <div class="lp-drawer__inner">
      <header class="lp-drawer__header">
        <h2 class="lp-drawer__title" id="{{ drawer_id }}-title" data-lp-drawer-title></h2>
        <button class="lp-drawer__close" type="button" aria-label="Close" data-lp-close>{% render 'lemme-pdp-icon', icon: 'close' %}</button>
      </header>
      <div class="lp-drawer__body" data-lp-drawer-body>
        {%- for block in section.blocks -%}
          {%- if block.type contains 'tab_' -%}
            {%- capture panel -%}{%- render 'lemme-pdp-panel', block: block, product: product, display_title: display_title -%}{%- endcapture -%}
            {%- if panel != blank -%}<div class="lp-panel{% if block.type == 'tab_supplement' %} lp-facts{% elsif block.type == 'tab_details' %} lp-panel--rte{% endif %}" data-lp-panel="{{ block.id }}" hidden>{{ panel }}</div>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <nav class="lp-drawer__nav" aria-label="Details">
        <button class="lp-drawer__nav-btn" type="button" data-lp-drawer-prev hidden>{% render 'lemme-pdp-icon', icon: 'arrow-left-small' %}<span data-lp-label></span></button>
        <button class="lp-drawer__nav-btn lp-drawer__nav-btn--next" type="button" data-lp-drawer-next hidden><span data-lp-label></span>{% render 'lemme-pdp-icon', icon: 'arrow-right-small' %}</button>
      </nav>
    </div>
  </aside>

  {%- comment -%} ---------- Sticky add to bag ---------- {%- endcomment -%}
  <div class="lm-section lp-satc" data-lp-sticky data-lp-portal="satc-{{ section.id }}">
    <div class="lp-satc__media">
      {%- if sticky_image != blank -%}{{ sticky_image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy', width: 88, height: 88 }}{%- endif -%}
    </div>
    <div class="lp-satc__action">
      <button class="lp-satc__btn" type="button" data-lp-sticky-btn><span data-lp-sticky-label>{{ section.settings.add_label }}</span><span class="lm-visually-hidden">: {{ product.title }}</span></button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lemme product",
