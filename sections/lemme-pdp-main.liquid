{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lemme-home.js' | asset_url }}" defer></script>
<script src="{{ 'lemme-pdp.js' | asset_url }}" defer></script>

{%- liquid
  assign m = product.metafields.lemme
  assign bg_color = m.background_color.value | default: section.settings.fallback_color
  assign selected_variant = product.selected_or_first_available_variant
  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif
  assign option_labels = m.option_labels.value
  assign option_copy = m.option_descriptions.value
  assign benefits = m.benefits.value
  assign benefit_icons = m.benefit_icons.value
  assign benefit_icon_labels = m.benefit_icon_labels.value
  assign faqs = m.faqs.value
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count
  assign form_id = 'LmProductForm-' | append: section.id
  assign drawer_id = 'LmSupplement-' | append: section.id
-%}

<style>
  :root { --lm-pdp-color: {{ bg_color }}; }
</style>

<span class="lm-pdp-bg" data-lm-pdp-bg aria-hidden="true"></span>

<section class="lm-section lm-pdp" data-lm-pdp data-section-id="{{ section.id }}" data-swiper-src="{{ 'lemme-swiper.min.js' | asset_url }}" data-swiper-css="{{ 'lemme-swiper.min.css' | asset_url }}" data-money-format="{{ shop.money_format | strip_html | escape }}">
  <div class="lm-container">
    <div class="lm-pdp__grid">

      {%- comment -%} Gallery {%- endcomment -%}
      <div class="lm-pdp__gallery-col">
        <div class="lm-pdp-gallery" data-lm-gallery>
          {%- if product.media.size > 1 -%}
            <div class="lm-pdp-gallery__thumbs" role="tablist" aria-label="Product images">
              {%- for media in product.media -%}
                <button class="lm-pdp-gallery__thumb{% if forloop.first %} is-active{% endif %}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}" data-lm-thumb="{{ forloop.index0 }}">
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', width: 88, height: 88 }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="lm-pdp-gallery__main">
            <div class="swiper" data-lm-gallery-swiper>
              <div class="swiper-wrapper">
                {%- for media in product.media -%}
                  <div class="swiper-slide">
                    {%- liquid
                      if forloop.first
                        assign img_loading = 'eager'
                      else
                        assign img_loading = 'lazy'
                      endif
                      assign img_alt = media.alt | default: product.title
                      assign zoom_src = media.preview_image | image_url: width: 2000
                    -%}
                    {{ media.preview_image | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 1200px) 610px, (min-width: 750px) 50vw, 100vw', loading: img_loading, alt: img_alt, class: 'lm-pdp-gallery__img', data-lm-zoom-src: zoom_src }}
                  </div>
                {%- else -%}
                  <div class="swiper-slide">{{ 'product-1' | placeholder_svg_tag: 'lm-pdp-gallery__img lm-pdp-gallery__img--placeholder' }}</div>
                {%- endfor -%}
              </div>
            </div>
            {%- if product.media.size > 0 -%}
              <button class="lm-pdp-gallery__zoom" type="button" aria-label="Zoom image" data-lm-zoom-open>{% render 'lemme-pdp-icon', icon: 'zoom' %}</button>
            {%- endif -%}
            {%- if product.media.size > 1 -%}
              <div class="lm-pdp-gallery__controls">
                <button class="lm-pdp-gallery__arrow" type="button" aria-label="Previous image" data-lm-gallery-prev>{% render 'lemme-pdp-icon', icon: 'arrow-left' %}</button>
                <div class="lm-pdp-gallery__dots" data-lm-gallery-dots></div>
                <button class="lm-pdp-gallery__arrow" type="button" aria-label="Next image" data-lm-gallery-next>{% render 'lemme-pdp-icon', icon: 'arrow-right' %}</button>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%} Product info card {%- endcomment -%}
      <div class="lm-pdp__info-col">
        <div class="lm-pdp-card">
          {%- if rating != blank -%}
            <div class="lm-pdp-card__reviews">
              <a class="lm-pdp-card__rating" href="#LmReviews" aria-label="Rated {{ rating.rating | round: 1 }} out of {{ rating.scale_max | round }} stars{% if rating_count != blank %} based on {{ rating_count }} reviews{% endif %}">
                <span class="lm-pdp-card__stars" style="--lm-rating: {{ rating.rating | times: 100.0 | divided_by: rating.scale_max }}%;" aria-hidden="true">
                  <span class="lm-pdp-card__stars-base">{%- for i in (1..5) -%}{% render 'lemme-pdp-icon', icon: 'star-rating' %}{%- endfor -%}</span>
                  <span class="lm-pdp-card__stars-fill">{%- for i in (1..5) -%}{% render 'lemme-pdp-icon', icon: 'star-rating' %}{%- endfor -%}</span>
                </span>
                <span class="lm-pdp-card__rating-text" aria-hidden="true">({{ rating.rating | round: 1 }} out of {{ rating.scale_max | round }})</span>
              </a>
            </div>
          {%- endif -%}

          <div class="lm-pdp-card__heading">
            <h1 class="lm-pdp-card__title">{{ m.display_title.value | default: product.title }}</h1>
            {%- if m.badge.value != blank -%}
              {{ m.badge.value | image_url: width: 240 | image_tag: class: 'lm-pdp-card__badge', alt: m.badge.value.alt, width: 96, height: 96, loading: 'eager' }}
            {%- endif -%}
          </div>
          {%- if m.subtitle != blank -%}
            <p class="lm-pdp-card__subtitle">{{ m.subtitle.value }}</p>
          {%- endif -%}

          {%- comment -%} Tabs {%- endcomment -%}
          <div class="lm-pdp-tabs" data-lm-tabs>
            <div class="lm-pdp-tabs__nav" role="tablist" aria-label="Product details">
              <button class="lm-pdp-tabs__tab is-active" id="LmTab-details-{{ section.id }}" type="button" role="tab" aria-selected="true" aria-controls="LmPanel-details-{{ section.id }}" data-lm-tab="details">{{ section.settings.tab_details }}</button>
              {%- if m.supplement_facts != blank -%}
                <button class="lm-pdp-tabs__tab" type="button" aria-haspopup="dialog" aria-controls="{{ drawer_id }}" data-lm-drawer-open="{{ drawer_id }}">{{ section.settings.tab_supplement }}</button>
              {%- endif -%}
              {%- if faqs.size > 0 -%}
                <button class="lm-pdp-tabs__tab" id="LmTab-faqs-{{ section.id }}" type="button" role="tab" aria-selected="false" aria-controls="LmPanel-faqs-{{ section.id }}" data-lm-tab="faqs">{{ section.settings.tab_faqs }}</button>
              {%- endif -%}
            </div>

            <div class="lm-pdp-tabs__panel" id="LmPanel-details-{{ section.id }}" role="tabpanel" aria-labelledby="LmTab-details-{{ section.id }}" data-lm-panel="details">
              {%- if m.intro != blank -%}
                <div class="lm-pdp-tabs__intro">{{ m.intro.value | newline_to_br }}</div>
              {%- elsif product.description != blank -%}
                <div class="lm-pdp-tabs__intro">{{ product.description | strip_html | truncatewords: 45 }}</div>
              {%- endif -%}
              {%- if benefits.size > 0 -%}
                <ul class="lm-pdp-tabs__benefits" id="LmBenefits-{{ section.id }}" hidden>
                  {%- for benefit in benefits -%}
                    <li>{% render 'lemme-pdp-icon', icon: 'sparkle' %}<span>{{ benefit }}</span></li>
                  {%- endfor -%}
                </ul>
                <button class="lm-pdp-tabs__toggle" type="button" aria-expanded="false" aria-controls="LmBenefits-{{ section.id }}" data-lm-benefits-toggle data-label-open="{{ section.settings.see_benefits | escape }}" data-label-close="{{ section.settings.hide_benefits | escape }}">{{ section.settings.see_benefits }}</button>
              {%- endif -%}
            </div>

            {%- if faqs.size > 0 -%}
              <div class="lm-pdp-tabs__panel" id="LmPanel-faqs-{{ section.id }}" role="tabpanel" aria-labelledby="LmTab-faqs-{{ section.id }}" data-lm-panel="faqs" hidden>
                <div class="lm-pdp-faqs" data-lm-faq-track>
                  <ul class="lm-pdp-faqs__track">
                    {%- for faq in faqs -%}
                      <li class="lm-pdp-faqs__slide">
                        {%- unless forloop.first -%}<span class="lm-pdp-faqs__sep" aria-hidden="true">{% render 'lemme-pdp-icon', icon: 'sparkle' %}</span>{%- endunless -%}
                        <button class="lm-pdp-faqs__pill" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="LmFaqPop-{{ section.id }}" data-lm-faq-pill="{{ forloop.index0 }}">{{ faq.question.value }}</button>
                        <template data-lm-faq-answer="{{ forloop.index0 }}">{{ faq.answer.value | newline_to_br }}</template>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
              <dialog class="lm-pdp-faqpop" id="LmFaqPop-{{ section.id }}" aria-labelledby="LmFaqPopQ-{{ section.id }}" data-lm-faqpop>
                <button class="lm-pdp-faqpop__close" type="button" aria-label="Close" data-lm-faqpop-close>{% render 'lemme-pdp-icon', icon: 'close' %}</button>
                <div class="lm-pdp-faqpop__content">
                  <h3 class="lm-pdp-faqpop__q" id="LmFaqPopQ-{{ section.id }}" data-lm-faqpop-q></h3>
                  <div class="lm-pdp-faqpop__a" data-lm-faqpop-a></div>
                </div>
              </dialog>
            {%- endif -%}
          </div>

          {%- comment -%} Purchase options {%- endcomment -%}
          <div class="lm-pdp-buy" data-lm-buy id="LmBuy-{{ section.id }}">
            <fieldset class="lm-pdp-options">
              <legend class="lm-visually-hidden">{{ section.settings.options_legend }}</legend>
              {%- for variant in product.variants -%}
                {%- liquid
                  assign idx = forloop.index0
                  assign plan_id = ''
                  assign opt_price = variant.price
                  assign opt_compare = variant.compare_at_price
                  if has_plans and variant.selling_plan_allocations.size > 0
                    assign allocation = variant.selling_plan_allocations.first
                    assign plan_id = allocation.selling_plan.id
                    assign opt_price = allocation.price
                    assign opt_compare = variant.price
                    if allocation.compare_at_price > opt_compare
                      assign opt_compare = allocation.compare_at_price
                    endif
                  endif
                  assign opt_label = option_labels[idx]
                  if opt_label == blank
                    if variant.title == 'Default Title'
                      assign opt_label = section.settings.single_label
                    else
                      assign opt_label = variant.title
                    endif
                  endif
                  assign opt_copy = option_copy[idx]
                  assign saving = 0
                  if opt_compare > opt_price
                    assign saving = opt_compare | minus: opt_price | times: 100.0 | divided_by: opt_compare | round
                  endif
                  assign is_checked = false
                  if variant.id == selected_variant.id
                    assign is_checked = true
                  endif
                -%}
                <div class="lm-pdp-option">
                  <input class="lm-visually-hidden" type="radio" name="lm-option-{{ section.id }}" id="LmOption-{{ section.id }}-{{ variant.id }}" value="{{ variant.id }}" data-selling-plan="{{ plan_id }}" data-price="{{ opt_price | money_without_trailing_zeros }}" data-once-price="{{ variant.price | money_without_trailing_zeros }}" data-available="{{ variant.available }}"{% if is_checked %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                  <label for="LmOption-{{ section.id }}-{{ variant.id }}">
                    <span class="lm-pdp-option__row">
                      <span class="lm-pdp-option__radio" aria-hidden="true"></span>
                      <span class="lm-pdp-option__label">{{ opt_label }}</span>
                      <span class="lm-pdp-option__prices{% if opt_compare > opt_price %} is-sale{% endif %}">
                        {%- if opt_compare > opt_price -%}
                          <span class="lm-visually-hidden">Sale price</span>
                          <span>{{ opt_price | money_without_trailing_zeros }}</span>
                          <span class="lm-visually-hidden">Regular price</span>
                          <s>{{ opt_compare | money_without_trailing_zeros }}</s>
                        {%- else -%}
                          <span>{{ opt_price | money_without_trailing_zeros }}</span>
                        {%- endif -%}
                      </span>
                    </span>
                    {%- if opt_copy != blank or saving > 0 or variant.available == false -%}
                      <span class="lm-pdp-option__details">
                        <span class="lm-pdp-option__copy">{% if variant.available %}{{ opt_copy }}{% else %}{{ section.settings.sold_out }}{% endif %}</span>
                        {%- if saving > 0 -%}<span class="lm-pdp-option__badge">{{ saving }}% off</span>{%- endif -%}
                      </span>
                    {%- endif -%}
                  </label>
                </div>
              {%- endfor -%}
            </fieldset>

            {%- form 'product', product, id: form_id, class: 'lm-pdp-form', novalidate: 'novalidate', data-lm-product-form: '' -%}
              <input type="hidden" name="id" value="{{ selected_variant.id }}" data-lm-variant-input>
              <input type="hidden" name="selling_plan" value="" data-lm-plan-input{% unless has_plans %} disabled{% endunless %}>
              <button class="lm-btn lm-btn--lime lm-btn--md lm-btn--full lm-pdp-form__submit" type="submit" name="add" data-lm-button data-lm-submit{% unless selected_variant.available %} disabled{% endunless %}>
                <span class="lm-btn__filler" aria-hidden="true"></span>
                <span class="lm-btn__text"><span class="lm-btn__text-inner" data-lm-submit-label data-add="{{ section.settings.add_label | escape }}" data-sold-out="{{ section.settings.sold_out | escape }}" data-added="{{ section.settings.added_label | escape }}">
                  {%- if selected_variant.available -%}<span data-lm-submit-price></span>{{ section.settings.add_label }}{%- else -%}{{ section.settings.sold_out }}{%- endif -%}
                </span></span>
              </button>
              {%- if has_plans -%}
                <p class="lm-pdp-form__once">
                  <button class="lm-pdp-form__once-btn" type="submit" name="add" data-lm-buy-once>{{ section.settings.buy_once_label }} <span data-lm-once-price>{{ selected_variant.price | money_without_trailing_zeros }}</span></button>
                </p>
              {%- endif -%}
              <p class="lm-pdp-form__status" role="status" aria-live="polite" data-lm-form-status></p>
            {%- endform -%}

            {%- if has_plans and section.settings.sub_benefits_heading != blank -%}
              <div class="lm-pdp-subben">
                <p class="lm-pdp-subben__title">{{ section.settings.sub_benefits_heading }}</p>
                <ul class="lm-pdp-subben__list">
                  {%- for i in (1..5) -%}
                    {%- liquid
                      assign key = 'sub_benefit_' | append: i
                      assign txt = section.settings[key]
                      case i
                        when 1
                          assign ic = 'sub-vip'
                        when 2
                          assign ic = 'sub-delivery'
                        when 3
                          assign ic = 'sub-gift'
                        when 4
                          assign ic = 'sub-points'
                        else
                          assign ic = 'sub-cancel'
                      endcase
                    -%}
                    {%- if txt != blank -%}<li>{% render 'lemme-pdp-icon', icon: ic %}<span>{{ txt }}</span></li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>

          {%- comment -%} Blocks: gift box etc. {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'gift' -%}
                <div class="lm-pdp-gift" {{ block.shopify_attributes }}>
                  {%- if block.settings.label != blank -%}<span class="lm-pdp-gift__label">{{ block.settings.label }}</span>{%- endif -%}
                  <div class="lm-pdp-gift__body">
                    {%- render 'lemme-image', image: block.settings.image, fallback: 'lemme-gift-maelys.webp', alt: block.settings.title, class: 'lm-pdp-gift__img', sizes: '96px', fw: 240, fh: 222 -%}
                    <div class="lm-pdp-gift__text">
                      <p class="lm-pdp-gift__name">{{ block.settings.title }}</p>
                      {%- if block.settings.tag != blank -%}<span class="lm-pdp-gift__tag">{{ block.settings.tag }}</span>{%- endif -%}
                    </div>
                  </div>
                  {%- if block.settings.note != blank -%}<p class="lm-pdp-gift__note">{{ block.settings.note }}</p>{%- endif -%}
                </div>
              {%- when 'text' -%}
                <div class="lm-pdp-card__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endcase -%}
          {%- endfor -%}

          {%- if benefit_icons.size > 0 -%}
            <ul class="lm-pdp-icons">
              {%- for icon in benefit_icons -%}
                {%- assign icon_label = benefit_icon_labels[forloop.index0] | default: icon.alt -%}
                <li>
                  {{ icon | image_url: width: 192 | image_tag: alt: '', loading: 'lazy', width: 68, height: 68 }}
                  <span>{{ icon_label }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if m.flavor != blank -%}
            <p class="lm-pdp-card__flavor">{{ m.flavor.value }}</p>
          {%- endif -%}

          <div class="lm-pdp-card__links">
            {%- if section.settings.benefits_link_label != blank -%}
              <a class="lm-pdp-card__link" href="#LmIngredients">{{ section.settings.benefits_link_label }}</a>
            {%- endif -%}
            {%- if m.supplement_facts != blank -%}
              <button class="lm-pdp-card__link" type="button" aria-haspopup="dialog" aria-controls="{{ drawer_id }}" data-lm-drawer-open="{{ drawer_id }}">{{ section.settings.tab_supplement | capitalize }}</button>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Sticky add-to-bag bar (always visible, like lemmelive.com) {%- endcomment -%}
  <div class="lm-pdp-satc" data-lm-sticky>
    <div class="lm-pdp-satc__media">
      {%- if product.featured_media != blank -%}
        {{ product.featured_media.preview_image | image_url: width: 160 | image_tag: class: 'lm-pdp-satc__img', alt: '', loading: 'lazy', width: 66, height: 66 }}
      {%- endif -%}
    </div>
    <div class="lm-pdp-satc__action">
      <button class="lm-pdp-satc__btn" type="button" data-lm-sticky-btn data-lm-sticky-btn-inner><span data-lm-sticky-label>{{ section.settings.sticky_label }}</span><span class="lm-visually-hidden">: {{ product.title }}</span></button>
    </div>
  </div>

  {%- comment -%} Supplement facts drawer {%- endcomment -%}
  {%- if m.supplement_facts != blank -%}
    <dialog class="lm-pdp-drawer" id="{{ drawer_id }}" aria-labelledby="{{ drawer_id }}-title" data-lm-drawer>
      <div class="lm-pdp-drawer__inner">
        <button class="lm-pdp-drawer__close" type="button" aria-label="Close" data-lm-drawer-close>{% render 'lemme-pdp-icon', icon: 'close' %}</button>
        <h2 class="lm-pdp-drawer__title" id="{{ drawer_id }}-title">{{ section.settings.tab_supplement }}</h2>
        {%- if m.suggested_use != blank -%}<p class="lm-pdp-facts__use">{{ m.suggested_use.value }}</p>{%- endif -%}
        <div class="lm-pdp-facts">
          <div class="lm-pdp-facts__serving">
            <p class="lm-pdp-facts__heading">{{ section.settings.tab_supplement }}</p>
            {%- for line in m.serving_info.value -%}<p>{{ line }}</p>{%- endfor -%}
          </div>
          <table class="lm-pdp-facts__table">
            <thead><tr><th scope="col">{{ section.settings.facts_amount_label }}</th><th scope="col">{{ section.settings.facts_dv_label }}</th></tr></thead>
            <tbody>
              {%- assign rows = m.supplement_facts.value | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}
                {%- assign row_clean = row | strip -%}
                {%- if row_clean != blank -%}
                  {%- assign cols = row_clean | split: '|' -%}
                  <tr>
                    <td>{{ cols[0] | strip }}{%- if cols[2] != blank -%}<br><span>{{ cols[2] | strip }}</span>{%- endif -%}</td>
                    <td>{{ cols[1] | strip }}</td>
                  </tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
          {%- if m.supplement_footnote != blank -%}<p class="lm-pdp-facts__note">{{ m.supplement_footnote.value | newline_to_br }}</p>{%- endif -%}
        </div>
        {%- if m.other_ingredients != blank -%}<p class="lm-pdp-facts__extra"><strong>{{ section.settings.other_ingredients_label }}</strong> {{ m.other_ingredients.value }}</p>{%- endif -%}
        {%- if m.warning != blank -%}<p class="lm-pdp-facts__extra"><strong>{{ section.settings.warning_label }}</strong> {{ m.warning.value }}</p>{%- endif -%}
      </div>
    </dialog>
  {%- endif -%}

  {%- comment -%} Zoom {%- endcomment -%}
  <dialog class="lm-pdp-zoom" aria-label="Zoomed product image" data-lm-zoom>
    <button class="lm-pdp-drawer__close" type="button" aria-label="Close" data-lm-zoom-close>{% render 'lemme-pdp-icon', icon: 'close' %}</button>
    <div class="lm-pdp-zoom__holder" data-lm-zoom-holder></div>
  </dialog>

  <script type="application/json" data-lm-product-json>{{ product | json }}</script>
</section>

{% schema %}
{
  "name": "Lemme product",
  "class": "lm-pdp-section",
  "settings": [
    { "type": "paragraph", "content": "Most of this section is filled from the product's \"lemme\" metafields (colour, subtitle, badge, benefits, icons, flavour, supplement facts, FAQs). See the setup guide." },
    { "type": "color", "id": "fallback_color", "label": "Background colour when the product has none", "default": "#dfc8e7" },
    { "type": "header", "content": "Tabs" },
    { "type": "text", "id": "tab_details", "label": "Details tab", "default": "Details" },
    { "type": "text", "id": "tab_supplement", "label": "Supplement facts tab", "default": "Supplement facts" },
    { "type": "text", "id": "tab_faqs", "label": "FAQs tab", "default": "FAQs" },
    { "type": "text", "id": "see_benefits", "label": "Show benefits label", "default": "See benefits +" },
    { "type": "text", "id": "hide_benefits", "label": "Hide benefits label", "default": "Hide benefits −" },
    { "type": "header", "content": "Buying" },
    { "type": "text", "id": "options_legend", "label": "Options label (screen readers)", "default": "Choose an option" },
    { "type": "text", "id": "single_label", "label": "Option label for products without variants", "default": "One-time purchase" },
    { "type": "text", "id": "add_label", "label": "Add to bag label", "default": "Add to bag" },
    { "type": "text", "id": "added_label", "label": "Added message", "default": "Added to your bag!" },
    { "type": "text", "id": "sold_out", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "buy_once_label", "label": "Buy once link (subscription products)", "default": "Buy once for" },
    { "type": "text", "id": "sticky_label", "label": "Mobile sticky button", "default": "Add to bag" },
    { "type": "header", "content": "Subscription benefits", "info": "Shown only when the product has subscription (selling plan) options." },
    { "type": "text", "id": "sub_benefits_heading", "label": "Heading", "default": "Subscription benefits:" },
    { "type": "text", "id": "sub_benefit_1", "label": "Benefit 1", "default": "VIP access to exclusive drops" },
    { "type": "text", "id": "sub_benefit_2", "label": "Benefit 2", "default": "Guaranteed delivery during sell-outs" },
