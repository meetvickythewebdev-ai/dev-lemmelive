    { "type": "text", "id": "title", "label": "Title", "info": "Connected to lemme.display_title. Empty = product title." },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "richtext", "id": "description", "label": "Short description" },
    { "type": "image_picker", "id": "badge", "label": "Award badge (top right of the title)" },
