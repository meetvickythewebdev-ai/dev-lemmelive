    { "type": "text", "id": "gallery_badge", "label": "Gallery badge text", "info": "For example \"Best Seller\"." },
    { "type": "product_list", "id": "format_products", "label": "Format options", "info": "Products to switch between, for example Gummies and Capsules. Include this product.", "limit": 6 },
    { "type": "text", "id": "format_name", "label": "Format name of this product" },
    { "type": "text", "id": "flavor", "label": "Flavor" },
    { "type": "richtext", "id": "option_labels", "label": "Option names", "info": "One per line or bullet, in variant order. Empty = variant names." },
    { "type": "richtext", "id": "option_descriptions", "label": "Option descriptions", "info": "One per line or bullet, in variant order." },
    { "type": "metaobject_list", "id": "icon_items", "metaobject_type": "lemme_icon_item", "label": "Benefit icons", "limit": 8 },
    { "type": "product_list", "id": "routine_products", "label": "Bundle add-on products", "limit": 4 },
    { "type": "image_picker", "id": "sticky_image", "label": "Sticky bar image", "info": "Empty = main product image." },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "reviews_label", "label": "Reviews count label", "default": "Reviews" },
    { "type": "text", "id": "format_label", "label": "Format label", "default": "Format:" },
    { "type": "text", "id": "flavor_label", "label": "Flavor label", "default": "Flavor:" },
    { "type": "text", "id": "options_label", "label": "Options label", "default": "Frequency:" },
    { "type": "text", "id": "options_legend", "label": "Options label (screen readers)", "default": "Choose an option" },
    { "type": "text", "id": "single_label", "label": "Option label for products without variants", "default": "One-time purchase" },
    { "type": "textarea", "id": "highlights", "label": "Perks under the selected option", "info": "One per line.", "default": "VIP access to exclusive drops\nEarn loyalty points for free products & discounts\nGuaranteed delivery during sell-outs\nPause, update frequency or cancel anytime by logging into your account" },
    { "type": "text", "id": "add_label", "label": "Add to bag label", "default": "Add to Bag" },
    { "type": "text", "id": "added_label", "label": "Added message", "default": "Added to your bag!" },
    { "type": "text", "id": "sold_out", "label": "Sold out label", "default": "Sold out" },
    { "type": "checkbox", "id": "round_prices", "label": "Show prices rounded to whole dollars", "info": "Matches the live site ($25.50 shows as $26). The cart and checkout still charge the exact price.", "default": true },
    { "type": "text", "id": "buy_once_label", "label": "Buy once link (subscription products)", "default": "Buy once for" },
    { "type": "header", "content": "Bundle" },
    { "type": "text", "id": "routine_heading", "label": "Heading", "default": "Lemme Get the Full Routine:" },
    { "type": "text", "id": "routine_total_label", "label": "Total label", "default": "Total Price:" },
    { "type": "text", "id": "routine_button", "label": "Button", "default": "Add bundle to cart" },
    { "type": "text", "id": "routine_addons_label", "label": "Add-ons label", "default": "One-time Add-ons:" }
  ],
  "blocks": [
    {
      "type": "tab_benefits",
      "name": "Tab: Benefits",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "Product benefits" },
        { "type": "richtext", "id": "intro", "label": "Intro" },
        { "type": "richtext", "id": "bullets", "label": "Benefits", "info": "One per line or bullet." }
      ]
    },
    {
      "type": "tab_leave_out",
