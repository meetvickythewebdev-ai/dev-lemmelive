        { "type": "text", "id": "intro", "label": "Intro", "info": "[product] is replaced with the product name.", "default": "Learn more about [product], from how it works to when to take it and what makes our formula unique." },
        { "type": "metaobject_list", "id": "faqs", "metaobject_type": "lemme_faq", "label": "Questions", "limit": 40 }
