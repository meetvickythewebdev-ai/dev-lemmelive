{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lemme-pdp.js' | asset_url }}" defer></script>

{%- liquid
  assign m = product.metafields.lemme
  assign display_title = m.display_title.value | default: product.title
  assign selected_variant = product.selected_or_first_available_variant
  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif
  assign option_labels = m.option_labels.value
  assign option_copy = m.option_descriptions.value
  assign faqs = m.faqs.value
  assign awards = m.awards.value
  assign leave_out = m.leave_out.value
  assign benefits = m.benefits.value
  assign benefit_icons = m.benefit_icons.value
  assign benefit_icon_labels = m.benefit_icon_labels.value
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign form_id = 'LpForm-' | append: section.id
  assign drawer_id = 'LpDrawer-' | append: section.id
  assign highlights = section.settings.highlights | newline_to_br | split: '<br />'
-%}

<section class="lm-section lp-main" data-lp-main data-section-id="{{ section.id }}">
  <div class="lp-main__layout">

    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="lp-gallery" data-lp-gallery>
      <div class="lp-gallery__stage">
        <div class="lp-gallery__track" data-lp-track tabindex="0" aria-label="{{ 'Product images, use arrow keys to browse' | escape }}">
          {%- for media in product.media -%}
            {%- liquid
              if forloop.first
                assign img_loading = 'eager'
                assign img_priority = 'high'
              else
                assign img_loading = 'lazy'
                assign img_priority = 'auto'
              endif
              assign img_alt = media.alt | default: product.title
            -%}
            <div class="lp-gallery__slide" data-lp-slide>
              <div class="lp-gallery__zoom-wrap" data-lp-zoom-wrap>
                {{ media.preview_image | image_url: width: 2000 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600, 2000', sizes: '(min-width: 1024px) 50vw, 100vw', loading: img_loading, fetchpriority: img_priority, alt: img_alt, class: 'lp-gallery__img', draggable: 'false' }}
              </div>
            </div>
          {%- else -%}
            <div class="lp-gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'lp-gallery__img' }}</div>
          {%- endfor -%}
        </div>

        {%- if product.media.size > 1 -%}
          <button class="lp-gallery__arrow lp-gallery__arrow--prev" type="button" aria-label="Previous image" data-lp-prev disabled>{% render 'lemme-pdp-icon', icon: 'arrow-left' %}</button>
          <button class="lp-gallery__arrow lp-gallery__arrow--next" type="button" aria-label="Next image" data-lp-next>{% render 'lemme-pdp-icon', icon: 'arrow-right' %}</button>
        {%- endif -%}

        {%- if m.frontrow_id != blank -%}
          <div class="lp-gallery__frontrow">
            <iframe class="lp-gallery__frontrow-frame" title="FrontrowMD Clinicians' Choice Banner" src="https://app.thefrontrowhealth.com/api/widgets?presentation_type=sticker&amp;product_id={{ m.frontrow_id.value | url_encode }}" width="92" height="153" loading="lazy"></iframe>
          </div>
        {%- endif -%}

        {%- if m.card_badge != blank -%}
          <span class="lp-gallery__badge lp-text-badge">{% render 'lemme-pdp-icon', icon: 'badge-shape' %}<span>{{ m.card_badge.value }}</span></span>
        {%- endif -%}

        {%- if product.media.size > 0 -%}
          <button class="lp-gallery__zoom" type="button" aria-label="Zoom image" aria-pressed="false" data-lp-zoom>{% render 'lemme-pdp-icon', icon: 'zoom' %}</button>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="lp-gallery__thumbs" data-lp-thumbs>
          <div class="lp-gallery__thumbs-list" role="tablist" aria-label="Product images">
            {%- for media in product.media -%}
              <button class="lp-gallery__thumb{% if forloop.first %} is-active{% endif %}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}" data-lp-thumb="{{ forloop.index0 }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 64, height: 64 }}
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
    <div class="lp-buybox">
      <div class="lp-buybox__inner">
        <header class="lp-head">
          <div class="lp-head__title-row">
            <h1 class="lp-head__title">{{ display_title }}</h1>
            {%- if m.badge != blank -%}
              {%- if awards.size > 0 -%}
                <button class="lp-head__badge lp-head__badge--button" type="button" aria-label="View awards" aria-controls="{{ drawer_id }}" data-lp-open="awards">
                  {{ m.badge.value | image_url: width: 240 | image_tag: alt: '', width: 96, height: 96, loading: 'eager' }}
                </button>
              {%- else -%}
                <span class="lp-head__badge">{{ m.badge.value | image_url: width: 240 | image_tag: alt: m.badge.value.alt, width: 96, height: 96, loading: 'eager' }}</span>
              {%- endif -%}
            {%- endif -%}
          </div>
          {%- if m.subtitle != blank -%}<p class="lp-head__subtitle">{{ m.subtitle.value }}</p>{%- endif -%}
          {%- if rating != blank -%}
            {%- assign rating_pct = rating.rating | times: 100.0 | divided_by: rating.scale_max -%}
            <a class="lp-rating" href="#reviews" aria-label="Rated {{ rating.rating | round: 1 }} out of {{ rating.scale_max | round }} stars{% if rating_count != blank %}, {{ rating_count }} reviews{% endif %}. Go to reviews">
              <span class="lp-rating__stars" style="--lp-rating: {{ rating_pct }}%;" aria-hidden="true"></span>
              {%- if rating_count != blank -%}
                {%- liquid
                  assign rc = rating_count | times: 1
                  if rc >= 1000
                    assign rc_k = rc | divided_by: 1000
                    assign rc_r = rc | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
                    assign rc_text = rc_k | append: ',' | append: rc_r
                  else
                    assign rc_text = rc
                  endif
                -%}
                <span class="lp-rating__count" aria-hidden="true">({{ rc_text }} {{ section.settings.reviews_label }})</span>
              {%- endif -%}
            </a>
          {%- endif -%}
          {%- if m.intro != blank -%}
            <div class="lp-head__description">{{ m.intro.value | newline_to_br }}</div>
          {%- elsif product.description != blank -%}
            <div class="lp-head__description">{{ product.description }}</div>
          {%- endif -%}
        </header>

        {%- comment -%} Tabs that open the details drawer {%- endcomment -%}
        {%- capture tab_buttons -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              {%- liquid
                assign show = false
                case block.settings.content
                  when 'benefits'
                    if benefits.size > 0 or m.benefits_intro != blank
                      assign show = true
                    endif
                  when 'leave_out'
                    if leave_out.size > 0
                      assign show = true
                    endif
                  when 'supplement'
                    if m.supplement_facts != blank
                      assign show = true
                    endif
                  when 'faqs'
                    if faqs.size > 0
                      assign show = true
                    endif
                  when 'awards'
                    if awards.size > 0
                      assign show = true
                    endif
                  when 'details'
                    if product.description != blank
                      assign show = true
                    endif
                endcase
              -%}
              {%- if show -%}
                <button class="lp-tab" type="button" aria-expanded="false" aria-controls="{{ drawer_id }}" data-lp-open="{{ block.settings.content }}" data-lp-title="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
                  <span>{{ block.settings.title }}</span>
                  <span class="lp-tab__icon">{% render 'lemme-pdp-icon', icon: 'plus', class: 'lp-tab__plus' %}{% render 'lemme-pdp-icon', icon: 'minus', class: 'lp-tab__minus' %}</span>
                </button>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if tab_buttons != blank -%}
          <div class="lp-tabs" data-lp-tabs>
            <button class="lp-tabs__arrow lp-tabs__arrow--prev" type="button" aria-label="Scroll tabs left" tabindex="-1" hidden data-lp-tabs-prev>{% render 'lemme-pdp-icon', icon: 'arrow-left-small' %}</button>
            <div class="lp-tabs__scroller" data-lp-tabs-scroller>
              <div class="lp-tabs__list">{{ tab_buttons }}</div>
            </div>
            <button class="lp-tabs__arrow lp-tabs__arrow--next" type="button" aria-label="Scroll tabs right" tabindex="-1" hidden data-lp-tabs-next>{% render 'lemme-pdp-icon', icon: 'arrow-right-small' %}</button>
          </div>
        {%- endif -%}

        {%- comment -%} Format (sibling products, e.g. gummies / capsules) {%- endcomment -%}
        {%- assign formats = m.format_products.value -%}
        {%- if formats.size > 0 -%}
          <fieldset class="lp-format">
            <legend class="lm-visually-hidden">{{ section.settings.format_label | remove: ':' }}</legend>
            <p class="lp-label-row"><span class="lp-label-row__label">{{ section.settings.format_label }}</span><span>{{ m.format_name.value | default: display_title }}</span></p>
            <div class="lp-format__list">
              {%- for fp in formats -%}
                {%- liquid
                  assign fp_name = fp.metafields.lemme.format_name.value | default: fp.metafields.lemme.display_title.value | default: fp.title
                  assign fp_swatch = fp.metafields.lemme.format_swatch.value | default: fp.featured_media.preview_image
                  assign is_current = false
                  if fp.id == product.id
                    assign is_current = true
                  endif
                -%}
                <a class="lp-format__item{% if is_current %} is-active{% endif %}{% unless fp.available %} is-unavailable{% endunless %}" href="{{ fp.url }}"{% if is_current %} aria-current="page"{% endif %}>
                  {%- if fp_swatch != blank -%}<span class="lp-format__swatch">{{ fp_swatch | image_url: width: 96 | image_tag: alt: '', loading: 'lazy', width: 32, height: 32 }}</span>{%- endif -%}
                  <span class="lp-format__name">{{ fp_name }}</span>
                </a>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}

        {%- if m.flavor != blank -%}
          <p class="lp-label-row"><span class="lp-label-row__label">{{ section.settings.flavor_label }}</span><span>{{ m.flavor.value }}</span></p>
        {%- endif -%}

        {%- comment -%} Purchase options {%- endcomment -%}
        <div class="lp-buy" data-lp-buy>
          <p class="lp-label-row"><span class="lp-label-row__label">{{ section.settings.options_label }}</span><span data-lp-option-name></span></p>
          <fieldset class="lp-options">
            <legend class="lm-visually-hidden">{{ section.settings.options_legend }}</legend>
            {%- for variant in product.variants -%}
              {%- liquid
                assign idx = forloop.index0
                assign plan_id = ''
                assign opt_price = variant.price
                assign opt_compare = variant.compare_at_price
                if has_plans and variant.selling_plan_allocations.size > 0
                  assign allocation = variant.selling_plan_allocations.first
                  assign plan_id = allocation.selling_plan.id
                  assign opt_price = allocation.price
                  assign opt_compare = variant.price
                  if allocation.compare_at_price > opt_compare
                    assign opt_compare = allocation.compare_at_price
                  endif
                endif
                assign opt_label = option_labels[idx]
                if opt_label == blank
                  if variant.title == 'Default Title'
                    assign opt_label = section.settings.single_label
                  else
                    assign opt_label = variant.title
                  endif
                endif
                assign opt_text = option_copy[idx]
                assign saving = 0
                if opt_compare > opt_price
                  assign saving = opt_compare | minus: opt_price | times: 100.0 | divided_by: opt_compare | round
                endif
              -%}
              <div class="lp-option">
                <input class="lp-option__radio lm-visually-hidden" type="radio" name="lp-option-{{ section.id }}" id="LpOption-{{ section.id }}-{{ variant.id }}" value="{{ variant.id }}" data-name="{{ opt_label | escape }}" data-selling-plan="{{ plan_id }}" data-price="{{ opt_price | money_without_trailing_zeros }}" data-price-cents="{{ opt_price }}" data-compare-cents="{{ opt_compare | default: opt_price }}" data-once-price="{{ variant.price | money_without_trailing_zeros }}" data-once-cents="{{ variant.price }}" data-available="{{ variant.available }}"{% if variant.id == selected_variant.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                <label class="lp-option__label" for="LpOption-{{ section.id }}-{{ variant.id }}">
                  <span class="lp-option__main">
                    <span class="lp-option__mark" aria-hidden="true"></span>
                    <span class="lp-option__text">
                      <span class="lp-option__title">{{ opt_label }}</span>
                      {%- if opt_text != blank or variant.available == false -%}
                        <span class="lp-option__copy">{% if variant.available %}{{ opt_text }}{% else %}{{ section.settings.sold_out }}{% endif %}</span>
                      {%- endif -%}
                    </span>
                    <span class="lp-option__pricing">
                      <span class="lp-option__price">
                        {%- if opt_compare > opt_price -%}
                          <span class="lm-visually-hidden">Sale price</span><span>{{ opt_price | money_without_trailing_zeros }}</span><span class="lm-visually-hidden">Regular price</span><s>{{ opt_compare | money_without_trailing_zeros }}</s>
                        {%- else -%}
                          <span>{{ opt_price | money_without_trailing_zeros }}</span>
                        {%- endif -%}
                      </span>
                      {%- if saving > 0 -%}<span class="lp-option__savings">{{ saving }}% off</span>{%- endif -%}
                    </span>
                  </span>
                  {%- if section.settings.highlights != blank -%}
                    <ul class="lp-option__highlights">
                      {%- for line in highlights -%}
                        {%- assign line = line | strip -%}
                        {%- if line != blank -%}<li>{% render 'lemme-pdp-icon', icon: 'sparkle' %}<span>{{ line }}</span></li>{%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </label>
              </div>
            {%- endfor -%}
          </fieldset>

          {%- form 'product', product, id: form_id, class: 'lp-form', novalidate: 'novalidate', data-lp-form: '' -%}
            <input type="hidden" name="id" value="{{ selected_variant.id }}" data-lp-variant>
            <input type="hidden" name="selling_plan" value="" data-lp-plan{% unless has_plans %} disabled{% endunless %}>
            <button class="lp-btn lp-btn--dark lp-form__submit" type="submit" name="add" data-lp-submit data-add="{{ section.settings.add_label | escape }}" data-sold-out="{{ section.settings.sold_out | escape }}" data-added="{{ section.settings.added_label | escape }}"{% unless selected_variant.available %} disabled{% endunless %}>
              <span data-lp-submit-label>{%- if selected_variant.available -%}{{ selected_variant.price | money_without_trailing_zeros }} — {{ section.settings.add_label }}{%- else -%}{{ section.settings.sold_out }}{%- endif -%}</span>
            </button>
            {%- if has_plans -%}
              <p class="lp-form__once"><button class="lp-form__once-btn" type="submit" name="add" data-lp-once>{{ section.settings.buy_once_label }} <span data-lp-once-price>{{ selected_variant.price | money_without_trailing_zeros }}</span></button></p>
            {%- endif -%}
            <p class="lp-form__status" role="status" aria-live="polite" data-lp-status></p>
          {%- endform -%}
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'gift' -%}
            <div class="lp-gift" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}<span class="lp-gift__label">{{ block.settings.label }}</span>{%- endif -%}
              <div class="lp-gift__body">
                {%- render 'lemme-image', image: block.settings.image, fallback: 'lemme-gift-maelys.webp', alt: block.settings.title, class: 'lp-gift__img', sizes: '84px', fw: 240, fh: 222 -%}
                <div class="lp-gift__text">
                  <p class="lp-gift__name">{{ block.settings.title }}</p>
                  {%- if block.settings.tag != blank -%}<span class="lp-gift__tag">{{ block.settings.tag }}</span>{%- endif -%}
                </div>
              </div>
              {%- if block.settings.note != blank -%}<p class="lp-gift__note">{{ block.settings.note }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if benefit_icons.size > 0 -%}
          <div class="lp-icons">
            <ul class="lp-icons__grid">
              {%- for icon in benefit_icons -%}
                {%- assign icon_label = benefit_icon_labels[forloop.index0] | default: icon.alt -%}
                <li class="lp-icons__item">
                  {{ icon | image_url: width: 180 | image_tag: alt: '', loading: 'lazy', width: 60, height: 60 }}
                  <p class="lp-icons__label">{{ icon_label }}</p>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- comment -%} "Lemme get the full routine" bundle {%- endcomment -%}
        {%- assign routine = m.routine_products.value -%}
        {%- if routine.size > 0 -%}
          <section class="lp-upsell" aria-labelledby="LpUpsell-{{ section.id }}" data-lp-upsell>
            <h2 class="lp-upsell__heading" id="LpUpsell-{{ section.id }}">{{ section.settings.routine_heading }}</h2>
            <ul class="lp-upsell__images">
              <li class="lp-upsell__image-item"><a class="lp-upsell__image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{%- if product.featured_media -%}{{ product.featured_media.preview_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '', width: 140, height: 140 }}{%- endif -%}</a></li>
              {%- for rp in routine -%}
                <li class="lp-upsell__image-item"><a class="lp-upsell__image" href="{{ rp.url }}" aria-label="{{ rp.title | escape }}">{%- if rp.featured_media -%}{{ rp.featured_media.preview_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '', width: 140, height: 140 }}{%- endif -%}</a></li>
              {%- endfor -%}
            </ul>
            <div class="lp-upsell__pricing">
              <p class="lp-upsell__total">
                <strong class="lp-upsell__total-label">{{ section.settings.routine_total_label }}</strong>
                <span class="lp-upsell__total-prices"><span class="lp-upsell__total-now" data-lp-upsell-total></span><s class="lp-upsell__total-was" data-lp-upsell-was hidden></s></span>
              </p>
              <button class="lp-btn lp-btn--light lp-upsell__btn" type="button" data-lp-upsell-add>{{ section.settings.routine_button }}</button>
              <p class="lp-upsell__status" role="status" aria-live="polite" data-lp-upsell-status></p>
            </div>
            <div class="lp-upsell__current">
              <div class="lp-upsell__current-info">
                <span class="lp-upsell__current-title">{{ product.title }}</span>
                <span class="lp-upsell__current-option" data-lp-upsell-option></span>
              </div>
              <span class="lp-upsell__current-prices"><span class="lp-upsell__current-price" data-lp-upsell-price></span><s class="lp-upsell__current-was" data-lp-upsell-price-was hidden></s></span>
            </div>
            <fieldset class="lp-upsell__addons">
              <legend class="lp-upsell__addons-legend">{{ section.settings.routine_addons_label }}</legend>
              {%- for rp in routine -%}
                {%- assign rv = rp.selected_or_first_available_variant -%}
                <div class="lp-upsell__addon">
                  <input class="lp-upsell__checkbox" type="checkbox" id="LpAddon-{{ section.id }}-{{ rv.id }}" value="{{ rv.id }}" data-price="{{ rv.price }}" data-compare="{{ rv.compare_at_price | default: rv.price }}"{% if rv.available %} checked{% else %} disabled{% endif %}>
                  <label class="lp-upsell__addon-label" for="LpAddon-{{ section.id }}-{{ rv.id }}">
                    <span class="lp-upsell__box" aria-hidden="true">{% render 'lemme-pdp-icon', icon: 'tick' %}</span>
                    <span class="lp-upsell__addon-title">{{ rp.title }}</span>
                    <span class="lp-upsell__addon-price">{{ rv.price | money_without_trailing_zeros }}</span>
                  </label>
                </div>
              {%- endfor -%}
            </fieldset>
          </section>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ---------- Details drawer (one panel per tab) ---------- {%- endcomment -%}
  <div class="lp-drawer-overlay" data-lp-overlay data-lp-portal="overlay-{{ section.id }}" hidden></div>
  <aside class="lm-section lp-drawer" id="{{ drawer_id }}" role="dialog" aria-modal="true" aria-labelledby="{{ drawer_id }}-title" data-lp-drawer hidden>
    <div class="lp-drawer__inner">
      <header class="lp-drawer__header">
        <h2 class="lp-drawer__title" id="{{ drawer_id }}-title" data-lp-drawer-title></h2>
        <button class="lp-drawer__close" type="button" aria-label="Close" data-lp-close>{% render 'lemme-pdp-icon', icon: 'close' %}</button>
      </header>
      <div class="lp-drawer__body" data-lp-drawer-body>

        {%- if benefits.size > 0 or m.benefits_intro != blank -%}
          <div class="lp-panel" data-lp-panel="benefits" hidden>
            {%- if m.benefits_intro != blank -%}<div class="lp-panel__intro">{{ m.benefits_intro.value | newline_to_br }}</div>{%- endif -%}
            <ul class="lp-panel__bullets">
              {%- for benefit in benefits -%}<li>{% render 'lemme-pdp-icon', icon: 'sparkle' %}<span>{{ benefit }}</span></li>{%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if leave_out.size > 0 -%}
          <div class="lp-panel" data-lp-panel="leave_out" hidden>
            <p class="lp-panel__intro">{{ section.settings.leave_out_intro | replace: '[product]', display_title }}</p>
            <ul class="lp-panel__leave">
              {%- for item in leave_out -%}
                <li>
                  <span class="lp-panel__leave-icon">{%- if item.icon.value != blank -%}{{ item.icon.value | image_url: width: 120 | image_tag: alt: '', loading: 'lazy', width: 45, height: 45 }}{%- endif -%}</span>
                  <span><strong>{{ section.settings.leave_out_prefix }}</strong> {{ item.label.value }}</span>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if m.supplement_facts != blank -%}
          <div class="lp-panel lp-facts" data-lp-panel="supplement" hidden>
            {%- if m.suggested_use != blank -%}<p class="lp-facts__use">{{ m.suggested_use.value }}</p>{%- endif -%}
            <div class="lp-facts__serving">
              <p class="lp-facts__name">{{ section.settings.facts_heading }}</p>
              {%- for line in m.serving_info.value -%}<p>{{ line }}</p>{%- endfor -%}
            </div>
            <table class="lp-facts__table">
              <thead><tr><th scope="col">{{ section.settings.facts_amount_label }}</th><th scope="col">{{ section.settings.facts_dv_label }}</th></tr></thead>
              <tbody>
                {%- assign rows = m.supplement_facts.value | newline_to_br | split: '<br />' -%}
                {%- for row in rows -%}
                  {%- assign row_clean = row | strip -%}
                  {%- if row_clean != blank -%}
                    {%- assign cols = row_clean | split: '|' -%}
                    <tr>
                      <td>{{ cols[0] | strip }}{%- if cols[2] != blank -%}<br><span>{{ cols[2] | strip }}</span>{%- endif -%}</td>
                      <td>{{ cols[1] | strip | replace: '†', '<sup>†</sup>' }}</td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
            {%- if m.supplement_footnote != blank -%}<p class="lp-facts__text">{{ m.supplement_footnote.value | newline_to_br | replace: '†', '<sup>†</sup>' }}</p>{%- endif -%}
            {%- if m.other_ingredients != blank -%}<p class="lp-facts__text"><strong>{{ section.settings.other_ingredients_label }}</strong> {{ m.other_ingredients.value }}</p>{%- endif -%}
            {%- if m.warning != blank -%}<p class="lp-facts__text"><strong>{{ section.settings.warning_label }}</strong> {{ m.warning.value }}</p>{%- endif -%}
          </div>
        {%- endif -%}

        {%- if faqs.size > 0 -%}
          <div class="lp-panel" data-lp-panel="faqs" hidden>
            <p class="lp-panel__intro">{{ m.faq_intro.value | default: section.settings.faq_intro | replace: '[product]', display_title }}</p>
            <div class="lp-panel__faqs">
              {%- for faq in faqs -%}
                <details class="lp-panel__faq" data-lp-accordion>
                  <summary class="lp-panel__faq-q"><span>{{ faq.question.value }}</span><span class="lp-panel__faq-icon">{% render 'lemme-pdp-icon', icon: 'plus', class: 'lp-when-closed' %}{% render 'lemme-pdp-icon', icon: 'minus', class: 'lp-when-open' %}</span></summary>
                  <div class="lp-panel__faq-a" data-lp-accordion-content>{{ faq.answer.value | newline_to_br }}</div>
                </details>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if awards.size > 0 -%}
          <div class="lp-panel" data-lp-panel="awards" hidden>
            <p class="lp-panel__intro">{{ section.settings.awards_intro }}</p>
            <ul class="lp-panel__awards">
              {%- for award in awards -%}
                <li class="lp-award">
                  <div class="lp-award__top">
                    <div class="lp-award__media">{%- if award.image.value != blank -%}{{ award.image.value | image_url: width: 176 | image_tag: alt: '', loading: 'lazy', width: 72, height: 72 }}{%- endif -%}</div>
                    <div class="lp-award__heading">
                      <p class="lp-award__title">{{ award.title.value }}</p>
                      {%- if award.subtitle != blank -%}<p class="lp-award__subtitle">{{ award.subtitle.value }}</p>{%- endif -%}
                    </div>
                  </div>
                  {%- if award.description != blank -%}<div class="lp-award__copy">{{ award.description.value | newline_to_br }}</div>{%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if product.description != blank -%}
          <div class="lp-panel lp-panel--rte" data-lp-panel="details" hidden>{{ product.description }}</div>
        {%- endif -%}
      </div>
      <nav class="lp-drawer__nav" aria-label="Details">
        <button class="lp-drawer__nav-btn" type="button" data-lp-drawer-prev hidden>{% render 'lemme-pdp-icon', icon: 'arrow-left-small' %}<span data-lp-label></span></button>
        <button class="lp-drawer__nav-btn lp-drawer__nav-btn--next" type="button" data-lp-drawer-next hidden><span data-lp-label></span>{% render 'lemme-pdp-icon', icon: 'arrow-right-small' %}</button>
      </nav>
    </div>
  </aside>

  {%- comment -%} ---------- Sticky add to bag ---------- {%- endcomment -%}
  <div class="lm-section lp-satc" data-lp-sticky data-lp-portal="satc-{{ section.id }}">
    <div class="lp-satc__media">
      {%- assign satc_image = m.sticky_image.value | default: product.featured_media.preview_image -%}
      {%- if satc_image != blank -%}{{ satc_image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy', width: 88, height: 88 }}{%- endif -%}
    </div>
    <div class="lp-satc__action">
      <button class="lp-satc__btn" type="button" data-lp-sticky-btn><span data-lp-sticky-label>{{ section.settings.add_label }}</span><span class="lm-visually-hidden">: {{ product.title }}</span></button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lemme product",
  "class": "lp-main-section",
  "settings": [
    { "type": "paragraph", "content": "Most of this section comes from the product's \"lemme\" metafields. See the setup guide." },
    { "type": "text", "id": "reviews_label", "label": "Reviews count label", "default": "Reviews" },
    { "type": "header", "content": "Options" },
    { "type": "text", "id": "format_label", "label": "Format label", "default": "Format:" },
    { "type": "text", "id": "flavor_label", "label": "Flavour label", "default": "Flavor:" },
    { "type": "text", "id": "options_label", "label": "Options label", "default": "Frequency:" },
    { "type": "text", "id": "options_legend", "label": "Options label (screen readers)", "default": "Choose an option" },
    { "type": "text", "id": "single_label", "label": "Option label for products without variants", "default": "One-time purchase" },
    { "type": "textarea", "id": "highlights", "label": "Perks under the selected option", "info": "One per line.", "default": "VIP access to exclusive drops\nEarn loyalty points for free products & discounts\nGuaranteed delivery during sell-outs\nPause, update frequency or cancel anytime by logging into your account" },
    { "type": "text", "id": "add_label", "label": "Add to bag label", "default": "Add to Bag" },
    { "type": "text", "id": "added_label", "label": "Added message", "default": "Added to your bag!" },
    { "type": "text", "id": "sold_out", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "buy_once_label", "label": "Buy once link (subscription products)", "default": "Buy once for" },
    { "type": "header", "content": "Bundle", "info": "Shown when the product has a \"lemme.routine_products\" metafield." },
    { "type": "text", "id": "routine_heading", "label": "Heading", "default": "Lemme Get the Full Routine:" },
    { "type": "text", "id": "routine_total_label", "label": "Total label", "default": "Total Price:" },
    { "type": "text", "id": "routine_button", "label": "Button", "default": "Add bundle to cart" },
    { "type": "text", "id": "routine_addons_label", "label": "Add-ons label", "default": "One-time Add-ons:" },
    { "type": "header", "content": "Drawer" },
    { "type": "text", "id": "leave_out_intro", "label": "What we leave out intro", "info": "[product] is replaced with the product name.", "default": "Clean formulas, nothing you don’t need. Here’s what we leave out of [product]." },
    { "type": "text", "id": "leave_out_prefix", "label": "What we leave out prefix", "default": "No" },
    { "type": "text", "id": "faq_intro", "label": "FAQs intro", "default": "Learn more about [product], from how it works to when to take it and what makes our formula unique." },
    { "type": "text", "id": "awards_intro", "label": "Awards intro", "default": "Recognized by the best in beauty and wellness. Explore the awards and accolades celebrating our standout formulas." },
    { "type": "text", "id": "facts_heading", "label": "Facts heading", "default": "Supplement facts" },
    { "type": "text", "id": "facts_amount_label", "label": "Facts table column 1", "default": "Amount Per Serving" },
    { "type": "text", "id": "facts_dv_label", "label": "Facts table column 2", "default": "% Daily Value*" },
    { "type": "text", "id": "other_ingredients_label", "label": "Other ingredients label", "default": "Other Ingredients" },
    { "type": "text", "id": "warning_label", "label": "Warning label", "default": "WARNING" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Product benefits" },
        { "type": "select", "id": "content", "label": "Opens", "default": "benefits", "options": [
          { "value": "benefits", "label": "Benefits (lemme.benefits_intro + lemme.benefits)" },
          { "value": "leave_out", "label": "What we leave out (lemme.leave_out)" },
          { "value": "supplement", "label": "Supplement facts" },
          { "value": "faqs", "label": "FAQs (lemme.faqs)" },
          { "value": "awards", "label": "Awards (lemme.awards)" },
          { "value": "details", "label": "Product description" }
        ] }
      ]
    },
    {
      "type": "gift",
      "name": "Free gift box",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "FREE MAËLYS GIFT" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Gift name", "default": "MAËLYS Get-Dreamy" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "$55+ order" },
        { "type": "text", "id": "note", "label": "Note", "default": "*Travel size MAËLYS Get-Dreamy gift on subscription orders $55+." }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
