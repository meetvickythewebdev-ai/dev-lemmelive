{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lemme-home.js' | asset_url }}" defer></script>

{%- liquid
  assign layout = section.settings.layout
  assign icon_items = section.settings.icon_items
  if layout == 'icons' and section.settings.subheading != blank
    assign sub = section.settings.subheading | newline_to_br
  else
    assign sub = section.settings.subheading
  endif
-%}
{%- if layout != 'icons' or icon_items.size > 0 or section.blocks.size > 0 -%}
<section class="lm-section lm-benefits{% if layout == 'trust' %} lm-benefits--trust{% elsif layout == 'icons' %} lm-benefits--icons{% endif %}"{% if section.settings.background != blank %} style="background: {{ section.settings.background }};"{% endif %} aria-labelledby="LmBenefitsHeading-{{ section.id }}">
  <div class="lm-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="lm-benefits__heading" id="LmBenefitsHeading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if sub != blank -%}
      <p class="lm-benefits__sub">{{ sub }}</p>
    {%- endif -%}
    {%- if layout == 'icons' -%}
      <ul class="lm-benefits__icons" role="list">
        {%- if icon_items.size > 0 -%}
          {%- for item in icon_items -%}
            <li class="lm-benefit-icon">
              <span class="lm-benefit-icon__circle">{%- if item.icon.value != blank -%}{{ item.icon.value | image_url: width: 192 | image_tag: alt: '', loading: 'lazy', width: 96, height: 96 }}{%- endif -%}</span>
              <h3 class="lm-benefit-icon__label">{{ item.label.value }}</h3>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <li class="lm-benefit-icon" {{ block.shopify_attributes }}>
              <span class="lm-benefit-icon__circle">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 192 | image_tag: alt: '', loading: 'lazy', width: 96, height: 96 }}{%- endif -%}</span>
              <h3 class="lm-benefit-icon__label">{{ block.settings.title }}</h3>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    {%- else -%}
    <ul class="lm-benefits__grid">
      {%- for block in section.blocks -%}
        <li class="lm-benefit" {{ block.shopify_attributes }}>
          <div class="lm-benefit__media">
            {%- render 'lemme-image', image: block.settings.image, fallback: block.settings.bundled_image, alt: block.settings.title, sizes: '(min-width: 1025px) 25vw, 50vw', fw: 400, fh: 400 -%}
          </div>
          <div class="lm-benefit__body">
            <span class="lm-benefit__check">{% render 'lemme-icon', icon: 'check' %}</span>
            <h3 class="lm-benefit__title">{{ block.settings.title }}</h3>
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Lemme benefit cards",
  "class": "lm-benefits-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "lemme get real results" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The twist? So delicious you won't believe they're supplements." },
    { "type": "select", "id": "layout", "label": "Spacing", "default": "home", "options": [ { "value": "home", "label": "Homepage" }, { "value": "trust", "label": "Collection page (larger heading, more space)" }, { "value": "icons", "label": "Round icons (bundle page)" } ] },
    { "type": "metaobject_list", "id": "icon_items", "metaobject_type": "lemme_icon_item", "label": "Icons", "limit": 8, "info": "Round icons layout only. Connect to a product's \"Highlight icons\" metafield to set them per product; empty = the blocks below." },
    { "type": "color", "id": "background", "label": "Background" },
    { "type": "paragraph", "content": "On mobile the cards collapse into compact rows without images, like the live site. In the round icons layout each block is an icon with a label." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Expert formulated" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "bundled_image", "label": "Built-in image (used when no image is chosen)", "default": "lemme-benefit-expert-formulated.webp", "options": [
          { "value": "lemme-benefit-expert-formulated.webp", "label": "Expert formulated" },
          { "value": "lemme-benefit-third-party-tested.webp", "label": "3rd party tested" },
          { "value": "lemme-benefit-tastes-like-heaven.webp", "label": "Tastes like heaven" },
          { "value": "lemme-benefit-bioavailable.webp", "label": "Bioavailable" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lemme benefit cards",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Expert formulated", "bundled_image": "lemme-benefit-expert-formulated.webp" } },
        { "type": "benefit", "settings": { "title": "Validated by 3rd party testing", "bundled_image": "lemme-benefit-third-party-tested.webp" } },
        { "type": "benefit", "settings": { "title": "Science-backed innovation", "bundled_image": "lemme-benefit-tastes-like-heaven.webp" } },
        { "type": "benefit", "settings": { "title": "Thousands of 5-star testimonials ⭐⭐⭐⭐⭐", "bundled_image": "lemme-benefit-bioavailable.webp" } }
      ]
    }
  ]
}
{% endschema %}
