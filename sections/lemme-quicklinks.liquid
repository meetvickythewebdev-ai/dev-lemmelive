              {%- endcase -%}
            {%- endif -%}
          </span>
          <span>{{ block.settings.title }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Lemme quick links",
  "class": "lm-quicklinks-section",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "mobile_only", "label": "Show on mobile and tablet only", "default": true },
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Mood, Sleep, Energy" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "image_picker", "id": "icon", "label": "Custom icon" },
        { "type": "select", "id": "builtin_icon", "label": "Built-in icon", "default": "mood", "options": [
          { "value": "mood", "label": "Person (mood, sleep, energy)" },
          { "value": "weight", "label": "Lightning (weight)" },
          { "value": "womens", "label": "Sparkle (women's health)" },
          { "value": "beauty", "label": "Face (beauty & digestion)" },
          { "value": "heart", "label": "Heart (bundle)" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lemme quick links",
      "blocks": [
        { "type": "link", "settings": { "title": "Mood, Sleep, Energy", "url": "/collections/mood-sleep-energy", "builtin_icon": "mood" } },
        { "type": "link", "settings": { "title": "Weight Management", "url": "/collections/metabolism-weight-management", "builtin_icon": "weight" } },
        { "type": "link", "settings": { "title": "Women's Health", "url": "/collections/womens-health", "builtin_icon": "womens" } },
        { "type": "link", "settings": { "title": "Beauty & Digestion", "url": "/collections/beauty-digestion", "builtin_icon": "beauty" } },
        { "type": "link", "settings": { "title": "Build a Bundle", "url": "/products/byob-4-pack", "builtin_icon": "heart" } }
      ]
    }
  ]
}
{% endschema %}
