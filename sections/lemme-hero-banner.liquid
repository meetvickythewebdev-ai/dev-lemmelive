{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign img_d = section.settings.image
  assign img_m = section.settings.image_mobile | default: section.settings.image
  assign heading_m = section.settings.heading_mobile | default: section.settings.heading
-%}
<section class="lm-section ls-hero" style="--ls-hero-text: {{ section.settings.text_color }}; --ls-hero-bg: {{ section.settings.background }};">
  <div class="ls-hero__layout">
    <div class="ls-hero__media">
      {%- if img_d != blank -%}
        <picture>
          <source media="(min-width: 1024px)" srcset="{{ img_d | image_url: width: 1500 }} 1500w, {{ img_d | image_url: width: 2200 }} 2200w, {{ img_d | image_url: width: 3000 }} 3000w" sizes="100vw">
          <source srcset="{{ img_m | image_url: width: 600 }} 600w, {{ img_m | image_url: width: 900 }} 900w, {{ img_m | image_url: width: 1200 }} 1200w" sizes="100vw">
          {{ img_m | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.heading, sizes: '100vw' }}
        </picture>
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'ls-hero__placeholder' }}
      {%- endif -%}
    </div>
    <div class="ls-hero__content">
      <div class="ls-hero__copy">
        <h1 class="ls-hero__heading">
          <span class="ls-hero__desktop">{{ section.settings.heading }}</span>
          <span class="ls-hero__mobile">{{ heading_m | newline_to_br }}</span>
        </h1>
        {%- if section.settings.text != blank -%}<div class="ls-hero__text">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="ls-hero__actions">
          {%- if section.settings.button_1_label != blank -%}<a class="ls-btn ls-btn--dark" href="{{ section.settings.button_1_url | default: routes.all_products_collection_url }}"><span>{{ section.settings.button_1_label }}</span></a>{%- endif -%}
          {%- if section.settings.button_2_label != blank -%}<a class="ls-btn ls-btn--light" href="{{ section.settings.button_2_url | default: '#' }}"><span>{{ section.settings.button_2_label }}</span></a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lemme hero banner",
  "class": "ls-hero-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "2:1 works best (live: 3024 × 1512)." },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)", "info": "Portrait, about 390 × 625." },
    { "type": "text", "id": "heading", "label": "Heading (desktop)", "default": "wellness made right" },
    { "type": "textarea", "id": "heading_mobile", "label": "Heading (mobile)", "info": "New lines become line breaks.", "default": "wellness\nmade right" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Science-backed results <strong>you can feel.</strong></p>" },
    { "type": "text", "id": "button_1_label", "label": "Button 1", "default": "Shop all" },
    { "type": "url", "id": "button_1_url", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_label", "label": "Button 2", "default": "Build Your Bundle" },
    { "type": "url", "id": "button_2_url", "label": "Button 2 link" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#000000" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [ { "name": "Lemme hero banner" } ]
}
{% endschema %}
