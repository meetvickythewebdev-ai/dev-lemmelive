{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign m = product.metafields.lemme
  assign diff_text = section.settings.body
  if diff_text == blank and m.difference_text.value != blank
    assign diff_text = m.difference_text.value | newline_to_br
  endif
  if diff_text == blank
    assign diff_text = section.settings.text
  endif
  assign diff_image = section.settings.product_image | default: m.difference_image.value | default: section.settings.image
  assign items = section.settings.items | default: m.difference_items.value
-%}

<section class="lm-section lp-diff" id="difference" data-lp-nav="{{ section.settings.nav_label | escape }}" aria-labelledby="LpDiff-{{ section.id }}">
  <div class="lp-diff__layout{% if diff_image == blank %} lp-diff__layout--no-media{% endif %}">
    {%- if diff_image != blank -%}
      <div class="lp-diff__media">{{ diff_image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 1024px) 50vw, 100vw', widths: '400, 600, 800, 1200, 1600' }}</div>
    {%- endif -%}
    <div class="lp-diff__copy">
      <h2 class="lp-diff__heading" id="LpDiff-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if diff_text != blank -%}<div class="lp-diff__text">{{ diff_text | newline_to_br }}</div>{%- endif -%}
      <ul class="lp-diff__items">
        {%- if items.size > 0 -%}
          {%- for item in items -%}
            <li class="lp-diff__item">
              <span class="lp-diff__icon">{%- if item.icon.value != blank -%}{{ item.icon.value | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', width: 64, height: 64 }}{%- endif -%}</span>
              <p class="lp-diff__label">{{ item.label.value }}</p>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <li class="lp-diff__item" {{ block.shopify_attributes }}>
              <span class="lp-diff__icon">{%- render 'lemme-image', image: block.settings.image, fallback: block.settings.bundled_image, alt: '', sizes: '64px', fw: 192, fh: 192 -%}</span>
              <p class="lp-diff__label">{{ block.settings.label }}</p>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lemme difference",
  "class": "lp-diff-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Link label", "default": "Difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "the lemme difference" },
    { "type": "richtext", "id": "body", "label": "Text (product)", "info": "Connected to lemme.difference_text. Empty = the text below." },
    { "type": "image_picker", "id": "product_image", "label": "Image (product)", "info": "Connected to lemme.difference_image. Empty = the image below." },
    { "type": "metaobject_list", "id": "items", "metaobject_type": "lemme_icon_item", "label": "Icons (product)", "info": "Connected to lemme.difference_items. Empty = the icon blocks.", "limit": 8 },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Lemme is third-party tested and made in NSF and GMP-certified facilities. Plus, the bottle and cap are made from 100% post-consumer recycled material.", "info": "Products with a \"lemme.difference_text\" metafield show that text instead." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Products with a \"lemme.difference_image\" metafield show that image instead." },
    { "type": "paragraph", "content": "Icons: products with a \"lemme.difference_items\" metafield (Icon item entries) show those; otherwise the icon blocks below are used." }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Vegetarian" },
        { "type": "image_picker", "id": "image", "label": "Icon (square, transparent)" },
        { "type": "select", "id": "bundled_image", "label": "Built-in icon", "default": "lemme-diff-vegetarian.png", "options": [
          { "value": "lemme-diff-vegetarian.png", "label": "Vegetarian (heart)" },
          { "value": "lemme-diff-gluten-free.png", "label": "Gluten-free (wheat)" },
          { "value": "lemme-diff-gelatin-free.png", "label": "Gelatin-free (citrus)" },
          { "value": "lemme-diff-no-dyes.png", "label": "No dyes (dropper)" },
          { "value": "lemme-diff-no-sugar-alcohols.png", "label": "No sugar alcohols (heart leaf)" },
          { "value": "lemme-diff-clinically-studied.png", "label": "Clinically studied (flask)" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lemme difference",
      "blocks": [
        { "type": "icon", "settings": { "label": "Vegetarian", "bundled_image": "lemme-diff-vegetarian.png" } },
        { "type": "icon", "settings": { "label": "Gluten-free", "bundled_image": "lemme-diff-gluten-free.png" } },
        { "type": "icon", "settings": { "label": "Gelatin-free", "bundled_image": "lemme-diff-gelatin-free.png" } },
        { "type": "icon", "settings": { "label": "No synthetic dyes or flavors", "bundled_image": "lemme-diff-no-dyes.png" } },
        { "type": "icon", "settings": { "label": "No sugar alcohols", "bundled_image": "lemme-diff-no-sugar-alcohols.png" } },
        { "type": "icon", "settings": { "label": "Clinically-studied ingredients", "bundled_image": "lemme-diff-clinically-studied.png" } }
      ]
    }
  ]
}
{% endschema %}
