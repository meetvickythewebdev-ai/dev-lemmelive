{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-sections.css' | asset_url | stylesheet_tag }}

<section class="lm-section ls-tiles" style="--ls-tiles-bg: {{ section.settings.background }};" aria-labelledby="LsTiles-{{ section.id }}">
  <h2 class="ls-tiles__title" id="LsTiles-{{ section.id }}">{{ section.settings.heading }}</h2>
  <ul class="ls-tiles__grid">
    {%- for block in section.blocks -%}
      <li class="ls-tiles__item" {{ block.shopify_attributes }}>
        <a class="ls-tiles__card" href="{{ block.settings.url | default: '#' }}">
          <span class="ls-tiles__media">
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 800 | image_tag: alt: '', loading: 'lazy', class: 'ls-tiles__image', sizes: '(min-width: 1024px) 25vw, 50vw', widths: '300, 450, 600, 800' }}{%- endif -%}
            <span class="ls-tiles__icon" aria-hidden="true">{% render 'lemme-pdp-icon', icon: 'arrow-up-right' %}</span>
          </span>
          <span class="ls-tiles__label">{{ block.settings.label }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Lemme linked tiles",
  "class": "ls-tiles-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "shop by benefit" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f7f1f9" }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "label", "label": "Label", "default": "Women's Health" },
      { "type": "url", "id": "url", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "Lemme linked tiles", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] } ]
}
{% endschema %}
