{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lemme-pdp.js' | asset_url }}" defer></script>

{%- assign ingredients = product.metafields.lemme.ingredients.value -%}
{%- if ingredients.size > 0 -%}
<section class="lm-section lp-ingr" id="ingredients" data-lp-nav="{{ section.settings.nav_label | escape }}" aria-labelledby="LpIngr-{{ section.id }}" data-lp-ingr>
  <div class="lp-ingr__inner">
    <div class="lp-ingr__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lp-eyebrow">{% render 'lemme-pdp-icon', icon: 'sparkle-big' %}<span>{{ section.settings.eyebrow }}</span>{% render 'lemme-pdp-icon', icon: 'sparkle-big' %}</p>
      {%- endif -%}
      <h2 class="lp-h2" id="LpIngr-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>
    <div class="lp-ingr__viewport">
      <ul class="lp-ingr__list{% if ingredients.size > 4 %} has-overflow{% endif %}" data-lp-ingr-track>
        {%- for item in ingredients -%}
          <li class="lp-ingr__slide{% if forloop.index > 4 %} lp-ingr__slide--overflow{% endif %}">
            <article class="lp-ingr__item">
              <div class="lp-ingr__media">
                {%- if item.image.value != blank -%}{{ item.image.value | image_url: width: 600 | image_tag: loading: 'lazy', alt: '', class: 'lp-ingr__photo', width: 300, height: 300 }}{%- endif -%}
              </div>
              <div class="lp-ingr__body">
                <div class="lp-ingr__copy">
                  <h3 class="lp-ingr__title">{{ item.name.value }}</h3>
                  {%- if item.description != blank -%}<div class="lp-ingr__subcopy">{{ item.description.value }}</div>{%- endif -%}
                </div>
                <button class="lp-ingr__expand" type="button" aria-label="View details for {{ item.name.value | strip_html | escape }}" aria-controls="LpIngrDrawer-{{ section.id }}" data-lp-ingr-open="{{ forloop.index0 }}">{% render 'lemme-pdp-icon', icon: 'plus-big' %}</button>
              </div>
              <template data-lp-ingr-detail>
                <div class="lp-ingr__drawer-text">{{ item.details.value | default: item.description.value | newline_to_br }}</div>
                {%- if item.image.value != blank -%}<div class="lp-ingr__drawer-image">{{ item.image.value | image_url: width: 800 | image_tag: loading: 'lazy', alt: '', width: 400, height: 400 }}</div>{%- endif -%}
              </template>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="lp-dots lp-ingr__dots" data-lp-dots aria-hidden="true"></div>
    {%- if ingredients.size > 4 -%}
      <button class="lp-ingr__more" type="button" data-lp-ingr-more>{{ section.settings.see_more }}</button>
    {%- endif -%}
  </div>

  <div class="lp-drawer-overlay" data-lp-overlay data-lp-portal="overlay-{{ section.id }}" hidden></div>
  <aside class="lm-section lp-drawer" id="LpIngrDrawer-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="LpIngrDrawer-{{ section.id }}-title" data-lp-drawer hidden>
    <div class="lp-drawer__inner">
      <header class="lp-drawer__header">
        <h2 class="lp-drawer__title" id="LpIngrDrawer-{{ section.id }}-title" data-lp-drawer-title></h2>
        <button class="lp-drawer__close" type="button" aria-label="Close" data-lp-close>{% render 'lemme-pdp-icon', icon: 'close' %}</button>
      </header>
      <div class="lp-drawer__body" data-lp-drawer-body></div>
      <nav class="lp-drawer__nav" aria-label="Ingredients">
        <button class="lp-drawer__nav-btn" type="button" data-lp-drawer-prev hidden>{% render 'lemme-pdp-icon', icon: 'arrow-left-small' %}<span>{{ section.settings.back_label }}</span></button>
        <button class="lp-drawer__nav-btn lp-drawer__nav-btn--next" type="button" data-lp-drawer-next hidden><span>{{ section.settings.next_label }}</span>{% render 'lemme-pdp-icon', icon: 'arrow-right-small' %}</button>
      </nav>
    </div>
  </aside>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Lemme ingredients",
  "class": "lp-ingr-section",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Link label", "default": "Ingredients" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ingredients" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "what's inside matters" },
    { "type": "text", "id": "see_more", "label": "See more label", "default": "See all ingredients" },
    { "type": "text", "id": "back_label", "label": "Drawer back label", "default": "Back" },
    { "type": "text", "id": "next_label", "label": "Drawer next label", "default": "Next" },
    { "type": "paragraph", "content": "Cards come from the product's \"lemme.ingredients\" metafield (Ingredient entries: name, short description, details, image). Hidden when a product has none." }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
