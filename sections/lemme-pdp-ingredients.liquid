{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-pdp.css' | asset_url | stylesheet_tag }}

{%- assign ingredients = product.metafields.lemme.ingredients.value -%}
{%- if ingredients.size > 0 -%}
<section class="lm-section lm-section--clear lm-ingr" id="LmIngredients" aria-labelledby="LmIngrHeading-{{ section.id }}">
  <div class="lm-container">
    <h2 class="lm-ingr__heading" id="LmIngrHeading-{{ section.id }}">{{ section.settings.heading }}</h2>
  </div>
  <div class="lm-ingr__track" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
    <ul class="lm-ingr__list">
      {%- for item in ingredients -%}
        <li class="lm-ingr__card">
          <div class="lm-ingr__content">
            <h3 class="lm-ingr__name">{{ item.name.value }}</h3>
            {%- if item.description != blank -%}<p class="lm-ingr__text">{{ item.description.value }}</p>{%- endif -%}
          </div>
          {%- if item.image.value != blank -%}
            <div class="lm-ingr__media">
              {{ item.image.value | image_url: width: 600 | image_tag: loading: 'lazy', alt: '', class: 'lm-ingr__img', width: 294, height: 294 }}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Lemme ingredients",
  "class": "lm-ingr-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "so what’s in it?" },
    { "type": "paragraph", "content": "Cards come from the product's \"lemme.ingredients\" metafield (a list of Ingredient entries). The section hides itself when a product has none." }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
