{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign img_d = section.settings.image
  assign img_m = section.settings.image_mobile | default: section.settings.image
  assign heading_d = section.settings.heading_desktop | default: section.settings.heading
-%}
<section class="lm-section ls-bwf" style="--ls-bwf-bg: {{ section.settings.background }};" aria-labelledby="LsBwf-{{ section.id }}">
  <div class="ls-bwf__card{% if img_d != blank %} ls-bwf__card--has-image{% endif %}">
    {%- if img_d != blank -%}
      <div class="ls-bwf__media" aria-hidden="true">
        <picture>
          <source media="(min-width: 1024px)" srcset="{{ img_d | image_url: width: 1000 }} 1000w, {{ img_d | image_url: width: 1500 }} 1500w" sizes="50vw">
          {{ img_m | image_url: width: 800 | image_tag: loading: 'lazy', alt: '', widths: '400, 600, 800', sizes: '100vw' }}
        </picture>
        <span class="ls-bwf__fade"></span>
      </div>
    {%- endif -%}
    <div class="ls-bwf__content">
      <div class="ls-bwf__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ls-bwf__eyebrow">{% render 'lemme-pdp-icon', icon: 'sparkle-big' %}<span>{{ section.settings.eyebrow }}</span>{% render 'lemme-pdp-icon', icon: 'sparkle-big' %}</p>
        {%- endif -%}
        <h2 class="ls-bwf__heading ls-bwf__heading--mobile" id="LsBwf-{{ section.id }}">{{ section.settings.heading_mobile | default: section.settings.heading | newline_to_br }}</h2>
        <h2 class="ls-bwf__heading ls-bwf__heading--desktop">{{ heading_d | newline_to_br }}</h2>
        {%- if section.settings.text != blank -%}<div class="ls-bwf__copy">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="ls-bwf__features">
          {%- for block in section.blocks -%}
            <li class="ls-bwf__feature" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}{{ block.settings.icon | image_url: width: 128 | image_tag: alt: '', loading: 'lazy', width: 64, height: 64, class: 'ls-bwf__feature-icon' }}{%- endif -%}
              <p class="ls-bwf__feature-text">{{ block.settings.text }}</p>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="ls-btn ls-btn--dark ls-bwf__cta" href="{{ section.settings.button_url | default: '#' }}"><span>{{ section.settings.button_label }}</span></a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lemme subscribe banner",
  "class": "ls-bwf-section",
  "max_blocks": 6,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "Shown on the left half, anchored bottom left." },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)", "info": "Shown at the bottom of the card." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "subscribe & save" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "save up to 20% on your favorites" },
    { "type": "textarea", "id": "heading_mobile", "label": "Heading (mobile)", "info": "Optional. Each line is a new line on phones.", "default": "save up to\n20% on your\nfavorites" },
    { "type": "textarea", "id": "heading_desktop", "label": "Heading on desktop (optional line breaks)" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "subscribe now" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Card colour", "default": "#dfc8e7" }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [
      { "type": "image_picker", "id": "icon", "label": "Icon" },
      { "type": "text", "id": "text", "label": "Text", "default": "VIP access to exclusive drops" }
    ] }
  ],
  "presets": [ { "name": "Lemme subscribe banner", "blocks": [ { "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" } ] } ]
}
{% endschema %}
