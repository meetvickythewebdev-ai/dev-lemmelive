{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign m = product.metafields.lemme
  if section.settings.rows != blank
    assign rows = section.settings.rows | newline_to_br | replace: '</li>', '%%' | replace: '</p>', '%%' | replace: '<br />', '%%' | replace: '<br>', '%%' | replace: '<br/>', '%%' | strip_html | split: '%%'
  else
    assign rows = m.compare_rows.value
  endif
  assign brand_image = section.settings.lemme_image | default: m.compare_image.value | default: product.featured_media.preview_image
  assign heading = section.settings.heading_text | default: m.compare_heading.value | default: section.settings.heading
-%}
{%- if rows.size > 0 -%}
<section class="lm-section lp-compare" id="compare" data-lp-nav="{{ section.settings.nav_label | escape }}" aria-labelledby="LpCompare-{{ section.id }}">
  <div class="lp-compare__inner">
    <div class="lp-compare__card">
      <div class="lp-compare__intro">
        <h2 class="lp-h2" id="LpCompare-{{ section.id }}">{{ heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lp-compare__copy">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      <span class="lp-compare__fill" aria-hidden="true"></span>
      <div class="lp-compare__brand lp-compare__brand--lemme">
        <div class="lp-compare__brand-inner">
          {%- if brand_image != blank -%}<div class="lp-compare__brand-image">{{ brand_image | image_url: width: 500 | image_tag: alt: '', loading: 'lazy', width: 200, height: 200 }}</div>{%- endif -%}
          <span class="lp-compare__wordmark">{% render 'lemme-icon', icon: 'logo' %}<span class="lm-visually-hidden">Lemme</span></span>
        </div>
      </div>
      <div class="lp-compare__brand lp-compare__brand--other">
        <div class="lp-compare__brand-inner">
          {%- if section.settings.other_image != blank -%}<div class="lp-compare__brand-image">{{ section.settings.other_image | image_url: width: 500 | image_tag: alt: '', loading: 'lazy', width: 200, height: 200 }}</div>{%- endif -%}
          <span class="lp-compare__brand-label">{{ section.settings.other_label }}</span>
        </div>
      </div>
      <table class="lp-compare__table">
        <caption class="lm-visually-hidden">{{ heading }}</caption>
        <colgroup><col class="lp-compare__col-feature"><col class="lp-compare__col-brand"><col class="lp-compare__col-brand"></colgroup>
        <thead class="lm-visually-hidden"><tr><th scope="col">Feature</th><th scope="col">Lemme</th><th scope="col">{{ section.settings.other_label }}</th></tr></thead>
        <tbody>
          {%- for row in rows -%}
            {%- assign row = row | strip -%}
            {%- if row == blank -%}{%- continue -%}{%- endif -%}
            <tr>
              <th scope="row" class="lp-compare__label">{{ row }}</th>
              <td class="lp-compare__cell lp-compare__cell--lemme"><span class="lp-compare__value"><span class="lp-compare__icon lp-compare__icon--check">{% render 'lemme-pdp-icon', icon: 'check' %}</span><span class="lm-visually-hidden">Yes</span></span></td>
              <td class="lp-compare__cell"><span class="lp-compare__value"><span class="lp-compare__icon">{% render 'lemme-pdp-icon', icon: 'question' %}</span><span class="lp-compare__caption">{{ section.settings.other_value }}</span></span></td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      {%- if section.settings.disclaimer != blank -%}<p class="lp-compare__disclaimer">{{ section.settings.disclaimer }}</p>{%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Lemme compare",
  "class": "lp-compare-section",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Link label", "default": "Compare" },
    { "type": "text", "id": "heading_text", "label": "Heading" },
    { "type": "richtext", "id": "rows", "label": "Rows", "info": "One per line or bullet." },
    { "type": "image_picker", "id": "lemme_image", "label": "Lemme bottle image" },
    { "type": "text", "id": "heading", "label": "Fallback heading", "info": "Products can set their own with lemme.compare_heading.", "default": "how Lemme stacks up" },
    { "type": "text", "id": "text", "label": "Text", "default": "Because not all vitamins are created equal" },
    { "type": "image_picker", "id": "other_image", "label": "Other brands image" },
    { "type": "text", "id": "other_label", "label": "Other brands label", "default": "Other Brands" },
    { "type": "text", "id": "other_value", "label": "Other brands value", "default": "Varies" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Based on publicly available product information." },
    { "type": "paragraph", "content": "Rows come from lemme.compare_rows. The Lemme image is lemme.compare_image (or the product's main image). Hidden when there are no rows." }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
