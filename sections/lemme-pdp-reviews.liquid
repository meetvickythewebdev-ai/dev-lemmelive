{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-pdp.css' | asset_url | stylesheet_tag }}
{{ 'lemme-reviews.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
<section class="lm-section lp-reviews" id="reviews" data-lp-nav="{{ section.settings.nav_label | escape }}">
  <div class="lp-reviews__container">
    <div class="lp-reviews__col">
      {%- if section.settings.heading != blank -%}
        <div class="lp-reviews__heading"><h2 class="lp-reviews__title">{{ section.settings.heading }}</h2></div>
      {%- endif -%}
      <div class="lp-reviews__widget">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- if section.settings.short_count -%}
    <script>
      (function () {
        /* Okendo prints "Based on 30 reviews"; the live site shows "30 reviews". */
        var root = document.getElementById('reviews');
        if (!root || !window.MutationObserver) return;
        function trim() {
          root.querySelectorAll('.oke-w-ratingAverageModule-count').forEach(function (el) {
            var t = el.textContent;
            var m = t.match(/^\s*based on\s+(.+?)\s*$/i);
            if (m) el.textContent = m[1];
          });
        }
        new MutationObserver(trim).observe(root, { childList: true, subtree: true });
        trim();
      })();
    </script>
  {%- endif -%}
</section>
{%- elsif request.design_mode -%}
<section class="lm-section lp-reviews" id="reviews">
  <div class="lp-reviews__container">
    <div class="lp-reviews__col">
      <div class="lp-reviews__heading"><h2 class="lp-reviews__title">{{ section.settings.heading }}</h2></div>
      <p class="lp-reviews__empty">Add the Okendo "Reviews Widget" app block to this section (shown only in the theme editor).</p>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Lemme reviews",
  "class": "lp-reviews-section",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Link label", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "believe the hype" },
    { "type": "checkbox", "id": "short_count", "label": "Show \"30 reviews\" instead of \"Based on 30 reviews\"", "default": true },
    { "type": "paragraph", "content": "Add Okendo's \"Reviews Widget\" app block here. The styling that matches lemmelive.com is in assets/lemme-reviews.css." }
  ],
  "blocks": [ { "type": "@app" } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
