{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lemme-pdp.js' | asset_url }}" defer></script>

{%- assign faqs = product.metafields.lemme.faqs.value -%}
{%- if faqs.size > 0 -%}
<section class="lm-section lp-faq" id="faq" data-lp-nav="{{ section.settings.nav_label | escape }}" style="--lp-faq-top: {{ section.settings.padding_top }}px;" aria-labelledby="LpFaq-{{ section.id }}">
  <div class="lp-faq__layout">
    <div class="lp-faq__copy">
      <h2 class="lp-h2 lp-faq__heading" id="LpFaq-{{ section.id }}">{{ section.settings.heading | newline_to_br }}</h2>
      {%- if section.settings.button_label != blank -%}
        <div class="lp-faq__cta"><a class="lp-pill-btn" href="{{ section.settings.button_url | default: '/pages/faq' }}"><span>{{ section.settings.button_label }}</span></a></div>
      {%- endif -%}
    </div>
    <div class="lp-faq__list">
      {%- for faq in faqs -%}
        <details class="lp-acc" data-lp-accordion{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="lp-acc__summary"><span class="lp-acc__title">{{ faq.question.value }}</span><span class="lp-acc__icons">{% render 'lemme-pdp-icon', icon: 'plus-big', class: 'lp-when-closed' %}{% render 'lemme-pdp-icon', icon: 'minus-big', class: 'lp-when-open' %}</span></summary>
          <div class="lp-acc__content" data-lp-accordion-content>{{ faq.answer.value | newline_to_br }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Lemme product FAQs",
  "class": "lp-faq-section",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Link label", "default": "FAQ" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "your questions,\nanswered" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read all FAQs" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "range", "id": "padding_top", "label": "Space above (desktop)", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 0 },
    { "type": "paragraph", "content": "Questions come from the product's \"lemme.faqs\" metafield (a list of FAQ entries). Hidden when a product has none." }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
