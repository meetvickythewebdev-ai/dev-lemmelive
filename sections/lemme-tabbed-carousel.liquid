{{ 'lemme-home.css' | asset_url | stylesheet_tag }}
{{ 'lemme-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lemme-sections.js' | asset_url }}" defer></script>

<section class="lm-section ls-tabs" aria-label="{{ section.settings.label | escape }}" data-ls-tabs>
  <div class="ls-tabs__pills" role="tablist" aria-label="{{ section.settings.label | escape }}">
    {%- for block in section.blocks -%}
      <button class="ls-tabs__pill{% if forloop.first %} is-active{% endif %}" type="button" role="tab" id="LsTab-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="LsPanel-{{ block.id }}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-ls-tab {{ block.shopify_attributes }}>{{ block.settings.pill }}</button>
    {%- endfor -%}
  </div>
  {%- for block in section.blocks -%}
    <div class="ls-tabs__panel" role="tabpanel" id="LsPanel-{{ block.id }}" aria-labelledby="LsTab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %} data-ls-panel>
      <div class="ls-tabs__copy">
        <h2 class="ls-tabs__heading">{{ block.settings.heading }}</h2>
        {%- if block.settings.text != blank -%}<div class="ls-tabs__text">{{ block.settings.text }}</div>{%- endif -%}
      </div>
      <div class="ls-tabs__media" data-ls-carousel>
        <ul class="ls-tabs__track" data-ls-track>
          {%- for i in (1..3) -%}
            {%- liquid
              assign img_key = 'image_' | append: i
              assign title_key = 'title_' | append: i
              assign text_key = 'text_' | append: i
              assign img = block.settings[img_key]
              assign title = block.settings[title_key]
              assign txt = block.settings[text_key]
            -%}
            {%- if img != blank or title != blank -%}
              <li class="ls-tabs__slide" data-ls-slide>
                <div class="ls-tabs__frame">
                  {%- if img != blank -%}{{ img | image_url: width: 1400 | image_tag: loading: 'lazy', alt: '', class: 'ls-tabs__image', sizes: '(min-width: 1024px) 65vw, 100vw', widths: '400, 700, 1000, 1400' }}{%- endif -%}
                </div>
                <div class="ls-tabs__card">
                  {%- if title != blank -%}<p class="ls-tabs__card-title">{{ title }}</p>{%- endif -%}
                  {%- if txt != blank -%}<p class="ls-tabs__card-text">{{ txt }}</p>{%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <button class="ls-tabs__arrow ls-tabs__arrow--prev" type="button" aria-label="Previous slide" data-ls-prev>{% render 'lemme-pdp-icon', icon: 'arrow-left' %}</button>
        <button class="ls-tabs__arrow ls-tabs__arrow--next" type="button" aria-label="Next slide" data-ls-next>{% render 'lemme-pdp-icon', icon: 'arrow-right' %}</button>
        <div class="ls-tabs__thumbs">
          {%- for i in (1..3) -%}
            {%- assign img_key = 'image_' | append: i -%}
            {%- assign img = block.settings[img_key] -%}
            {%- if img != blank -%}
              <button class="ls-tabs__thumb{% if forloop.first %} is-active{% endif %}" type="button" aria-label="Show slide {{ i }}" data-ls-thumb="{{ forloop.index0 }}">{{ img | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', width: 64, height: 64 }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="ls-dots" data-ls-dots aria-hidden="true"></div>
      </div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Lemme tabbed carousel",
  "class": "ls-tabs-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "label", "label": "Label (screen readers)", "default": "Why Lemme" }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "text", "id": "pill", "label": "Tab label", "default": "Formulas" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "real science. real results.*" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "header", "content": "Slide 1" },
      { "type": "image_picker", "id": "image_1", "label": "Image" },
      { "type": "text", "id": "title_1", "label": "Card title" },
      { "type": "textarea", "id": "text_1", "label": "Card text" },
      { "type": "header", "content": "Slide 2" },
      { "type": "image_picker", "id": "image_2", "label": "Image" },
      { "type": "text", "id": "title_2", "label": "Card title" },
      { "type": "textarea", "id": "text_2", "label": "Card text" },
      { "type": "header", "content": "Slide 3" },
      { "type": "image_picker", "id": "image_3", "label": "Image" },
      { "type": "text", "id": "title_3", "label": "Card title" },
      { "type": "textarea", "id": "text_3", "label": "Card text" }
    ] }
  ],
  "presets": [ { "name": "Lemme tabbed carousel", "blocks": [ { "type": "tab" } ] } ]
}
{% endschema %}
