{
  "sections": {
    "main": {
      "type": "lemme-pdp-main",
      "blocks": {
        "tab_benefits": {
          "type": "tab_benefits",
          "settings": {
            "title": "Product benefits",
            "intro": "<p>{{ product.metafields.lemme.benefits_intro.value }}</p>",
            "bullets": "<p>{{ product.metafields.lemme.benefit_bullets.value }}</p>"
          }
        },
        "tab_leave_out": {
          "type": "tab_leave_out",
          "settings": {
            "title": "What We Leave Out",
            "items": "{{ product.metafields.lemme.leave_out.value }}"
          }
        },
        "tab_supplement": {
          "type": "tab_supplement",
          "settings": {
            "title": "Supplement Facts",
            "suggested_use": "{{ product.metafields.lemme.suggested_use.value }}",
            "serving": "<p>{{ product.metafields.lemme.serving_lines.value }}</p>",
            "footnote": "<p>{{ product.metafields.lemme.supplement_footnote.value }}</p>",
            "other": "<p>{{ product.metafields.lemme.other_ingredients.value }}</p>",
            "warning": "<p>{{ product.metafields.lemme.warning.value }}</p>",
            "rows": "<p>{{ product.metafields.lemme.supplement_facts.value }}</p>"
          }
        },
        "tab_faqs": {
          "type": "tab_faqs",
          "settings": {
            "title": "FAQs",
            "faqs": "{{ product.metafields.lemme.faqs.value }}"
          }
        },
        "tab_awards": {
          "type": "tab_awards",
          "settings": {
            "title": "Awards",
            "awards": "{{ product.metafields.lemme.awards.value }}"
          }
        },
        "gift": {
          "type": "gift",
          "settings": {}
        }
      },
      "block_order": [
        "tab_benefits",
        "tab_leave_out",
        "tab_supplement",
        "tab_faqs",
        "tab_awards",
        "gift"
      ],
      "settings": {
        "title": "{{ product.metafields.lemme.display_title.value }}",
        "subtitle": "{{ product.metafields.lemme.subtitle.value }}",
        "description": "<p>{{ product.metafields.lemme.intro.value }}</p>",
        "badge": "{{ product.metafields.lemme.badge.value }}",
        "frontrow_id": "{{ product.metafields.lemme.frontrow_id.value }}",
        "gallery_badge": "{{ product.metafields.lemme.card_badge.value }}",
        "format_products": "{{ product.metafields.lemme.format_products.value }}",
        "format_name": "{{ product.metafields.lemme.format_name.value }}",
        "flavor": "{{ product.metafields.lemme.flavor.value }}",
        "option_labels": "<p>{{ product.metafields.lemme.option_names.value }}</p>",
        "option_descriptions": "<p>{{ product.metafields.lemme.option_details.value }}</p>",
        "icon_items": "{{ product.metafields.lemme.benefit_icon_items.value }}",
        "routine_products": "{{ product.metafields.lemme.routine_products.value }}",
        "sticky_image": "{{ product.metafields.lemme.sticky_image.value }}"
      }
    },
    "subnav": {
      "type": "lemme-pdp-subnav",
      "settings": {}
    },
    "benefits": {
      "type": "lemme-pdp-benefits",
      "settings": {
        "eyebrow": "{{ product.metafields.lemme.benefits_eyebrow.value }}",
        "heading_text": "{{ product.metafields.lemme.benefits_heading.value }}",
        "items": "{{ product.metafields.lemme.benefit_items.value }}",
        "video": "{{ product.metafields.lemme.benefits_video.value }}"
      }
    },
    "data": {
      "type": "lemme-pdp-data",
      "settings": {
        "heading": "{{ product.metafields.lemme.data_heading.value }}",
        "text": "<p>{{ product.metafields.lemme.data_text.value }}</p>"
      }
    },
    "compare": {
      "type": "lemme-pdp-compare",
      "settings": {
        "other_image": "shopify://shop_images/Generic_Bottle.jpg",
        "heading_text": "{{ product.metafields.lemme.compare_heading.value }}",
        "rows": "<p>{{ product.metafields.lemme.compare_list.value }}</p>",
        "lemme_image": "{{ product.metafields.lemme.compare_image.value }}"
      }
    },
    "ingredients": {
      "type": "lemme-pdp-ingredients",
      "settings": {
        "items": "{{ product.metafields.lemme.ingredients.value }}"
      }
    },
    "difference": {
      "type": "lemme-pdp-difference",
      "blocks": {
        "icon_1": {
          "type": "icon",
          "settings": {
            "label": "Vegetarian",
            "bundled_image": "lemme-diff-vegetarian.png"
          }
        },
        "icon_2": {
          "type": "icon",
          "settings": {
            "label": "Gluten-free",
            "bundled_image": "lemme-diff-gluten-free.png"
          }
        },
        "icon_3": {
          "type": "icon",
          "settings": {
            "label": "Gelatin-free",
            "bundled_image": "lemme-diff-gelatin-free.png"
          }
        },
        "icon_4": {
          "type": "icon",
          "settings": {
            "label": "No synthetic dyes or flavors",
            "bundled_image": "lemme-diff-no-dyes.png"
          }
        },
        "icon_5": {
          "type": "icon",
          "settings": {
            "label": "No sugar alcohols",
            "bundled_image": "lemme-diff-no-sugar-alcohols.png"
          }
        },
        "icon_6": {
          "type": "icon",
          "settings": {
            "label": "Clinically-studied ingredients",
            "bundled_image": "lemme-diff-clinically-studied.png"
          }
        }
      },
      "block_order": [
        "icon_1",
        "icon_2",
        "icon_3",
        "icon_4",
        "icon_5",
        "icon_6"
      ],
      "settings": {
        "nav_label": "Difference",
        "body": "<p>{{ product.metafields.lemme.difference_text.value }}</p>",
        "product_image": "{{ product.metafields.lemme.difference_image.value }}",
        "items": "{{ product.metafields.lemme.difference_items.value }}"
      }
    },
    "expert": {
      "type": "lemme-pdp-expert",
      "settings": {
        "expert": "{{ product.metafields.lemme.expert.value }}",
        "quote": "<p>{{ product.metafields.lemme.expert_quote.value }}</p>"
      }
    },
    "related": {
      "type": "lemme-pdp-related",
      "settings": {
        "collection": "most-loved-formulas"
      }
    },
    "reviews": {
      "type": "lemme-pdp-reviews",
      "settings": {}
    },
    "faq": {
      "type": "lemme-pdp-faq",
      "settings": {
        "button_url": "/pages/faq",
        "faqs": "{{ product.metafields.lemme.faqs.value }}"
      }
    }
  },
  "order": [
    "main",
    "subnav",
    "benefits",
    "data",
    "compare",
    "ingredients",
    "difference",
    "expert",
    "related",
    "reviews",
    "faq"
  ]
}
