.lm-ft__field { display: flex; align-items: stretch; width: 100%; overflow: hidden; border: 2px solid #000; border-radius: 48px; background: #fff; }
.lm-ft__input { flex-grow: 1; min-width: 0; height: 48px; margin: 0; padding: 12px 20px; border: 0; border-radius: 0; background: transparent; color: #000; font-family: var(--lm-font-body); font-size: 16px; line-height: 1.2; }
.lm-ft__input::placeholder { color: #000; opacity: 1; }
.lm-ft__input:focus { outline: none; }
.lm-ft__field:focus-within { outline: 2px solid #000; outline-offset: 2px; }
.lm-ft__submit { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 56px; margin: 0; padding: 0; border: 0; border-left: 2px solid #000; background: none; color: #000; cursor: pointer; transition: background-color .15s, color .15s; }
.lm-ft__submit .lp-icon { width: 20px; height: 20px; }
@media (hover: hover) { .lm-ft__submit:hover { background: #000; color: #fff; } }
.lm-ft__msg { margin: 8px 0 0; font-size: 14px; line-height: 1.2; }
.lm-ft__msg--error { color: #b3261e; }
.lm-ft__sms { grid-area: sms; justify-self: start; font-size: 16px; font-weight: 700; line-height: 1.5; text-decoration: underline !important; text-decoration-thickness: .1em !important; text-underline-offset: 14%; }
.lm-ft__disclaimer { grid-area: disclaimer; max-width: 520px; font-size: 12px; line-height: 1.3; }
.lm-ft__disclaimer p { margin: 0; }
.lm-ft__disclaimer a, .lm-ft__disclaimer a span { text-decoration: underline; text-underline-offset: .12em; }
.lm-ft__columns { display: flex; flex-direction: column; margin-inline: -20px; border-top: 2px solid #000; }
.lm-ft__column, .lm-ft__aside { min-width: 0; padding-inline: 20px; }
.lm-ft__column { border-bottom: 2px solid #000; }
.lm-ft__column-heading { margin: 0; }
.lm-ft__trigger { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; margin: 0; padding: 20px 0; border: 0; background: none; color: inherit; cursor: pointer; text-align: left; font: inherit; }
.lm-ft__column-title { font-family: var(--lm-font-display); font-size: 28px; font-weight: 700; line-height: 1.1; text-transform: uppercase; }
.lm-ft__column-icon { display: flex; flex-shrink: 0; width: 20px; height: 20px; }
.lm-ft__column-icon .lp-icon { width: 100%; height: 100%; }
.lm-ft__icon-close, .lm-ft__trigger[aria-expanded="true"] .lm-ft__icon-open { display: none; }
.lm-ft__trigger[aria-expanded="true"] .lm-ft__icon-close { display: block; }
.lm-ft__panel { display: grid; grid-template-rows: 0fr; visibility: hidden; transition: grid-template-rows .3s, visibility .3s; }
.lm-ft__trigger[aria-expanded="true"] ~ .lm-ft__panel, .lm-ft__column-heading:has([aria-expanded="true"]) + .lm-ft__panel { grid-template-rows: 1fr; visibility: visible; }
.lm-ft__panel-inner { overflow: hidden; }
.lm-ft__nav { padding-bottom: 20px; }
.lm-ft__menu li, .lm-ft__social li { margin-bottom: 5px; }
.lm-ft__menu { display: flex; flex-direction: column; gap: 16px; font-size: 16px; font-weight: 700; line-height: 1.2; text-transform: uppercase; }
@media (hover: hover) { .lm-ft__menu-item:hover { text-decoration: underline; text-underline-offset: 4px; } }
.lm-ft__aside { display: flex; flex-direction: column; gap: 32px; padding-top: 32px; }
.lm-ft__social { display: flex; align-items: center; gap: 20px; line-height: 0; }
.lm-ft__social a { display: flex; align-items: center; justify-content: center; width: 20px; height: 20px; color: var(--lm-ink); }
.lm-ft__social svg { width: 100%; height: 100%; }
.lm-ft__fda { padding: 18px; border: 2px solid #000; border-radius: 16px; font-size: 12px; font-weight: 700; line-height: 1.3; }
.lm-ft__fda p { margin: 0; }
.lm-ft__bottom { display: flex; flex-direction: column; gap: 12px; padding-block: 24px 32px; }
.lm-ft__copyright { order: 2; margin: 0; font-size: 12px; line-height: 1.2; }
.lm-ft__copyright small { font-size: inherit; }
.lm-ft__legal-nav { order: 1; max-width: 100%; }
.lm-ft__legal { display: flex; flex-wrap: wrap; gap: 12px 16px; }
.lm-ft__legal li { flex-shrink: 0; line-height: 12px; }
.lm-ft__legal-item { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; font-size: 12px; line-height: 12px; text-decoration: underline !important; text-underline-offset: .12em; }
.lm-ft__legal-item svg { flex-shrink: 0; width: 30px; height: 14px; }
@media (min-width: 1024px) {
  .lm-ft__inner { padding-inline: 40px; }
  .lm-ft__signup { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); grid-template-areas: "copy form"; align-items: start; column-gap: 40px; padding-block: 40px; }
  .lm-ft__form-col { grid-area: form; display: flex; flex-direction: column; align-items: stretch; justify-self: start; gap: 12px; width: 100%; min-width: 0; max-width: 824px; }
  .lm-ft__copy { grid-area: copy; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .lm-ft__heading { font-size: 40px; font-weight: 400; line-height: 1; }
  .lm-ft__sms { align-self: flex-end; text-align: right; }
  .lm-ft__columns { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-inline: -40px; border-bottom: 2px solid #000; }
  .lm-ft__column, .lm-ft__aside { display: flex; flex-direction: column; padding: 40px; border-left: 2px solid #000; }
  .lm-ft__column:first-child { border-left: 0; }
  .lm-ft__column { border-bottom: 0; }
  .lm-ft__aside { justify-content: space-between; gap: 40px; }
  .lm-ft__trigger { display: block; padding: 0; pointer-events: none; cursor: default; }
  .lm-ft__column-title { font-size: 40px; line-height: 1; }
  .lm-ft__column-icon { display: none; }
  .lm-ft__panel { display: block; visibility: visible; }
  .lm-ft__nav { padding: 24px 0 0; }
  .lm-ft__social a { width: 24px; height: 24px; }
  .lm-ft__bottom { flex-direction: row; justify-content: space-between; align-items: center; gap: 24px; padding-block: 24px; }
  .lm-ft__copyright { order: initial; }
  .lm-ft__legal-nav { order: initial; flex: 1 1 auto; min-width: 0; }
  .lm-ft__legal { justify-content: flex-end; }
}

