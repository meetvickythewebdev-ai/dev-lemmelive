/* ==========================================================================
   Lemme homepage — sections, components and motion
   Rebuilt from the lemmelive.com homepage (desktop 1440 / mobile 375).
   Breakpoints: mobile < 750px, tablet 750–1024px, desktop >= 1025px.
   ========================================================================== */

/* ---------- Fonts ----------
   The live site uses the licensed fonts "Mier A" (Regular/Bold) and "Recoleta" (Medium).
   Upload MierA-Regular.woff2, MierA-Bold.woff2 and Recoleta-Medium.woff2 to the theme's
   assets folder (see the setup guide). Until then the stacks below fall back to similar fonts. */
@font-face { font-family: "Mier A"; src: url("{{ 'MierA-Regular.woff2' | asset_url }}") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
@font-face { font-family: "Mier A"; src: url("{{ 'MierA-Bold.woff2' | asset_url }}") format("woff2"); font-weight: 700; font-style: normal; font-display: swap; }
@font-face { font-family: "Recoleta"; src: url("{{ 'Recoleta-Medium.woff2' | asset_url }}") format("woff2"); font-weight: 500; font-style: normal; font-display: swap; }

:root {
  --lm-lilac: #dfc8e7;
  --lm-lilac-light: #f7f1f9;
  --lm-lilac-mid: #f5f0f9;
  --lm-lime: #c5ff89;
  --lm-black: #000;
  --lm-white: #fff;
  --lm-ink: #232323;
  --lm-font-body: "Mier A", "DM Sans", "Helvetica Neue", helvetica, arial, sans-serif;
  --lm-font-display: "Recoleta", "Fraunces", Georgia, "Times New Roman", serif;
  --lm-ease-bounce: cubic-bezier(.5, -.5, .25, 1.4);
  --lm-ease-out: cubic-bezier(.215, .61, .355, 1);
  --lm-gutter: 20px;
  --lm-header-h: 80px;
  --lm-promo-h: 32px;
}
@media (min-width: 750px) { :root { --lm-gutter: 40px; } }
@media (min-width: 1025px) { :root { --lm-gutter: 60px; } }

/* The live site uses lilac as the page background everywhere. */
body:has(.lm-header), body:has(.lm-header) .page-wrapper { background-color: var(--lm-lilac); }

.lm-section, .lm-header, .lm-footer, .lm-drawer, .lm-mega {
  font-family: var(--lm-font-body);
  font-size: 16px;
  line-height: 1.6;
  color: var(--lm-black);
  -webkit-font-smoothing: antialiased;
}
:where(.lm-section, .lm-header, .lm-footer, .lm-drawer, .lm-mega) *,
:where(.lm-section, .lm-header, .lm-footer, .lm-drawer, .lm-mega) *::before,
:where(.lm-section, .lm-header, .lm-footer, .lm-drawer, .lm-mega) *::after { box-sizing: border-box; }
:where(.lm-section, .lm-header, .lm-footer, .lm-drawer, .lm-mega) img { max-width: 100%; display: block; }
:where(.lm-section, .lm-header, .lm-footer, .lm-drawer, .lm-mega) a { color: inherit; text-decoration: none; }
:where(.lm-section, .lm-footer, .lm-mega, .lm-drawer) :is(h1, h2, h3, p) { margin: 0; letter-spacing: normal; font-family: inherit; font-size: inherit; font-weight: inherit; font-style: normal; line-height: inherit; text-transform: none; color: inherit; }
:where(.lm-section, .lm-footer, .lm-mega, .lm-drawer, .lm-header) ul { list-style: none; margin: 0; padding: 0; }
.lm-section { background: var(--lm-lilac); position: relative; }
.lm-container { width: 100%; padding-left: var(--lm-gutter); padding-right: var(--lm-gutter); margin: 0 auto; }
.lm-visually-hidden { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.lm-display { font-family: var(--lm-font-display); font-weight: 500; line-height: 1; }
.lm-hide-mobile { display: none !important; }
@media (min-width: 750px) { .lm-hide-mobile { display: revert !important; } .lm-hide-desktop { display: none !important; } }
.lm-icon { display: block; flex-shrink: 0; }

/* ---------- Buttons (pill + black "filler" that slides up on hover) ---------- */
.lm-btn {
  --lm-btn-bg: var(--lm-white);
  --lm-btn-fg: var(--lm-black);
  --lm-btn-filler: var(--lm-black);
  --lm-btn-fg-hover: var(--lm-white);
  position: relative; display: inline-flex; align-items: center; justify-content: center;
  min-height: 46px; padding: 13px 48px; margin: 0;
  border: 0; border-radius: 48px; overflow: hidden; isolation: isolate;
  background: var(--lm-btn-bg); color: var(--lm-btn-fg);
  box-shadow: inset 0 0 0 2px var(--lm-black);
  font-family: var(--lm-font-body); font-weight: 700; font-size: 16px; line-height: 1; text-transform: uppercase; letter-spacing: 0;
  cursor: pointer; text-decoration: none; backface-visibility: hidden; will-change: transform;
  transition: color .2s ease-out, background-color .3s ease, box-shadow .3s ease;
  -webkit-tap-highlight-color: transparent;
}
.lm-btn--dark { --lm-btn-bg: var(--lm-black); --lm-btn-fg: var(--lm-white); --lm-btn-filler: var(--lm-white); --lm-btn-fg-hover: var(--lm-black); }
.lm-btn--lg { min-height: 70px; width: 345px; max-width: 100%; font-size: 20px; padding: 0 24px; box-shadow: none; }
.lm-btn--sm { min-height: 48.8px; padding: 0 36px; font-size: 16px; box-shadow: inset 0 0 0 1.6px var(--lm-black); }
.lm-btn--full { width: 100%; }
.lm-btn__filler {
  position: absolute; z-index: -1; top: -50%; left: -25%; width: 150%; height: 200%;
  border-radius: 50%; background: var(--lm-btn-filler); pointer-events: none;
  transform: translate3d(0, 75%, 0);
}
.lm-btn__text, .lm-btn__text-inner { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; pointer-events: none; }
.lm-btn .lm-btn__text { color: var(--lm-btn-fg); transition: color .2s ease-out; }
.lm-btn.is-hovered .lm-btn__text { color: var(--lm-btn-fg-hover); }
.lm-btn:focus-visible { outline: 3px solid var(--lm-black); outline-offset: 3px; }
@media (max-width: 749px) {
  .lm-btn--lg { width: 100%; max-width: 345px; min-height: 55px; box-shadow: inset 0 0 0 2px var(--lm-black); }
}
@media (hover: none), (max-width: 1024px) {
  .lm-btn__filler { display: none; }
  .lm-btn--dark:active { background: var(--lm-white); }
  .lm-btn--dark:active .lm-btn__text { color: var(--lm-black); }
  .lm-btn--light:active { background: var(--lm-black); }
  .lm-btn--light:active .lm-btn__text { color: var(--lm-white); }
}

/* ---------- Animated squiggle underline ---------- */
.lm-squiggle { position: relative; display: inline-block; }
.lm-squiggle__copy { position: relative; z-index: 1; }
.lm-squiggle__wrapper {
  position: absolute; left: 0; bottom: -10px; width: 100%; display: flex; align-items: center;
  overflow: hidden; color: var(--lm-squiggle-color, var(--lm-lime)); pointer-events: none;
}
.lm-squiggle__wrapper > span { display: block; flex-shrink: 0; will-change: transform; animation: lm-marquee 1s linear infinite reverse; }
.lm-squiggle__wrapper svg { width: auto; height: 3.2vw; margin-left: -1.1333vw; display: block; }
.lm-squiggle:hover .lm-squiggle__wrapper > span { animation-play-state: paused; }
@media (min-width: 750px) {
  .lm-squiggle__wrapper { bottom: -12px; }
  .lm-squiggle__wrapper svg { height: 1.6666vw; max-height: 24px; margin-left: -.5555vw; }
}
@media (min-width: 1025px) { .lm-squiggle__wrapper { bottom: -18px; } }

/* ---------- Marquee (shared by promo bar + ticker) ---------- */
@keyframes lm-marquee { 0% { transform: translateX(-100%); } 100% { transform: translateX(0); } }
.lm-marquee { position: relative; overflow: hidden; display: flex; user-select: none; }
.lm-marquee__track { display: flex; flex-wrap: nowrap; align-items: center; }
.lm-marquee__item {
  display: flex; align-items: center; flex-shrink: 0; white-space: nowrap;
  animation: lm-marquee var(--lm-marquee-speed, 16s) linear infinite;
  will-change: transform;
}
.lm-marquee:hover .lm-marquee__item, .lm-marquee.is-paused .lm-marquee__item { animation-play-state: paused; }
@media (prefers-reduced-motion: reduce) {
  .lm-marquee__item, .lm-squiggle__wrapper > span, .lm-sparkle { animation: none !important; }
}

/* ==========================================================================
   HEADER  (fixed black bar + lime promo bar)
   ========================================================================== */
.lm-header-spacer { height: calc(var(--lm-header-h) + var(--lm-promo-h) - 1px); }
.lm-header { position: fixed; z-index: 995; top: 0; left: 0; right: var(--lm-scrollbar-width, 0px); }
.lm-header__bar {
  position: relative; z-index: 3; height: var(--lm-header-h); background: var(--lm-black); color: var(--lm-white);
  display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 var(--lm-gutter);
}
.lm-header__left, .lm-header__right { display: flex; align-items: center; gap: 40px; }
.lm-header__right { justify-content: flex-end; }
.lm-header__logo { color: var(--lm-white); display: block; width: 118px; height: 24px; }
.lm-header__logo img { width: 118px; height: auto; }
.lm-header__link, .lm-header__toggle {
  background: none; border: 0; padding: 0; color: var(--lm-white); cursor: pointer;
  font-family: var(--lm-font-body); font-weight: 700; font-size: 16px; line-height: 1; text-transform: uppercase;
  display: inline-flex; align-items: center; gap: 4px; position: relative; height: var(--lm-header-h);
}
.lm-header__link::after, .lm-header__toggle::after {
  content: ""; position: absolute; left: 0; bottom: 30px; width: 100%; height: 2px; background: currentColor;
  transform: scaleX(0); transform-origin: left; transition: transform .25s ease-in;
}
.lm-header__link:hover::after, .lm-header__toggle:hover::after, .lm-header__toggle[aria-expanded="true"]::after { transform: scaleX(1); }
.lm-header__toggle .lm-icon--plus { transition: transform .3s var(--lm-ease-bounce); }
.lm-header__toggle[aria-expanded="true"] .lm-icon--plus { transform: rotate(45deg); }
.lm-header__cart { display: inline-flex; align-items: center; gap: 8px; }
.lm-header__count {
  display: inline-flex; align-items: center; justify-content: center; min-width: 24px; height: 24px; padding: 0 6px;
  border-radius: 12px; background: var(--lm-lime); color: var(--lm-black); font-size: 14px; font-weight: 700; line-height: 1;
}
.lm-header__icon-btn { background: none; border: 0; padding: 0; color: var(--lm-white); width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
.lm-header__mobile-only { display: none; }
@media (max-width: 1024px) {
  .lm-header__desktop-only { display: none !important; }
  .lm-header__mobile-only { display: inline-flex; }
  .lm-header__left { gap: 20px; }
  .lm-header__bar { grid-template-columns: 1fr auto 1fr; }
  .lm-header__menu-btn .lm-icon--close { display: none; }
  .lm-header__menu-btn[aria-expanded="true"] .lm-icon--close { display: block; }
  .lm-header__menu-btn[aria-expanded="true"] .lm-icon--menu { display: none; }
}
.lm-promo {
  position: relative; z-index: 2; height: var(--lm-promo-h); margin-top: -1px; background: var(--lm-lime); color: var(--lm-black);
  --lm-marquee-speed: 16s;
}
.lm-promo .lm-marquee { height: 100%; align-items: center; }
.lm-promo .lm-marquee__item { font-size: 14px; line-height: 16px; font-weight: 700; text-transform: uppercase; }
.lm-promo .lm-icon--star { width: 16px; height: 16px; margin: 0 17px; }
.lm-promo a { color: inherit; }

/* ---------- Mega menu (desktop) ---------- */
.lm-mega {
  position: fixed; z-index: 1; top: calc(var(--lm-header-h) + var(--lm-promo-h) - 1px); left: 0; right: var(--lm-scrollbar-width, 0px);
  max-height: calc(100vh - var(--lm-header-h) - var(--lm-promo-h)); overflow: auto;
  background: var(--lm-lilac-mid); border-bottom: 2px solid var(--lm-black);
  visibility: hidden; opacity: 0; transform: translateY(-24px);
  transition: opacity .3s ease, transform .45s var(--lm-ease-bounce), visibility 0s linear .45s;
}
.lm-mega.is-open { visibility: visible; opacity: 1; transform: none; transition: opacity .3s ease, transform .45s var(--lm-ease-bounce), visibility 0s; }
.lm-mega__inner { display: grid; grid-template-columns: 1.1fr 1fr .9fr .9fr; gap: 40px; padding: 32px var(--lm-gutter) 40px; }
.lm-mega__title { font-weight: 700; font-size: 20px; line-height: 24px; text-transform: uppercase; margin-bottom: 20px; }
.lm-mega__col-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
.lm-mega__col-head .lm-mega__title { margin: 0; }
.lm-mega__col-head .lm-btn { min-height: 40px; padding: 0 32px; font-size: 14px; }
.lm-mega__circles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; }
.lm-mega__circle { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
.lm-mega__circle-img { width: 112px; height: 112px; border-radius: 50%; background: #e7d6ee; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.lm-mega__circle-img img { width: 100%; height: 100%; object-fit: contain; transition: transform .35s var(--lm-ease-bounce); }
.lm-mega__circle:hover .lm-mega__circle-img img { transform: translateY(-6px) scale(1.04); }
.lm-mega__circle-text { font-family: var(--lm-font-display); font-weight: 500; font-size: 24px; line-height: 1.1; }
.lm-mega__pills { display: grid; gap: 12px; }
.lm-mega__pill { position: relative; display: flex; align-items: center; gap: 16px; height: 56px; padding: 0 20px 0 100px; border-radius: 40px; background: #e7d6ee; font-family: var(--lm-font-display); font-weight: 500; font-size: 18px; line-height: 1.2; transition: background-color .25s ease-in; }
.lm-mega__pill:hover { background: var(--lm-lilac); }
.lm-mega__pill img { position: absolute; left: 8px; bottom: 0; width: 72px; height: 80px; object-fit: contain; object-position: center bottom; transform: scale(1.35); transform-origin: center bottom; transition: bottom .35s var(--lm-ease-bounce); }
.lm-mega__pill:hover img { bottom: 10px; }
.lm-mega__benefits { display: grid; gap: 14px; margin-bottom: 20px; }
.lm-mega__benefit { display: flex; align-items: center; gap: 10px; font-family: var(--lm-font-display); font-weight: 500; font-size: 18px; text-transform: uppercase; }
.lm-mega__benefit img { width: 24px; height: 24px; }
.lm-mega__benefit:hover span { text-decoration: underline; text-underline-offset: 4px; }
.lm-mega__subscribe { border: 1.6px solid var(--lm-black); border-radius: 12px; background: var(--lm-lilac); padding: 10px 14px; font-size: 13px; line-height: 1.4; margin-bottom: 24px; }
.lm-mega__subscribe strong { display: block; font-family: var(--lm-font-display); font-weight: 500; font-size: 16px; margin-bottom: 4px; }
.lm-mega__subscribe ul li::before { content: "\2713"; margin-right: 6px; }
.lm-mega__featured { display: grid; grid-template-columns: 1fr; gap: 16px; max-width: 280px; }
.lm-mega__feature { position: relative; display: block; border: 1.6px solid var(--lm-black); border-radius: 32px; overflow: hidden; aspect-ratio: 1 / 1; }
.lm-mega__feature img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--lm-ease-out); }
.lm-mega__feature:hover img { transform: scale(1.05); }
.lm-mega__feature .lm-btn { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); width: calc(100% - 28px); min-height: 40px; padding: 0 12px; font-size: 13px; }
.lm-mega__shipping { display: flex; align-items: center; gap: 8px; margin-top: 20px; font-size: 14px; font-weight: 700; text-transform: uppercase; }
@media (max-width: 1024px) { .lm-mega { display: none; } }

/* ---------- Mobile drawer ---------- */
.lm-drawer {
  position: fixed; z-index: 2; top: calc(var(--lm-header-h) + var(--lm-promo-h) - 1px); left: 0; bottom: 0; width: 100%;
  background: var(--lm-lilac-mid); overflow-y: auto; -webkit-overflow-scrolling: touch;
  transform: translateX(-100%); visibility: hidden;
  transition: transform .45s var(--lm-ease-out), visibility 0s linear .45s;
}
.lm-drawer.is-open { transform: none; visibility: visible; transition: transform .45s var(--lm-ease-out), visibility 0s; }
.lm-drawer__inner { padding: 24px var(--lm-gutter) 40px; }
.lm-drawer__title { font-family: var(--lm-font-display); font-weight: 500; font-size: 18px; line-height: 24px; text-transform: uppercase; margin-bottom: 24px; }
.lm-drawer .lm-mega__circles { gap: 32px 16px; margin-bottom: 32px; }
.lm-drawer .lm-mega__circle-img { width: 128px; height: 128px; }
.lm-drawer .lm-mega__circle-text { font-size: 18px; text-transform: uppercase; }
.lm-accordion { border-top: 0; }
.lm-accordion__btn {
  width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px;
  background: none; border: 0; padding: 12px 0; cursor: pointer; color: var(--lm-black);
  font-family: var(--lm-font-display); font-weight: 500; font-size: 18px; line-height: 24px; text-transform: uppercase; text-align: left;
}
.lm-accordion__icon { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: var(--lm-black); color: var(--lm-white); transition: transform .3s var(--lm-ease-bounce); }
.lm-accordion__btn[aria-expanded="true"] .lm-accordion__icon { transform: rotate(45deg); }
.lm-accordion__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s var(--lm-ease-out); }
.lm-accordion__panel > div { overflow: hidden; }
.lm-accordion__btn[aria-expanded="true"] + .lm-accordion__panel { grid-template-rows: 1fr; }
.lm-accordion__panel .lm-mega__pills, .lm-accordion__panel .lm-mega__benefits { padding: 8px 0 16px; }
.lm-drawer__cta { margin-top: 24px; }
.lm-drawer__shipping { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 20px; font-size: 14px; text-transform: uppercase; }
@media (min-width: 1025px) { .lm-drawer { display: none; } }
body.lm-no-scroll { overflow: hidden; }

/* ==========================================================================
   QUICK LINKS (mobile category row)
   ========================================================================== */
.lm-quicklinks { padding: 20px 8px 16px; }
.lm-quicklinks__list { display: flex; justify-content: space-between; gap: 4px; max-width: 360px; margin: 0 auto; }
.lm-quicklinks__item { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; font-weight: 700; font-size: 12px; line-height: 14.4px; }
.lm-quicklinks__icon { width: 40px; height: 40px; border-radius: 50%; background: #c9aad6; display: flex; align-items: center; justify-content: center; transition: transform .3s var(--lm-ease-bounce); }
.lm-quicklinks__icon img, .lm-quicklinks__icon svg { width: 24px; height: 24px; object-fit: contain; }
.lm-quicklinks__item:active .lm-quicklinks__icon { transform: scale(.92); }
@media (min-width: 1025px) { .lm-quicklinks--mobile-only { display: none; } }

/* ==========================================================================
   HERO
   ========================================================================== */
.lm-hero { position: relative; overflow: hidden; background-color: var(--lm-lilac); }
.lm-hero__slide { position: relative; display: grid; grid-template-columns: 1fr; }
.lm-hero__bg { position: absolute; inset: 0; z-index: 0; }
.lm-hero__bg img { width: 100%; height: 100%; object-fit: cover; }
.lm-hero__bg--mobile { display: block; }
.lm-hero__bg--desktop { display: none; }
.lm-hero__content { position: relative; z-index: 2; text-align: center; padding: 24px var(--lm-gutter) 0; }
.lm-hero__heading { font-family: var(--lm-font-display); font-weight: 500; font-size: 40px; line-height: 1.1; white-space: nowrap; }
.lm-hero__heading .lm-squiggle__wrapper { bottom: -10px; }
.lm-hero__sub { margin-top: 30px; font-weight: 500; font-size: 18px; line-height: 1; }
.lm-hero__ctas { display: grid; gap: 12px; justify-items: center; margin-top: 26px; }
.lm-hero__usps { display: flex; justify-content: space-between; max-width: 345px; margin: 40px auto 0; }
.lm-hero__usp { display: flex; flex-direction: column; align-items: center; gap: 13px; width: 100px; text-align: center; font-weight: 700; font-size: 10px; line-height: 15px; text-transform: uppercase; }
.lm-hero__usp img { width: 40px; height: 40px; object-fit: contain; }
.lm-hero__media { position: relative; z-index: 1; margin-top: 37px; }
.lm-hero__media img { width: 100%; height: auto; }
.lm-hero__media--desktop { display: none; }
@media (min-width: 768px) and (max-width: 1024px) {
  .lm-hero__heading { font-size: 40px; }
  .lm-hero__ctas { grid-template-columns: repeat(2, minmax(0, 345px)); justify-content: center; }
  .lm-hero__media { max-width: 600px; margin-left: auto; margin-right: auto; }
}
@media (min-width: 1025px) {
  .lm-hero__bg--mobile { display: none; }
  .lm-hero__bg--desktop { display: block; }
  .lm-hero__slide { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 509px; align-items: start; }
  .lm-hero__content { text-align: left; padding: 40px 0 53px var(--lm-gutter); }
  .lm-hero__heading { font-size: 52px; line-height: 1.143; }
  .lm-hero__heading .lm-squiggle__wrapper { bottom: -18px; }
  .lm-hero__sub { margin-top: 50px; font-size: 24px; }
  .lm-hero__ctas { display: flex; gap: 56px; margin-top: 41px; padding-left: 20px; }
  .lm-hero__usps { justify-content: flex-start; gap: 0; max-width: none; margin: 70px 0 0; }
  .lm-hero__usp { flex-direction: row; width: auto; gap: 15px; margin-right: 32px; text-align: left; font-weight: 600; font-size: 16px; line-height: 16px; max-width: 190px; }
  .lm-hero__usp img { width: 66.7px; height: 70px; }
  .lm-hero__usp span { max-width: 104px; }
  .lm-hero__media { margin: 0; align-self: end; display: flex; justify-content: flex-end; padding-right: var(--lm-gutter); }
  .lm-hero__media--mobile { display: none; }
  .lm-hero__media--desktop { display: flex; }
  .lm-hero__media img { width: 100%; max-width: 640px; height: auto; margin-top: 5px; }
}
@media (min-width: 1440px) { .lm-hero__heading { font-size: 70px; } }
/* hero slider (fade) */
.lm-hero__slides { position: relative; }
.lm-hero__slides > .lm-hero__slide:not(:first-child) { position: absolute; inset: 0; }
.lm-hero__slides > .lm-hero__slide { transition: opacity 1s ease; }
.lm-hero__slides > .lm-hero__slide:not(.is-active) { opacity: 0; pointer-events: none; }
.lm-hero__dots { position: absolute; z-index: 3; left: 50%; bottom: 16px; transform: translateX(-50%); display: flex; gap: 8px; }
.lm-hero__dots button { width: 12px; height: 12px; border-radius: 50%; border: 1.6px solid var(--lm-black); background: var(--lm-white); padding: 0; cursor: pointer; }
.lm-hero__dots button[aria-current="true"] { background: var(--lm-black); }

/* ==========================================================================
   PRESS LOGOS ("brag bar")
   ========================================================================== */
.lm-press { background: var(--lm-black); color: var(--lm-white); padding: 40px 0 32px; }
.lm-press .swiper { padding: 0 var(--lm-gutter); }
.lm-press .swiper-wrapper { align-items: center; transition-timing-function: var(--lm-ease-bounce); }
.lm-press__slide { display: flex; align-items: center; justify-content: center; height: 32px; }
.lm-press__logo { max-height: 32px; width: auto; max-width: 167px; object-fit: contain; }
.lm-press__text { font-family: var(--lm-font-display); font-size: 26px; letter-spacing: .04em; white-space: nowrap; }
.lm-press__pagination { position: static !important; display: flex; justify-content: center; margin-top: 16px; }
.lm-press__pagination .swiper-pagination-bullet { position: relative; width: auto; height: auto; padding: 12px; margin: 0 4px !important; background: transparent; opacity: 1; }
.lm-press__pagination .swiper-pagination-bullet::before {
  content: ""; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 10px; height: 10px; border: 2px solid var(--lm-white); border-radius: 50%; background: var(--lm-white);
}
.lm-press__pagination .swiper-pagination-bullet-active::before { background: var(--lm-lime); border-color: var(--lm-lime); }
@media (max-width: 749px) { .lm-press { padding: 40px 0 24px; } }

/* ==========================================================================
   PRODUCT GRID ("current faves")
   ========================================================================== */
.lm-products { padding: 16px 0 72px; }
.lm-products__heading { font-family: var(--lm-font-display); font-weight: 500; font-size: 40px; line-height: 1.36; text-align: center; margin-bottom: 0; }
@media (min-width: 1025px) { .lm-products__heading { font-size: 60px; } }
.lm-products__viewport { position: relative; }
.lm-products .swiper { padding: 0 8px; }
@media (min-width: 1025px) { .lm-products .swiper { padding: 0 20px; } }
.lm-card { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; height: auto; }
.lm-card__media { position: relative; width: 100%; aspect-ratio: 1 / 1; display: block; }
.lm-card__media::after {
  content: ""; position: absolute; z-index: 0; bottom: -4px; left: 50%; width: 55%; padding-top: 3%;
  transform: translateX(-50%); border-radius: 50%; opacity: .25; background: var(--lm-lilac); filter: blur(8px);
}
.lm-card__img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: contain; }
.lm-card__img--hover { position: absolute; inset: 0; z-index: 2; opacity: 0; transition: opacity .2s linear; }
.lm-card__body { position: relative; z-index: 3; display: flex; flex-direction: column; align-items: center; padding: 0 4px; margin-top: -4px; }
.lm-card__title { font-family: var(--lm-font-display); font-weight: 400; font-size: 27px; line-height: 32.4px; text-transform: uppercase; color: var(--lm-ink); max-width: 300px; }
.lm-card__subtitle { margin-top: 6px; font-size: 16px; line-height: 1.2; }
.lm-card__price { margin-top: 10px; font-weight: 700; font-size: 16px; line-height: 1.2; }
.lm-card__price s { font-weight: 400; margin-right: 6px; }
.lm-card__cta { margin-top: auto; padding-top: 28px; }
.lm-card__link { position: absolute; inset: 0; z-index: 4; }
.lm-card__cta .lm-btn { position: relative; z-index: 5; transition: background-color .3s, color .3s; }
.lm-card__cta .lm-btn:hover { background: var(--lm-black); }
.lm-card__cta .lm-btn:hover .lm-btn__text { color: var(--lm-white); }
.lm-card__cta .lm-btn .lm-btn__filler { display: none; }
@keyframes lm-float { 0% { transform: translateY(0); } 50% { transform: translateY(-14px); } 100% { transform: translateY(0); } }
@media (hover: hover) and (min-width: 1025px) {
  .lm-card:hover .lm-card__img, .lm-card:focus-within .lm-card__img { animation: lm-float 1.5s ease-in-out infinite; }
  .lm-card:hover .lm-card__img--hover { opacity: 1; }
}
.lm-products__nav { position: absolute; z-index: 5; top: calc(50% - 120px); width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: none; border: 0; padding: 0; cursor: pointer; color: var(--lm-black); }
.lm-products__nav--prev { left: 0; }
.lm-products__nav--next { right: 0; }
.lm-products__nav.swiper-button-disabled { opacity: .3; cursor: default; }
.lm-products__pagination { position: static !important; display: flex; justify-content: center; gap: 8px; margin-top: 20px; }
.lm-products__pagination .swiper-pagination-bullet { width: 12px; height: 12px; margin: 0 !important; border: 1.6px solid var(--lm-black); background: var(--lm-white); opacity: 1; }
.lm-products__pagination .swiper-pagination-bullet-active { background: var(--lm-black); }
@media (min-width: 1025px) {
  .lm-products__nav, .lm-products__pagination { display: none !important; }
  .lm-products { padding: 18px 0 72px; }
}

/* ==========================================================================
   BENEFIT CARDS ("lemme get real results")
   ========================================================================== */
.lm-benefits { padding: 36px 0 80px; text-align: center; }
.lm-benefits__heading { font-family: var(--lm-font-display); font-weight: 500; font-size: 36px; line-height: 1.18; max-width: 200px; margin: 0 auto; }
.lm-benefits__sub { margin: 12px auto 0; font-size: 16px; line-height: 24px; max-width: 335px; }
.lm-benefits__grid { display: grid; gap: 16px; margin-top: 28px; }
.lm-benefit { display: flex; flex-direction: column; border: 1.6px solid var(--lm-black); border-radius: 32px; overflow: hidden; background: var(--lm-lilac-light); }
.lm-benefit__media { display: none; aspect-ratio: 1 / 1; border-bottom: 1.6px solid var(--lm-black); background: var(--lm-lilac); }
.lm-benefit__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--lm-ease-out); }
.lm-benefit__body { display: flex; align-items: center; gap: 12px; padding: 14px 14px; min-height: 60px; text-align: left; }
.lm-benefit__check { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; border: 1.6px solid var(--lm-black); background: var(--lm-lime); }
.lm-benefit__title { font-weight: 700; font-size: 16px; line-height: 24px; }
@media (min-width: 750px) {
  .lm-benefits { padding: 40px 0 96px; }
  .lm-benefits__heading { font-size: 54px; line-height: 1.36; max-width: none; }
  .lm-benefits__sub { margin-top: 8px; font-size: 24px; line-height: 32px; max-width: none; }
  .lm-benefits__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 49px; text-align: center; }
  .lm-benefit__media { display: block; }
  .lm-benefit__body { flex-direction: column; justify-content: flex-start; gap: 8px; padding: 16px 20px 24px; min-height: 176px; text-align: center; }
  .lm-benefit__check { width: 40px; height: 40px; }
  .lm-benefit__title { font-size: 24px; line-height: 32px; }
  .lm-benefit:hover .lm-benefit__media img { transform: scale(1.04); }
}
@media (min-width: 900px) { .lm-benefits__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; } }
@media (min-width: 1025px) { .lm-benefits__grid { gap: 24px; } }

/* ==========================================================================
   NO LIST ("what we leave out") — strike-through animation on scroll
   ========================================================================== */
.lm-nolist { padding: 0 0 80px; }
.lm-nolist__card { display: grid; gap: 24px; padding: 32px 22px 38px; border: 1.6px solid var(--lm-black); border-radius: 32px; background: var(--lm-lilac-light); text-align: center; }
.lm-nolist__heading { font-family: var(--lm-font-display); font-weight: 500; font-size: 36px; line-height: 1.36; }
.lm-nolist__heading .lm-squiggle { white-space: nowrap; }
.lm-nolist__heading .lm-squiggle__wrapper { bottom: -8px; }
.lm-nolist__sub { margin-top: 16px; font-size: 24px; line-height: 32px; }
.lm-nolist__content .lm-btn { margin-top: 32px; }
.lm-nolist__box { background: var(--lm-black); color: var(--lm-white); border-radius: 32px; padding: 32px 16px 28px; display: flex; align-items: center; justify-content: center; }
.lm-nolist__list { display: grid; gap: 8px; text-align: left; }
.lm-nolist__item { display: flex; align-items: center; gap: 4px; font-weight: 700; font-size: 16px; line-height: 24px; text-transform: uppercase; }
.lm-nolist__item .lm-icon--x { width: 24px; height: 24px; }
.lm-nolist__strike { position: relative; }
.lm-nolist__strike::after {
  content: ""; position: absolute; top: 50%; left: 0; width: 0; height: 1px; background: currentColor;
  transform: translateY(-50%); transition: width .3s ease; transition-delay: 0s;
}
.lm-nolist.is-in-view .lm-nolist__strike::after { width: 100%; transition-delay: var(--lm-strike-delay, 0ms); }
.lm-nolist__mobile-btn { margin-top: 24px; }
@media (min-width: 750px) {
  .lm-nolist { padding: 0 0 96px; }
  .lm-nolist__card { grid-template-columns: minmax(0, 0.62fr) minmax(0, 1fr); align-items: center; gap: 24px; padding: 21px 21px 21px 48px; text-align: left; min-height: 400px; }
  .lm-nolist__heading { font-size: 56px; line-height: 1.1; max-width: 420px; }
  .lm-nolist__heading .lm-squiggle__wrapper { bottom: -14px; }
  .lm-nolist__sub { margin-top: 36px; }
  .lm-nolist__box { min-height: 354.8px; padding: 32px 48px; }
  .lm-nolist__list { grid-template-columns: repeat(2, minmax(0, max-content)); grid-auto-flow: column; grid-template-rows: repeat(3, auto); column-gap: 120px; row-gap: 8px; }
  .lm-nolist__item { font-size: 20px; line-height: 24px; }
  .lm-nolist__mobile-btn { display: none; }
}
@media (min-width: 1025px) { .lm-nolist__heading { font-size: 80px; } }
@media (max-width: 749px) { .lm-nolist__content .lm-btn { display: none; } }

/* ==========================================================================
   SUBSCRIBE & SAVE BANNER
   ========================================================================== */
.lm-subscribe { padding: 0 0 64px; }
.lm-subscribe__card { position: relative; overflow: hidden; border: 1.6px solid var(--lm-black); border-radius: 32px; background: var(--lm-lilac-mid); }
.lm-subscribe__bg { position: absolute; inset: 0; z-index: 0; }
.lm-subscribe__bg img { width: 100%; height: 100%; object-fit: cover; }
.lm-subscribe__bg--desktop { display: none; }
.lm-subscribe__inner { position: relative; z-index: 1; display: grid; }
.lm-subscribe__media { display: none; }
.lm-subscribe__content { padding: 26px 24px 24px; }
.lm-subscribe__heading { font-family: var(--lm-font-display); font-weight: 500; font-size: 36px; line-height: 55px; }
.lm-subscribe__heading > span { display: block; }
.lm-subscribe__heading .lm-squiggle { display: inline-block; }
.lm-subscribe__text { margin-top: 18px; font-size: 15px; line-height: 22.5px; max-width: 280px; }
.lm-subscribe__perks { display: grid; gap: 8px; margin-top: 18px; }
.lm-subscribe__perk { display: flex; align-items: center; gap: 10px; font-size: 14px; line-height: 19.6px; }
.lm-subscribe__perk-icon { flex-shrink: 0; width: 44px; height: 44px; border-radius: 50%; background: var(--lm-white); display: flex; align-items: center; justify-content: center; overflow: hidden; }
.lm-subscribe__perk-icon img { width: 100%; height: 100%; object-fit: contain; }
.lm-subscribe__cta { margin-top: 36px; }
.lm-subscribe__cta .lm-btn { width: 100%; max-width: 284px; }
@media (min-width: 750px) {
  .lm-subscribe { padding: 0 0 80px; }
  .lm-subscribe__bg--mobile { display: none; }
  .lm-subscribe__bg--desktop { display: block; }
  .lm-subscribe__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; min-height: 531px; }
  .lm-subscribe__media { display: block; padding: 32px 0 32px 48px; }
  .lm-subscribe__media img { width: 100%; max-width: 652px; height: auto; }
  .lm-subscribe__content { padding: 40px 48px 48px 48px; }
  .lm-subscribe__heading { font-size: 44px; line-height: 60px; }
  .lm-subscribe__text { margin-top: 12px; font-size: 18px; line-height: 27px; max-width: none; }
  .lm-subscribe__perks { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; margin-top: 18px; max-width: 520px; }
  .lm-subscribe__perk { gap: 12px; font-size: 16px; line-height: 22.4px; }
  .lm-subscribe__perk-icon { width: 56px; height: 56px; }
  .lm-subscribe__cta { margin-top: 56px; }
  .lm-subscribe__cta .lm-btn { width: auto; }
}
@media (min-width: 1025px) {
  .lm-subscribe__content { padding: 40px 48px 48px 0; }
  .lm-subscribe__heading { font-size: 55px; }
}

/* ==========================================================================
   CONTENT BANNER ("real science, real results")
   ========================================================================== */
.lm-banner { padding: 0 0 80px; }
.lm-banner__card { position: relative; overflow: hidden; border: 1.6px solid var(--lm-black); border-radius: 32px; min-height: 600px; display: flex; align-items: flex-end; }
.lm-banner__bg { position: absolute; inset: 0; z-index: 0; }
.lm-banner__bg img { width: 100%; height: 100%; object-fit: cover; object-position: center top; transition: transform 1.2s var(--lm-ease-out); }
.lm-banner__card:hover .lm-banner__bg img { transform: scale(1.02); }
.lm-banner__bg--desktop { display: none; }
.lm-banner__content { position: relative; z-index: 1; padding: 0 22px 38px; }
.lm-banner__heading { font-family: var(--lm-font-display); font-weight: 500; font-size: 24px; line-height: 1.18; text-transform: uppercase; max-width: 240px; }
.lm-banner__text { margin-top: 12px; font-size: 16px; line-height: 24px; max-width: 285px; }
.lm-banner__content .lm-btn { margin-top: 18px; width: 100%; max-width: 287px; }
@media (min-width: 750px) {
  .lm-banner { padding: 0 0 144px; }
  .lm-banner__card { min-height: 366px; align-items: center; }
  .lm-banner__bg--mobile { display: none; }
  .lm-banner__bg--desktop { display: block; }
  .lm-banner__bg--desktop img { object-position: right center; }
  .lm-banner__content { padding: 48px; }
  .lm-banner__heading { font-size: 36px; line-height: 1.36; max-width: none; }
  .lm-banner__text { margin-top: 12px; font-size: 24px; line-height: 32px; max-width: 560px; }
  .lm-banner__content .lm-btn { width: auto; margin-top: 30px; }
}

/* ==========================================================================
   TICKER ("OHMYGOSHWAGANDHA")
   ========================================================================== */
.lm-ticker { padding: 0 0 96px; --lm-marquee-speed: 10s; }
.lm-ticker__band { background: var(--lm-black); color: var(--lm-white); padding: 22px 0 26px; }
.lm-ticker .lm-marquee__item { font-weight: 700; font-size: 24px; line-height: 32px; text-transform: uppercase; }
.lm-ticker .lm-icon--star { width: 32px; height: 32px; margin: 0 17px; }
.lm-ticker__toggle { position: absolute; top: 50%; right: 8px; transform: translateY(-50%); width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--lm-black); background: var(--lm-white); display: none; align-items: center; justify-content: center; cursor: pointer; }
.lm-ticker__band:focus-within .lm-ticker__toggle { display: flex; }
@media (min-width: 750px) { .lm-ticker { padding: 0 0 144px; } }

/* ==========================================================================
   FOOTER
   ========================================================================== */
.lm-footer { position: relative; overflow: hidden; background: var(--lm-lilac); padding: 58px 0 44px; }
.lm-footer__grid { position: relative; z-index: 1; display: grid; gap: 22px; }
.lm-footer__menus { order: -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
.lm-footer__menu-title { font-weight: 700; font-size: 16px; line-height: 16px; text-transform: uppercase; margin-bottom: 24px; }
.lm-footer__menu ul { display: grid; gap: 24px; }
.lm-footer__menu a { font-size: 16px; line-height: 16px; text-transform: uppercase; }
.lm-footer__menu a:hover { text-decoration: underline 1px; text-underline-offset: 4px; }
.lm-footer__heading { font-family: var(--lm-font-display); font-weight: 500; font-size: 36px; line-height: 1.18; max-width: 220px; }
.lm-footer__form { margin-top: 20px; }
.lm-footer__field { display: flex; width: 100%; max-width: 335px; height: 48px; border-radius: 48px; box-shadow: inset 0 0 0 1.6px var(--lm-black); background: var(--lm-white); }
.lm-footer__field input {
  flex: 1 1 auto; min-width: 0; height: 48px; border: 0; padding: 12px 20px 14px 24px; border-radius: 48px 0 0 48px; background: transparent;
  font-family: var(--lm-font-body); font-size: 16px; color: var(--lm-black); outline: none;
}
.lm-footer__field input::placeholder { color: rgba(0, 0, 0, .5); }
.lm-footer__field button { flex: 0 0 60px; height: 48px; border: 0; border-radius: 0 48px 48px 0; background: transparent; color: var(--lm-black); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: transform .2s ease-in; }
.lm-footer__field button:hover { transform: translateX(3px); }
.lm-footer__field:focus-within { box-shadow: inset 0 0 0 2px var(--lm-black), 0 0 0 3px var(--lm-lime); }
.lm-footer__msg { margin-top: 8px; font-size: 14px; font-weight: 700; }
.lm-footer__disclaimer { margin-top: 30px; font-size: 14px; line-height: 19.6px; max-width: 420px; }
.lm-footer__disclaimer a { text-decoration: underline; }
.lm-footer__social { display: flex; gap: 28px; margin-top: 32px; }
.lm-footer__social a { display: inline-flex; padding: 0; transition: transform .25s var(--lm-ease-bounce); }
.lm-footer__social a:hover { transform: translateY(-3px); }
.lm-footer__legal { display: grid; gap: 0; margin-top: 38px; font-size: 14px; line-height: 16px; }
.lm-footer__legal p { margin-bottom: 10px; max-width: 290px; }
.lm-footer__legal-links { display: flex; flex-wrap: wrap; gap: 0 16px; }
.lm-footer__legal-links a { text-decoration: underline; display: inline-flex; align-items: center; gap: 6px; }
.lm-footer__fda { margin-top: 32px; border: 1.6px solid var(--lm-black); border-radius: 8px; padding: 10px 12px; font-weight: 700; font-size: 14px; line-height: 16px; }
.lm-footer__sparkles { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
.lm-sparkle { position: absolute; display: block; color: var(--lm-black); animation: lm-sparkling 1s ease-in-out infinite alternate; }
.lm-sparkle svg { width: 100%; height: auto; }
.lm-sparkle--1 { right: 5%; bottom: 32%; width: 96px; animation-delay: .4s; }
.lm-sparkle--2 { right: 24%; bottom: 40%; width: 40px; animation-delay: .8s; }
@keyframes lm-sparkling { 0% { opacity: 0; } 100% { opacity: 1; } }
@media (min-width: 750px) {
  .lm-footer__heading { font-size: 54px; line-height: 1.18; max-width: 340px; }
}
@media (min-width: 1025px) {
  .lm-footer { padding: 30px 0 44px; }
  .lm-footer__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 380px); gap: 40px 60px; }
  .lm-footer__menus { order: 0; grid-column: 2; grid-row: 1; gap: 40px; padding-top: 24px; }
  .lm-footer__newsletter { grid-column: 1; grid-row: 1 / span 2; }
  .lm-footer__field { max-width: 312px; }
  .lm-footer__legal { grid-template-columns: 186px repeat(6, auto); align-items: start; gap: 24px; justify-content: start; }
  .lm-footer__legal p { margin: 0; }
  .lm-footer__legal-links { display: contents; }
  .lm-footer__legal-links a { max-width: 70px; }
  .lm-footer__legal-links a:nth-child(3) { max-width: 140px; }
  .lm-footer__fda { grid-column: 2; grid-row: 2; margin-top: 0; align-self: start; }
  .lm-sparkle--1 { right: auto; bottom: 20%; left: 36%; width: 200px; }
  .lm-sparkle--2 { right: auto; bottom: 54%; left: 48%; width: 80px; }
}
