/* ==========================================================================
   Lemme homepage — sections, components and motion
   Rebuilt from the lemmelive.com homepage (desktop 1440 / mobile 375).
   Breakpoints: mobile < 750px, tablet 750–1024px, desktop >= 1025px.
   ========================================================================== */

/* ---------- Fonts ----------
   The live site uses the licensed fonts "Mier A" (Regular/Bold) and "Recoleta" (Medium).
   The font files (lemme-font-mier-a-regular.woff2, lemme-font-mier-a-bold.woff2, lemme-font-recoleta-medium.woff2) live in
   Content > Files, so they are loaded with file_url. If they are missing the stacks below fall back to similar fonts. */
@font-face { font-family: "Mier A"; src: url("{{ 'lemme-font-mier-a-regular.woff2' | file_url }}") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
@font-face { font-family: "Mier A"; src: url("{{ 'lemme-font-mier-a-bold.woff2' | file_url }}") format("woff2"); font-weight: 700; font-style: normal; font-display: swap; }
@font-face { font-family: "Recoleta"; src: url("{{ 'lemme-font-recoleta-medium.woff2' | file_url }}") format("woff2"); font-weight: 500; font-style: normal; font-display: swap; }

:root {
  --lm-lilac: #dfc8e7;
  --lm-lilac-light: #f7f1f9;
  --lm-lilac-mid: #f5f0f9;
  --lm-lime: #c5ff89;
  --lm-black: #000;
  --lm-white: #fff;
  --lm-ink: #232323;
  --lm-font-body: "Mier A", "DM Sans", "Helvetica Neue", helvetica, arial, sans-serif;
  --lm-font-display: "Recoleta", "Fraunces", Georgia, "Times New Roman", serif;
  --lm-ease-bounce: cubic-bezier(.5, -.5, .25, 1.4);
  --lm-ease-out: cubic-bezier(.215, .61, .355, 1);
  --lm-gutter: 20px;
  --lm-header-h: 72px;
  --lm-promo-h: 32px;
}
@media (min-width: 750px) { :root { --lm-gutter: 40px; } }
@media (min-width: 1025px) { :root { --lm-gutter: 60px; } }

/* The live site uses lilac as the page background everywhere. */
body:has(.lm-header), body:has(.lm-header) .page-wrapper { background-color: var(--lm-lilac); }

.lm-section, .lm-header, .lm-footer, .lm-drawer, .lm-mega {
  font-family: var(--lm-font-body);
  font-size: 16px;
  line-height: 1.6;
  color: var(--lm-black);
  -webkit-font-smoothing: antialiased;
}
:where(.lm-section, .lm-header, .lm-footer, .lm-drawer, .lm-mega) *,
:where(.lm-section, .lm-header, .lm-footer, .lm-drawer, .lm-mega) *::before,
:where(.lm-section, .lm-header, .lm-footer, .lm-drawer, .lm-mega) *::after { box-sizing: border-box; }
:where(.lm-section, .lm-header, .lm-footer, .lm-drawer, .lm-mega) img { max-width: 100%; display: block; }
:where(.lm-section, .lm-header, .lm-footer, .lm-drawer, .lm-mega) a { color: inherit; text-decoration: none; }
:where(.lm-section, .lm-footer, .lm-mega, .lm-drawer) :is(h1, h2, h3, p) { margin: 0; letter-spacing: normal; font-family: inherit; font-size: inherit; font-weight: inherit; font-style: normal; line-height: inherit; text-transform: none; color: inherit; }
:where(.lm-section, .lm-footer, .lm-mega, .lm-drawer, .lm-header) ul { list-style: none; margin: 0; padding: 0; }
.lm-section { background: var(--lm-lilac); position: relative; }
.lm-container { width: 100%; padding-left: var(--lm-gutter); padding-right: var(--lm-gutter); margin: 0 auto; }
.lm-visually-hidden { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.lm-display { font-family: var(--lm-font-display); font-weight: 500; line-height: 1; }
.lm-hide-mobile { display: none !important; }
@media (min-width: 750px) { .lm-hide-mobile { display: revert !important; } .lm-hide-desktop { display: none !important; } }
.lm-icon { display: block; flex-shrink: 0; }

/* ---------- Buttons (pill + black "filler" that slides up on hover) ---------- */
.lm-btn {
  --lm-btn-bg: var(--lm-white);
  --lm-btn-fg: var(--lm-black);
  --lm-btn-filler: var(--lm-black);
  --lm-btn-fg-hover: var(--lm-white);
  position: relative; display: inline-flex; align-items: center; justify-content: center;
  min-height: 46px; padding: 13px 48px; margin: 0;
  border: 0; border-radius: 48px; overflow: hidden; isolation: isolate;
  background: var(--lm-btn-bg); color: var(--lm-btn-fg);
  box-shadow: inset 0 0 0 2px var(--lm-black);
  font-family: var(--lm-font-body); font-weight: 700; font-size: 16px; line-height: 1; text-transform: uppercase; letter-spacing: 0;
  cursor: pointer; text-decoration: none; backface-visibility: hidden; will-change: transform;
  transition: color .2s ease-out, background-color .3s ease, box-shadow .3s ease;
  -webkit-tap-highlight-color: transparent;
}
.lm-btn--dark { --lm-btn-bg: var(--lm-black); --lm-btn-fg: var(--lm-white); --lm-btn-filler: var(--lm-white); --lm-btn-fg-hover: var(--lm-black); }
.lm-btn--lg { min-height: 70px; width: 345px; max-width: 100%; font-size: 20px; padding: 0 24px; box-shadow: none; }
.lm-btn--sm { min-height: 48.8px; padding: 0 36px; font-size: 16px; box-shadow: inset 0 0 0 1.6px var(--lm-black); }
.lm-btn--full { width: 100%; }
.lm-btn__filler {
  position: absolute; z-index: -1; top: -50%; left: -25%; width: 150%; height: 200%;
  border-radius: 50%; background: var(--lm-btn-filler); pointer-events: none;
  transform: translate3d(0, 75%, 0);
}
.lm-btn__text, .lm-btn__text-inner { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; pointer-events: none; }
.lm-btn .lm-btn__text { color: var(--lm-btn-fg); transition: color .2s ease-out; }
.lm-btn.is-hovered .lm-btn__text { color: var(--lm-btn-fg-hover); }
.lm-btn:focus-visible { outline: 3px solid var(--lm-black); outline-offset: 3px; }
@media (max-width: 749px) {
  .lm-btn--lg { width: 100%; max-width: 345px; min-height: 55px; box-shadow: inset 0 0 0 2px var(--lm-black); }
}
@media (hover: none), (max-width: 1024px) {
  .lm-btn__filler { display: none; }
  .lm-btn--dark:active { background: var(--lm-white); }
  .lm-btn--dark:active .lm-btn__text { color: var(--lm-black); }
  .lm-btn--light:active { background: var(--lm-black); }
  .lm-btn--light:active .lm-btn__text { color: var(--lm-white); }
}

/* ---------- Animated squiggle underline ---------- */
.lm-squiggle { position: relative; display: inline-block; }
.lm-squiggle__copy { position: relative; z-index: 1; }
.lm-squiggle__wrapper {
  position: absolute; left: 0; bottom: -10px; width: 100%; display: flex; align-items: center;
  overflow: hidden; color: var(--lm-squiggle-color, var(--lm-lime)); pointer-events: none;
}
.lm-squiggle__wrapper > span { display: block; flex-shrink: 0; will-change: transform; animation: lm-marquee 1s linear infinite reverse; }
.lm-squiggle__wrapper svg { width: auto; max-width: none; height: 3.2vw; margin-left: -1.1333vw; display: block; flex-shrink: 0; }
.lm-squiggle:hover .lm-squiggle__wrapper > span { animation-play-state: paused; }
@media (min-width: 750px) {
  .lm-squiggle__wrapper { bottom: -12px; }
  .lm-squiggle__wrapper svg { height: 1.6666vw; max-height: 24px; margin-left: -.5555vw; }
}
@media (min-width: 1025px) { .lm-squiggle__wrapper { bottom: -18px; } }

/* ---------- Marquee (shared by promo bar + ticker) ---------- */
@keyframes lm-marquee { 0% { transform: translateX(-100%); } 100% { transform: translateX(0); } }
.lm-marquee { position: relative; overflow: hidden; display: flex; user-select: none; }
.lm-marquee__track { display: flex; flex-wrap: nowrap; align-items: center; }
.lm-marquee__item {
  display: flex; align-items: center; flex-shrink: 0; white-space: nowrap;
  animation: lm-marquee var(--lm-marquee-speed, 16s) linear infinite;
  will-change: transform;
}
.lm-marquee:hover .lm-marquee__item, .lm-marquee.is-paused .lm-marquee__item { animation-play-state: paused; }
@media (prefers-reduced-motion: reduce) {
  .lm-marquee__item, .lm-squiggle__wrapper > span, .lm-sparkle { animation: none !important; }
}

/* ==========================================================================
   HEADER  (black promo bar that scrolls away + lilac 72px bar that stays)
   lemme-home.js sets --lm-promo-shift (0 → promo height) while scrolling.
   ========================================================================== */
:root { --lm-promo-shift: 0px; --lm-header-bottom: calc(var(--lm-header-h) + var(--lm-promo-h) - var(--lm-promo-shift)); }
.lm-header-spacer { height: calc(var(--lm-header-h) + var(--lm-promo-h)); }
.lm-header { position: fixed; z-index: 995; top: calc(var(--lm-promo-shift) * -1); left: 0; right: var(--lm-scrollbar-width, 0px); }
.lm-promo {
  position: relative; z-index: 4; height: var(--lm-promo-h); background: var(--lm-black); color: var(--lm-white);
  --lm-marquee-speed: 16s;
}
.lm-promo .lm-marquee { height: 100%; align-items: center; }
.lm-promo .lm-marquee__item { font-size: 14px; line-height: 16px; font-weight: 700; text-transform: uppercase; }
.lm-promo .lm-icon--star { width: 16px; height: 16px; margin: 0 17px; }
.lm-promo a { color: inherit; }
.lm-header__bar {
  position: relative; z-index: 3; display: flex; align-items: center; justify-content: space-between;
  height: var(--lm-header-h); padding: 0 16px; background: var(--lm-lilac); color: var(--lm-ink); border-bottom: 2px solid var(--lm-black);
}
.lm-header__left { display: flex; align-items: center; gap: 16px; flex: 1 1 0; min-width: 0; }
.lm-header__right { display: flex; align-items: center; justify-content: flex-end; gap: 24px; flex: 1 1 0; }
.lm-header__logo { position: relative; z-index: 4; flex: 0 0 auto; display: flex; align-items: center; color: inherit; }
.lm-header__logo svg, .lm-header__logo img { display: block; width: 110px; height: 24px; }
.lm-header__link, .lm-header__toggle {
  display: inline-flex; align-items: center; padding: 0; border: 0; border-bottom: 2px solid transparent; background: none; cursor: pointer;
  color: inherit; font-family: var(--lm-font-body); font-weight: 700; font-size: 16px; line-height: 1; text-transform: uppercase;
  transition: border-color .2s;
}
.lm-header__link:hover, .lm-header__link:focus-visible, .lm-header__toggle:hover, .lm-header__toggle:focus-visible, .lm-header__toggle[aria-expanded="true"] { border-bottom-color: currentColor; }
.lm-header__plus { width: 20px; height: 20px; margin-left: 4px; transition: transform .3s var(--lm-ease-bounce); }
.lm-header__toggle[aria-expanded="true"] .lm-header__plus { transform: rotate(45deg); }
.lm-header__icon { position: relative; display: flex; align-items: center; justify-content: center; width: 20px; height: 20px; margin: 0; padding: 0; border: 0; background: none; color: inherit; cursor: pointer; }
.lm-header__icon .lp-icon { width: 20px; height: 20px; }
.lm-header__icon:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
.lm-header__count {
  position: absolute; top: -6px; right: -8px; display: inline-flex; align-items: center; justify-content: center;
  min-width: 14px; aspect-ratio: 1 / 1; padding: 0; border-radius: 50%; background: var(--lm-ink); color: var(--lm-white);
  font-family: var(--lm-font-body); font-size: 10px; font-weight: 400; line-height: 1;
}
.lm-header__count[data-count="0"] { display: none; }
.lm-header__menu-close, .lm-header__menu-btn[aria-expanded="true"] .lm-header__menu-open { display: none; }
.lm-header__menu-btn[aria-expanded="true"] .lm-header__menu-close { display: block; }
.lm-header__mobile-only { display: none; }
.lm-locale { display: flex; align-items: center; margin: 0; }
.lm-locale__control { display: inline-flex; align-items: center; min-height: 28px; padding: 4px 0; border: 0; background: none; color: inherit; cursor: pointer; }
.lm-locale__value { font-family: var(--lm-font-body); font-size: 16px; font-weight: 700; line-height: 1; text-transform: uppercase; }
.lm-locale__chevron { width: 8px; height: 5px; margin-left: 8px; transition: transform .2s; }
.lm-locale__control[aria-expanded="true"] .lm-locale__chevron { transform: rotate(180deg); }
.lm-header__locale { position: relative; }
.lm-locale__menu { position: absolute; z-index: 2; top: calc(100% + 4px); left: 0; min-width: 100%; margin: 0; padding: 0; overflow: hidden; list-style: none; border: 2px solid #000; border-radius: 16px; background: #fff; }
.lm-locale__menu[hidden] { display: none; }
.lm-locale__option { display: flex; align-items: center; width: 100%; min-height: 32px; margin: 0; padding: 8px 16px; border: 0; background: #fff; color: #000; cursor: pointer; text-align: left; font-family: var(--lm-font-body); font-size: 16px; font-weight: 700; line-height: 1; }
.lm-locale__option[aria-selected="true"], .lm-locale__option:hover, .lm-locale__option:focus-visible { background: #000; color: #fff; }
@media (min-width: 1025px) {
  .lm-header__bar { padding: 0 40px; }
  .lm-header__logo { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }
}
@media (max-width: 1024px) {
  .lm-header__desktop-only { display: none !important; }
  .lm-header__mobile-only { display: flex; }
  .lm-header__right { flex: 0 0 auto; }
}

/* ---------- Mega menu (desktop) ---------- */
/* Measurements taken from lemmelive.com at 1440px: 3 equal columns, 56px gap,
   60px side padding, columns start ~29px under the promo bar, 32px rounded bottom. */
.lm-mega {
  position: fixed; z-index: 1; top: var(--lm-header-bottom); left: 0; right: var(--lm-scrollbar-width, 0px);
  overflow: hidden; pointer-events: none; visibility: hidden;
  transition: visibility 0s linear .45s;
}
.lm-mega.is-open { visibility: visible; pointer-events: auto; transition: visibility 0s; }
.lm-mega__inner {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px; align-items: start;
  padding: 40px 60px;
  max-height: calc(100vh - var(--lm-header-bottom)); overflow-y: auto; overscroll-behavior: contain;
  background: var(--lm-lilac-light); border-radius: 0 0 32px 32px;
  transform: translateY(-100%); transition: transform .45s var(--lm-ease-bounce);
}
.lm-mega.is-open .lm-mega__inner { transform: none; }
.lm-mega-overlay {
  position: fixed; z-index: 0; top: var(--lm-header-bottom); left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .4); opacity: 0; visibility: hidden; pointer-events: none;
  transition: opacity .3s cubic-bezier(.46, .01, .32, 1), visibility 0s linear .3s;
}
.lm-mega.is-open + .lm-mega-overlay { opacity: 1; visibility: visible; pointer-events: auto; transition: opacity .3s cubic-bezier(.46, .01, .32, 1), visibility 0s; }
.lm-mega__col { min-width: 0; padding-top: 4px; }
.lm-mega__title { font-weight: 700; font-size: 20px; line-height: 24px; text-transform: uppercase; margin-bottom: 28px; }

/* Column 1: collections */
.lm-mega__col-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 32px; }
.lm-mega__col-head .lm-mega__title { margin: 0; }
.lm-mega .lm-mega__col-head .lm-btn { min-height: 46px; padding: 15px 48px; font-size: 16px; line-height: 16px; }
.lm-mega__circles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 0; }
.lm-mega__circle { display: flex; flex-direction: column; align-items: center; text-align: center; }
.lm-mega__circle-img { display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(223, 200, 231, .5); overflow: hidden; }
.lm-mega__circle-img img { width: 100%; height: 100%; object-fit: contain; border-radius: 50%; transition: transform .35s var(--lm-ease-bounce); }
.lm-mega__circle:hover .lm-mega__circle-img img { transform: translateY(-6px) scale(1.04); }
.lm-mega .lm-mega__circle { padding: 0 20px; }
.lm-mega .lm-mega__circle-img { width: 100%; aspect-ratio: 1 / 1; margin-bottom: 28px; }
.lm-mega__circle-text { font-family: var(--lm-font-display); font-weight: 500; font-size: 28px; line-height: 40px; }
.lm-mega .lm-mega__circle-text { margin: 0 -20px; white-space: nowrap; }

/* Column 2: best sellers (pill rows with the product popping out of the top) */
.lm-mega__pills { display: grid; gap: 8px; }
.lm-mega__pill { position: relative; display: flex; align-items: center; min-height: 80px; font-family: var(--lm-font-display); font-weight: 500; font-size: 20px; line-height: 24px; }
.lm-mega__pill::before { content: ""; position: absolute; z-index: 0; top: 16px; left: 0; right: 0; bottom: 0; border-radius: 50px; background: rgba(223, 200, 231, .5); transition: background-color .25s ease-in; }
.lm-mega__pill:hover::before, .lm-mega__pill:focus-visible::before { background: var(--lm-lilac); }
.lm-mega__pill-img { position: relative; z-index: 1; flex-shrink: 0; width: 112px; height: 80px; overflow: hidden; border-radius: 0 0 0 32px; }
.lm-mega__pill-img img { position: absolute; top: -8px; left: 50%; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: contain; transform: translateX(-50%); transition: top .35s var(--lm-ease-bounce); }
.lm-mega__pill:hover .lm-mega__pill-img img, .lm-mega__pill:focus-visible .lm-mega__pill-img img { top: -14px; }
.lm-mega__pill-text { position: relative; z-index: 1; margin: 20px 16px 0 12px; }

/* Column 3: benefits, subscribe box, featured */
.lm-mega__benefits { display: grid; gap: 16px; }
.lm-mega__benefit { display: flex; align-items: center; gap: 8px; font-family: var(--lm-font-display); font-weight: 500; font-size: 20px; line-height: 24px; text-transform: uppercase; }
.lm-mega__benefit img { width: 24px; height: 24px; flex-shrink: 0; }
.lm-mega__benefit:hover span { text-decoration: underline; text-underline-offset: 4px; }
.lm-mega__subscribe { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; padding: 6px 12px 8px 14px; border: 1.6px solid var(--lm-black); border-radius: 16px; background: var(--lm-lilac); }
.lm-mega__subscribe strong { display: block; margin-bottom: 4px; font-family: var(--lm-font-display); font-weight: 500; font-size: 15px; line-height: 16px; }
.lm-mega__subscribe-list { display: grid; gap: 8px; font-size: 12px; line-height: 14px; }
.lm-mega__subscribe-list span::before { content: "\2713"; margin-right: 6px; font-weight: 700; }
.lm-mega__subscribe-arrow { font-size: 20px; line-height: 20px; }
.lm-mega__featured-wrap { margin-top: 16px; }
.lm-mega__featured { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
.lm-mega__feature { position: relative; display: block; border: 1.6px solid var(--lm-black); border-radius: 32px; overflow: hidden; aspect-ratio: 1 / 1; }
.lm-mega__feature img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--lm-ease-out); }
.lm-mega__feature-blur { position: absolute; inset: 0; pointer-events: none; overflow: hidden; border-radius: 30px; filter: blur(4px); -webkit-mask: linear-gradient(transparent 55%, #000 80%); mask: linear-gradient(transparent 55%, #000 80%); }
.lm-mega__feature:hover .lm-mega__feature-blur img { transform: scale(1.05); }
.lm-mega__feature:hover img { transform: scale(1.05); }
.lm-mega__feature .lm-btn { position: absolute; z-index: 1; left: 50%; bottom: 14px; transform: translateX(-50%); width: calc(100% - 28px); min-height: 38px; padding: 0 8px; font-size: 13px; line-height: 14px; white-space: nowrap; }
.lm-mega__shipping { display: flex; align-items: center; gap: 8px; margin-top: 20px; font-size: 14px; font-weight: 700; text-transform: uppercase; }
@media (max-width: 1279px) {
  .lm-mega__inner { gap: 32px; }
  .lm-mega__circle-text { font-size: 22px; line-height: 30px; }
  .lm-mega .lm-mega__col-head .lm-btn { padding: 12px 24px; min-height: 40px; font-size: 14px; }
  .lm-mega__pill, .lm-mega__benefit { font-size: 17px; }
  .lm-mega__pill-img { width: 88px; }
  .lm-mega__featured { gap: 12px; }
  .lm-mega__feature .lm-btn { font-size: 11px; }
}
@media (max-width: 1024px) { .lm-mega, .lm-mega-overlay { display: none; } }

/* ---------- Mobile drawer ---------- */
.lm-drawer {
  position: fixed; z-index: 2; top: var(--lm-header-bottom); left: 0; bottom: 0; width: 100%;
  background: var(--lm-lilac-light); overflow-y: auto; -webkit-overflow-scrolling: touch;
  transform: translateX(-100%); visibility: hidden;
  transition: transform .45s var(--lm-ease-out), visibility 0s linear .45s;
}
.lm-drawer.is-open { transform: none; visibility: visible; transition: transform .45s var(--lm-ease-out), visibility 0s; }
.lm-drawer__inner { padding: 24px 16px 48px; }
.lm-drawer__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 20px; margin-top: 28px !important; }
.lm-drawer__links a { display: inline-block; font-size: 16px; font-weight: 500; line-height: 30px; text-transform: uppercase; }
.lm-drawer__title { font-family: var(--lm-font-display); font-weight: 500; font-size: 18px; line-height: 24px; text-transform: uppercase; margin-bottom: 24px; }
.lm-drawer .lm-mega__circles { gap: 32px 16px; margin-bottom: 32px; }
.lm-drawer .lm-mega__circle { gap: 12px; }
.lm-drawer .lm-mega__circle-img { width: 128px; height: 128px; }
.lm-drawer .lm-mega__circle-text { font-size: 18px; text-transform: uppercase; }
.lm-accordion { border-top: 0; }
.lm-accordion__btn {
  width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px;
  background: none; border: 0; padding: 12px 0; cursor: pointer; color: var(--lm-black);
  font-family: var(--lm-font-display); font-weight: 500; font-size: 18px; line-height: 24px; text-transform: uppercase; text-align: left;
}
.lm-accordion__icon { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: var(--lm-black); color: var(--lm-white); transition: transform .3s var(--lm-ease-bounce); }
.lm-accordion__btn[aria-expanded="true"] .lm-accordion__icon { transform: rotate(45deg); }
.lm-accordion__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s var(--lm-ease-out); }
.lm-accordion__panel > div { overflow: hidden; }
.lm-accordion__btn[aria-expanded="true"] + .lm-accordion__panel { grid-template-rows: 1fr; }
