{%- comment -%}
  Prints an amount like $26 or $25.50.
  Params: cents (number), round (boolean: round to whole dollars, like the live site)
{%- endcomment -%}
{%- liquid
  assign v = cents | default: 0
  if round
    assign v = v | divided_by: 100.0 | round | times: 100
  endif
-%}
{{- v | money_without_trailing_zeros -}}
