{%- comment -%}
  Product card used by "current faves" style carousels and the product page's related products.
  Params:
    product      – product object (optional when the manual values below are passed)
    button_label – button text
    sizes        – image sizes attribute
  The card reads these product metafields when present:
    lemme.subtitle          – benefit line under the title
    lemme.card_background   – shape shown behind the bottle on hover
{%- endcomment -%}
{%- liquid
  assign card_title = product.title
  assign card_url = product.url
  assign card_image = product.featured_media.preview_image
  assign card_subtitle = product.metafields.lemme.subtitle.value
  assign card_bg = product.metafields.lemme.card_background.value
  assign card_price = product.price | money_without_trailing_zeros
  assign card_compare = ''
  if product.compare_at_price > product.price
    assign card_compare = product.compare_at_price | money_without_trailing_zeros
  endif
  assign card_sizes = sizes | default: '(min-width: 1025px) 25vw, (min-width: 750px) 50vw, 100vw'
-%}
<article class="lm-card">
  <a class="lm-card__link" href="{{ card_url }}" aria-label="{{ card_title | escape }}" tabindex="-1"></a>
  <div class="lm-card__media">
    {%- if card_bg != blank -%}
      {{ card_bg | image_url: width: 700 | image_tag: class: 'lm-card__bg', alt: '', loading: 'lazy', sizes: card_sizes }}
    {%- endif -%}
    {%- if card_image != blank -%}
      {{ card_image | image_url: width: 900 | image_tag: class: 'lm-card__img', alt: card_title, loading: 'lazy', sizes: card_sizes, widths: '300, 450, 600, 900' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'lm-card__img' }}
    {%- endif -%}
  </div>
  <div class="lm-card__body">
    <h3 class="lm-card__title">{{ card_title }}</h3>
    {%- if card_subtitle != blank -%}<div class="lm-card__subtitle">{{ card_subtitle }}</div>{%- endif -%}
    <div class="lm-card__price">{%- if card_compare != blank -%}<s>{{ card_compare }}</s>{%- endif -%}{{ card_price }}</div>
  </div>
  <div class="lm-card__cta">
    {%- render 'lemme-button', label: button_label, url: card_url, style: 'light', size: 'sm' -%}
  </div>
</article>
